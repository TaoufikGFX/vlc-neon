+/* Wayland: do not let eglSwapBuffers() wait for the compositor's frame callbacks (swap interval 0).
+ *
+ * With the default interval 1, Mesa makes each swap wait for the callback of the previous one. A compositor sends those
+ * only while the surface is visible: when the window hosting the video is minimized (or not yet mapped) the vout thread
+ * blocks inside eglSwapBuffers() until the window is shown again, playback stalls and quitting hangs (the player waits
+ * for the vout thread). The block happens in the swap that is already in flight, so the interval can not be switched
+ * back and forth when the window gets hidden: it has to stay at 0.
+ * There is no tearing on Wayland (the compositor always presents complete frames), and VLC only renders when a picture
+ * is due, so nothing renders faster than the video. VLC_NEON_EGL_KEEP_THROTTLE=1 restores the default. */
+static void DisableSwapThrottling(vlc_gl_t *gl)
+{
+    vlc_gl_sys_t *sys = gl->sys;
+
+    if (sys->interval_set || gl->surface->type != VLC_WINDOW_TYPE_WAYLAND)
+        return;
+    sys->interval_set = true;
+    if (getenv("VLC_NEON_EGL_KEEP_THROTTLE") != NULL)
+    {
+        msg_Dbg(gl, "Wayland swap interval left at the default (VLC_NEON_EGL_KEEP_THROTTLE)");
+        return;
+    }
+    eglSwapInterval(sys->display, 0);
+    msg_Dbg(gl, "Wayland swap interval set to 0 (no frame-callback throttling)");
+}
+
 static int MakeCurrent (vlc_gl_t *gl)
 {
     vlc_gl_sys_t *sys = gl->sys;
