+/* Probing: demux modules are tried on every file, not only on discs. A regular file that is clearly not a disc image (a GIF, an
+ * mp4, ...) failing here is the normal outcome of the probe, so it must not raise a user-visible error. */
+static bool LooksLikeDiscSource( const char *psz_path )
+{
+    struct stat st;
+    if( vlc_stat( psz_path, &st ) != 0 )
+        return true;                    /* not a local path (device name, URL...): keep reporting */
+    if( !S_ISREG( st.st_mode ) )
+        return true;                    /* directory (VIDEO_TS), block/char device */
+    const char *ext = strrchr( psz_path, '.' );
+    if( ext == NULL )
+        return false;
+    static const char *const images[] = { ".iso", ".img", ".bin", ".nrg", ".mdf", ".udf", ".dvd", ".toc", ".cue" };
+    for( size_t i = 0; i < ARRAY_SIZE(images); i++ )
+        if( !strcasecmp( ext, images[i] ) )
+            return true;
+    return false;
+}
