+/* A GIF with several frames is an animation: the image demuxer only shows its first frame, so such files are left to avformat,
+ * which plays every frame with its own delay. Static GIFs stay here. Encoders such as ffmpeg write the NETSCAPE looping
+ * extension even for one frame, so it only counts when the first frame is too large to see a second one in the peeked data. */
+static bool IsAnimatedGif(stream_t *s)
+{
+    const size_t peek_size = 256 * 1024;
+    const uint8_t *p;
+    ssize_t size = vlc_stream_Peek(s, &p, peek_size);
+    if (size < 13)
+        return false;
+    int graphic_controls = 0;
+    bool looping = false;
+    for (ssize_t i = 13; i + 3 <= size; i++) {
+        if (p[i] != 0x21)
+            continue;
+        if (p[i + 1] == 0xF9 && p[i + 2] == 0x04 && ++graphic_controls >= 2)
+            return true;
+        if (p[i + 1] == 0xFF && p[i + 2] == 0x0B && i + 14 <= size && memcmp(&p[i + 3], "NETSCAPE2.0", 11) == 0)
+            looping = true;
+    }
+    return looping && (size_t)size == peek_size;
+}
