 bool ControlbarProfileModel::reload()
 {
+    // One-time upgrade of saved toolbars: put the new Video Info button next to Information in the video player
+    // toolbar. The flag lives outside this class' settings group (save() clears the group) and is set even when
+    // nothing needed changing, so a user who later removes the button is never given it back.
+    static const QString kVideoInfoMigrated = QStringLiteral("Reborn/videoInfoButtonAdded");
+    const bool migrateVideoInfo = !m_settings->value(kVideoInfoMigrated, false).toBool();
+    bool migrated = false;
+
+    // Same idea for the 3 second step buttons: put them next to the 10 second ones.
+    static const QString kSkip3Migrated = QStringLiteral("Reborn/skip3ButtonsAdded");
+    const bool migrateSkip3 = !m_settings->value(kSkip3Migrated, false).toBool();
+
