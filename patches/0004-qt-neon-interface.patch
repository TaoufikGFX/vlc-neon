+/* Picture-in-Picture: the main window shrinks into a small always-on-top video window in the bottom-right corner of the
+ * work area. On Wayland a client can neither choose its position nor stay on top: the title below is what the bundled KWin
+ * script (reborn/kwin/vlc-neon-pip) recognises to place the window and keep it above others. */
+static const QString kPipTitle = QStringLiteral("VLC Neon Picture-in-Picture");
+static const int kPipMargin = 16;
+static const QSize kPipMinimum(240, 135);
+
+double RebornController::videoAspect() const
+{
+    vlc_player_locker lock {m_player->getPlayer()};
+    const auto track = vlc_player_GetSelectedTrack(m_player->getPlayer(), VIDEO_ES);
+    if (!track) return 0.;
+    const auto &video = track->fmt.video;
+    if (!video.i_visible_width || !video.i_visible_height) return 0.;
+    const double sar = video.i_sar_num && video.i_sar_den ? double(video.i_sar_num) / video.i_sar_den : 1.;
+    return video.i_visible_width * sar / video.i_visible_height;
+}
+
+static QRect pipWorkArea(const QWindow *window)
+{
+    const QScreen *screen = window->screen() ? window->screen() : QGuiApplication::primaryScreen();
+    return screen->availableGeometry();   // work area: excludes panels / the taskbar
+}
+
+/* Fit `size` to the video aspect ratio (no crop, no stretch), inside the work area. `keepWidth` picks which side wins. */
+static QSize pipFit(QSize size, double aspect, const QRect &work, bool keepWidth)
+{
+    const QSize limit = work.size().boundedTo(work.size() - QSize(2 * kPipMargin, 2 * kPipMargin));
+    size = size.expandedTo(kPipMinimum).boundedTo(limit);
+    if (aspect <= 0.) return size;
+    if (keepWidth) size.setHeight(qRound(size.width() / aspect)); else size.setWidth(qRound(size.height() * aspect));
+    if (size.height() > limit.height()) { size.setHeight(limit.height()); size.setWidth(qRound(size.height() * aspect)); }
+    if (size.width() > limit.width()) { size.setWidth(limit.width()); size.setHeight(qRound(size.width() / aspect)); }
+    return size;
+}
+
+static QString normalTitle(PlayerController *player)
+{
+    const QString name = player->getName();
+    return name.isEmpty() ? QStringLiteral("VLC Neon") : name + QStringLiteral(" — VLC Neon");
+}
+
+void RebornController::enterCompact(QWindow *window)
+{
+    if (!window || m_compact) return;
+    m_normalGeometry = window->geometry();
+    m_normalAbove = m_intf->p_mi->isInterfaceAlwaysOnTop();
+    m_normalMaximized = window->visibility() == QWindow::Maximized;
+    window->showNormal();
+    const bool wayland = QGuiApplication::platformName().startsWith(QLatin1String("wayland"));
+    const QRect work = pipWorkArea(window);
+    const double aspect = videoAspect();
+    // Remembered size (the window has no shadow margin in PiP, so window size == video area size).
+    const QSize savedSize = m_intf->mainSettings->value(QStringLiteral("Reborn/pipSize")).toSize();
+    const QRect saved = m_intf->mainSettings->value(QStringLiteral("Reborn/compactGeometry")).toRect();
+    const QSize size = pipFit(savedSize.isValid() ? savedSize : QSize(480, 270), aspect, work, true);
+    window->setProperty("rebornPip", true);   // keeps the fixed title (see InterfaceWindowHandler)
+    window->setTitle(kPipTitle);
+    window->setMinimumSize(kPipMinimum);
+    if (wayland) {
+        window->resize(size);   // the position is the compositor's (KWin script) business
+    } else {
+        QRect rect(QPoint(0, 0), size);
+        rect.moveBottomRight(work.bottomRight() - QPoint(kPipMargin - 1, kPipMargin - 1));   // default: bottom-right corner
+        if (saved.isValid()) {   // remembered position, clamped back on-screen if the screen layout changed
+            rect.moveTopLeft(saved.topLeft());
+            rect.moveLeft(qBound(work.left() + kPipMargin, rect.left(), work.right() - kPipMargin - rect.width() + 1));
+            rect.moveTop(qBound(work.top() + kPipMargin, rect.top(), work.bottom() - kPipMargin - rect.height() + 1));
+        }
+        window->setGeometry(rect);
+    }
+    m_intf->p_mi->setInterfaceAlwaysOnTop(true);   // always keep above (Wayland: done by the KWin script)
+
+    m_pipTarget = size;
+    m_pipSize = size;
+    m_pipInitial = true;
+    if (m_compactWindow != window) {
+        m_compactWindow = window;
+        m_pipSize = window->size();
+        watchPipWindow(window);
+        connect(window, &QWindow::screenChanged, this, [this](QScreen *screen) {
+            if (!m_compact || !m_compactWindow || !screen) return;
+            const auto available = screen->availableGeometry();
+            auto rect = m_compactWindow->geometry();
+            rect.setSize(pipFit(rect.size(), videoAspect(), available, true));
+            if (!QGuiApplication::platformName().startsWith(QLatin1String("wayland"))) {
+                rect.moveLeft(qBound(available.left() + kPipMargin, rect.left(), available.right() - kPipMargin - rect.width() + 1));
+                rect.moveTop(qBound(available.top() + kPipMargin, rect.top(), available.bottom() - kPipMargin - rect.height() + 1));
+            }
+            m_compactWindow->setGeometry(rect);
+        });
+    }
+    m_compact = true;
+    emit compactChanged();
+    emit pipActiveChanged();
+}
+/* ---- Picture-in-Picture in a separate top-level window (Wayland) ------------------------------------------------ */
+
+QWindow *RebornController::pipWindow() const
+{
+    if (m_pipView && m_pipState != PipExiting) return m_pipView;
+    return m_compact ? m_compactWindow.data() : nullptr;
+}
+
+/* Keep the video aspect ratio while the user resizes: once the size has settled (nothing changed for 250 ms, so we never
+ * fight an interactive resize), adjust the dimension they did not drag. */
+void RebornController::watchPipWindow(QWindow *window)
+{
+    if (m_pipSettle.interval() != 250) {
+        m_pipSettle.setSingleShot(true);
+        m_pipSettle.setInterval(250);
+        connect(&m_pipSettle, &QTimer::timeout, this, &RebornController::onPipSettled);
+    }
+    const auto changed = [this] { if (pipWindow()) m_pipSettle.start(); };
+    connect(window, &QWindow::widthChanged, this, changed);
+    connect(window, &QWindow::heightChanged, this, changed);
+    connect(window, &QWindow::xChanged, this, changed);
+    connect(window, &QWindow::yChanged, this, changed);
+}
+
+void RebornController::onPipSettled()
+{
+    QWindow *window = pipWindow();
+    if (!window || window->visibility() != QWindow::Windowed) return;
+    const QSize now = window->size();
+    if (m_pipInitial) {   // first settle after entering: the requested size wins over whatever the layout transiently gave
+        m_pipInitial = false;
+        if (now != m_pipTarget) { m_pipSize = m_pipTarget; window->resize(m_pipTarget); return; }
+    }
+    const bool keepWidth = std::abs(now.width() - m_pipSize.width()) * m_pipSize.height()
+                           >= std::abs(now.height() - m_pipSize.height()) * m_pipSize.width();
+    const QSize fitted = pipFit(now, videoAspect(), pipWorkArea(window), keepWidth);
+    m_pipSize = fitted;
+    if (fitted != now) window->resize(fitted);
+    m_intf->mainSettings->setValue(QStringLiteral("Reborn/pipSize"), fitted);
+    m_intf->mainSettings->setValue(QStringLiteral("Reborn/compactGeometry"), QRect(window->position(), fitted));
+}
+
+bool RebornController::pipWindowSupported() const
+{
+    return dynamic_cast<vlc::CompositorWayland *>(m_intf->p_compositor.get()) != nullptr;
+}
+
+bool RebornController::setPipWindow(bool on)
+{
+    return on ? enterPipWindow() : exitPipWindow(false);
+}
+
+/* Entering: the PiP window is created and shown first, and the video is only re-parented once that window has really
+ * presented its first frame (so it is mapped and visible). Re-parenting a video sub-surface to a window that is not mapped
+ * yet is what froze the application: the window could not appear before its render thread finished, and that thread was
+ * waiting for the video, which waits for the window to be shown. Nothing here ever blocks the GUI thread. If the window
+ * does not appear within a second, the attempt is dropped and the video stays in the main window. */
+bool RebornController::enterPipWindow()
+{
+    auto *wayland = dynamic_cast<vlc::CompositorWayland *>(m_intf->p_compositor.get());
+    auto *mainView = qobject_cast<QQuickView *>(m_intf->p_mi->intfMainWindow());
+    if (!wayland || !mainView) return false;
+    if (m_pipState != PipIdle) return true;
+    m_pipClock.start();
+    m_mainVisibilityBeforePip = mainView->visibility();
+    dismissResumeOffer();   // the resume prompt is for opening a media, never for entering or leaving PiP
+    const QRect work = pipWorkArea(mainView);
+    const QSize saved = m_intf->mainSettings->value(QStringLiteral("Reborn/pipSize")).toSize();
+    const QSize size = pipFit(saved.isValid() ? saved : QSize(480, 270), videoAspect(), work, true);
+
+    m_pipState = PipEntering;
+    QQuickView *view = m_pipView = new QQuickView(mainView->engine(), nullptr);
+    view->setFormat(mainView->format());
+    view->setColor(QColor(Qt::transparent));
+    view->setFlag(Qt::FramelessWindowHint);   // no server-side title bar
+    view->setResizeMode(QQuickView::SizeRootObjectToView);
+    view->setTitle(kPipTitle);                 // what the KWin script recognises the window by
+    view->setMinimumSize(kPipMinimum);
+    view->resize(size);
+    view->setScreen(mainView->screen());
+    view->setSource(QUrl(QStringLiteral("qrc:/qt/qml/VLC/Player/PipWindow.qml")));   // its VideoSurface stays detached for now
+    view->create();
+    m_pipSize = m_pipTarget = size;
+    m_pipInitial = false;   // (only the single-window path needs the first-settle correction)
+    watchPipWindow(view);
+    // Closing the window by other means (e.g. Alt+F4) is the same as the Close button
+    connect(view, &QWindow::visibleChanged, this, [this, view](bool visible) {
+        if (!visible && m_pipView == view)
+            QMetaObject::invokeMethod(this, [this] { exitPipWindow(false); }, Qt::QueuedConnection);
+    });
+    // first presented frame (emitted from the render thread, delivered on the GUI thread): now the window is mapped
+    connect(view, &QQuickWindow::frameSwapped, this, [this, view, wayland] {
+        if (m_pipState != PipEntering || m_pipView != view) return;
+        const qint64 shown = m_pipClock.elapsed();
+        const bool ok = wayland->setVideoHost(view);
+        if (!ok) { abortEnterPip(QStringLiteral("could not re-parent the video")); return; }
+        if (QQuickItem *root = view->rootObject()) root->setProperty("attached", true);   // its VideoSurface takes over
+        m_pipState = PipActive;
+        // The core draws its own pause/play icon (a big "II" in the top-right corner) and other OSD over the video on every
+        // state change: the PiP overlay already shows all of that, so switch the OSD off while PiP is up.
+        // (a variable on the libvlc instance overrides the configured value for every vout below it, without touching
+        // or saving the configuration)
+        // "osd" gates every core on-screen message (pause icon, volume, seek position, ...); the video title is read from
+        // "video-title-show" when a vout is created, so switch it off as well for videos started while PiP is open.
+        for (const char *name : { "osd", "video-title-show" }) {
+            var_Create(vlc_object_instance(m_intf), name, VLC_VAR_BOOL);
+            var_SetBool(vlc_object_instance(m_intf), name, false);
+        }
+        emit pipHostedChanged();   // the main window swaps its view for the cheap placeholder
+        emit pipActiveChanged();
+        msg_Info(m_intf, "pip: window presented its first frame after %lld ms, video re-parented", (long long) shown);
+        view->requestActivate();
+    }, Qt::ConnectionType(Qt::QueuedConnection | Qt::SingleShotConnection));
+    QTimer::singleShot(1000, this, [this, view] {
+        if (m_pipState == PipEntering && m_pipView == view)
+            abortEnterPip(QStringLiteral("the window did not appear within 1 s"));
+    });
+    view->show();
+    emit pipActiveChanged();
+    // Test hook only: re-create the original bug (re-parent right after show(), before the window is mapped) so the stress
+    // test can prove that it detects the freeze.
+    if (qEnvironmentVariableIsSet("VLC_REBORN_TEST_OLD_PIP_REPARENT") && wayland->setVideoHost(view)) {
+        if (QQuickItem *root = view->rootObject()) root->setProperty("attached", true);
+        m_pipState = PipActive;
+        emit pipHostedChanged();
+        emit pipActiveChanged();
+    }
+    return true;
+}
+
+void RebornController::abortEnterPip(const QString &reason)
+{
+    if (m_pipState != PipEntering || !m_pipView) return;
+    msg_Warn(m_intf, "pip: aborted, the video stays in the main window: %s", qUtf8Printable(reason));
+    QQuickView *view = m_pipView;
+    m_pipView = nullptr;
+    m_pipState = PipIdle;
+    m_pipSettle.stop();
+    disconnect(view, nullptr, this, nullptr);
+    view->hide();          // the video was never attached to it, so nothing of the video can block this
+    view->deleteLater();
+    emit pipActiveChanged();
+}
+
+/* The video goes back to the main window without touching the vout. `back` also brings the main window to the front:
+ * on Wayland a client can not un-minimize itself, so this asks the compositor to activate it (xdg-activation, valid
+ * right after the click) and the KWin script restores it as well when it sees the "(back)" marker in the PiP title. */
+bool RebornController::exitPipWindow(bool back)
+{
+    if (m_pipState == PipEntering) { abortEnterPip(QStringLiteral("closed while opening")); return true; }
+    if (m_pipState != PipActive || !m_pipView) return true;
+    auto *wayland = dynamic_cast<vlc::CompositorWayland *>(m_intf->p_compositor.get());
+    auto *mainView = qobject_cast<QQuickView *>(m_intf->p_mi->intfMainWindow());
+    QQuickView *view = m_pipView;
+    m_pipState = PipExiting;
+    dismissResumeOffer();
+    m_pipSettle.stop();
+    m_intf->mainSettings->setValue(QStringLiteral("Reborn/pipSize"), view->size());
+    disconnect(view, nullptr, this, nullptr);
+    if (back && mainView) view->setTitle(kPipTitle + QStringLiteral(" (back)"));
+    // 1. the PiP stops reporting the video surface: from now on its render thread never talks to the vout
+    if (QQuickItem *root = view->rootObject()) root->setProperty("attached", false);
+    // 2. the main window brings its video view back (it was unloaded for the placeholder)
+    emit pipHostedChanged();
+    // 3. once the main video surface exists, move the video: the PiP keeps showing it until then (no gap)
+    auto *clock = new QElapsedTimer; clock->start();
+    auto *poll = new QTimer(this);
+    poll->setInterval(10);
+    connect(poll, &QTimer::timeout, this, [=, this] {
+        // the main view was unloaded for the placeholder: wait until its video item exists AND has been laid out
+        // (visible, sized, in a window), so the geometry the vout gets is the final one
+        bool ready = false;
+        if (auto *provider = m_intf->p_mi->getVideoSurfaceProvider())
+            if (auto surface = provider->videoSurface())
+                ready = surface->window() && surface->isVisible() && surface->width() > 0 && surface->height() > 0;
+        if (!ready && clock->elapsed() < 1000) return;
+        poll->stop(); poll->deleteLater();
+        if (wayland) wayland->setVideoHost(nullptr);
+        msg_Info(m_intf, "pip: video back in the main window after %lld ms (surface ready=%d)", (long long) clock->elapsed(), ready);
+        delete clock;
+        m_pipView = nullptr;
+        m_pipState = PipIdle;
+        var_Destroy(vlc_object_instance(m_intf), "osd");   // back to the configured values
+        var_Destroy(vlc_object_instance(m_intf), "video-title-show");
+        view->hide();
+        view->deleteLater();
+        if (back && mainView) {
+            // Un-minimize without changing the window state it had before PiP (showNormal() would un-maximize it)
+            if (m_mainVisibilityBeforePip == QWindow::Maximized) mainView->showMaximized();
+            else if (m_mainVisibilityBeforePip == QWindow::FullScreen) mainView->showFullScreen();
+            else mainView->showNormal();
+            mainView->raise();
+            mainView->requestActivate();
+        }
+        emit pipActiveChanged();
+    });
+    poll->start();
+    return true;
+}
+void RebornController::togglePip(QWindow *window)
+{
+    if (m_pipState == PipExiting) return;
+    if (m_pipState != PipIdle) { exitPipWindow(true); return; }
+    if (!m_compact && pipWindowSupported() && enterPipWindow()) return;
+    if (m_compact) {
+        leaveCompact(window);
+        m_intf->p_mi->setMinimalView(false);
+        m_intf->p_mi->setPlayerView(true);
+    } else {
+        m_intf->p_mi->setMinimalView(true);
+        enterCompact(window);
+    }
+}
+void RebornController::leaveCompact(QWindow *window)
+{
+    if (!window || !m_compact) return;
+    m_pipSettle.stop();
+    m_intf->mainSettings->setValue(QStringLiteral("Reborn/pipSize"), window->size());
+    m_intf->mainSettings->setValue(QStringLiteral("Reborn/compactGeometry"), QRect(window->position(), window->size()));
+    m_compact = false;
+    window->setProperty("rebornPip", false);
+    window->setTitle(normalTitle(m_player));
+    window->setMinimumSize(QSize(320, 360));
+    if (m_normalMaximized)
+        window->showMaximized();             // it was maximized before PiP
+    else
+        window->setGeometry(m_normalGeometry);   // Wayland: size only; the KWin script puts the window back where it was
+    m_intf->p_mi->setInterfaceAlwaysOnTop(m_normalAbove);
+    emit compactChanged();
+    emit pipActiveChanged();
+}
