@@ -0,0 +1,492 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Opt-in development integration test. Runs only with VLC_REBORN_TEST_REPORT.
+#include "qt.hpp"
+#include "player/reborn_controller.hpp"
+#include "player/player_controller.hpp"
+#include "playlist/playlist_controller.hpp"
+#include "maininterface/mainctx.hpp"
+#include <QApplication>
+#include <QClipboard>
+#include <QElapsedTimer>
+#include <QFile>
+#include <QImage>
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QQuickWindow>
+#include <QQuickItem>
+#include <QQuickItemGrabResult>
+#include <QMouseEvent>
+#include <QMimeData>
+#include <QDragEnterEvent>
+#include <QDropEvent>
+#include <vlc_player.h>
+#include <QScreen>
+#include <QTimer>
+#include <memory>
+#include "seek_benchmark.hpp"
+#include "p1_benchmark.hpp"
+#include "video_info_test.hpp"
+#include "skip3_test.hpp"
+#include "skip_flash_test.hpp"
+#include "icon_states_test.hpp"
+#include <QPainter>
+#include "popup_compare_test.hpp"
+#include "popup_stability_test.hpp"
+#include "pip_test.hpp"
+#include <QProcess>
+#include <unistd.h>
+#include "pip_spike_test.hpp"
+#include <atomic>
+#include <mutex>
+#include <thread>
+#include <chrono>
+#include <QRandomGenerator>
+#include "pip_stress_test.hpp"
+#include "pip_visual_test.hpp"
+#include "maininterface/compositor_wayland.hpp"
+#include "maininterface/videosurface.hpp"
+#include "pip_back_test.hpp"
+#include "seek_preview_test.hpp"
+#include "pip_icon_osd_test.hpp"
+#include "gif_loop_test.hpp"
+#include "play_stats_test.hpp"
+#include "pip_input_test.hpp"
+
+
+namespace {
+class Integration : public QObject {
+public:
+    qt_intf_t *intf;
+    RebornController *reborn;
+    PlayerController *player;
+    QJsonObject result;
+    QElapsedTimer elapsed;
+    qint64 pauseTime = 0;
+    int attempts = 0;
+    bool waiting = false;
+    bool repeated = false;
+    double previousPosition = 0;
+    qint64 abPrevious = 0;
+    bool abWrapped = false;
+    QString report;
+    Integration(qt_intf_t *i, RebornController *r)
+        : QObject(r), intf(i), reborn(r), player(i->p_mainPlayerController),
+          report(qEnvironmentVariable("VLC_REBORN_TEST_REPORT")) {
+        elapsed.start();
+        qApp->installEventFilter(this);
+        QTimer::singleShot(500, this, [this] { ready(); });
+        QTimer::singleShot(40000, this, [this] { result.insert(QStringLiteral("timeout"), true); finish(); });
+    }
+    bool eventFilter(QObject *, QEvent *event) override {
+        // This opt-in automated instance must not consume the user's typing.
+        // Internally constructed test events remain available to the UI.
+        if (!event->spontaneous()) return false;
+        switch (event->type()) {
+            case QEvent::KeyPress: case QEvent::KeyRelease:
+            case QEvent::MouseButtonPress: case QEvent::MouseButtonRelease:
+            case QEvent::MouseButtonDblClick: case QEvent::MouseMove: case QEvent::Wheel:
+                return true;
+            default: return false;
+        }
+    }
+    void ready() {
+        if (!intf->p_mi || !player->hasVideoOutput() || player->getLength().toVLCTick() <= 0) {
+            if (++attempts < 30) QTimer::singleShot(400, this, [this] { ready(); });
+            else { result.insert(QStringLiteral("video_output"), false); finish(); }
+            return;
+        }
+        result.insert(QStringLiteral("video_output"), true);
+        qApp->windowIcon().pixmap(256, 256).save(report + QStringLiteral(".app-icon.png"));
+        result.insert(QStringLiteral("application_display_name"), qApp->applicationDisplayName());
+        result.insert(QStringLiteral("application_name"), qApp->applicationName());
+        result.insert(QStringLiteral("desktop_file_name"), qApp->desktopFileName());
+        for (QWindow *window : qApp->allWindows()) {
+            if (window->isVisible() && window->title().contains(QStringLiteral("VLC Neon"))) {
+                result.insert(QStringLiteral("window_title"), window->title());
+                window->icon().pixmap(256, 256).save(report + QStringLiteral(".window-icon.png"));
+                break;
+            }
+        }
+        result.insert(QStringLiteral("startup_to_video_ms"), int(elapsed.elapsed()));
+        const auto mode = qEnvironmentVariable("VLC_REBORN_TEST_MODE");
+        if (mode == QStringLiteral("repeat-save") || mode == QStringLiteral("repeat-restore")) { repeatPreference(mode); return; }
+        if (mode == QStringLiteral("repeat")) { repeatPlayback(); return; }
+        if (mode == QStringLiteral("ab")) { abPlayback(); return; }
+        if (!mode.isEmpty()) { memory(mode); return; }
+        QTimer::singleShot(600, this, [this] {
+            {
+                vlc_player_locker lock {player->getPlayer()};
+                vlc_player_Pause(player->getPlayer());
+            }
+            QTimer::singleShot(700, this, [this] { preview(); });
+        });
+    }
+    void preview() {
+        pauseTime = player->getTime().toVLCTick();
+        waiting = true;
+        elapsed.restart();
+        connect(reborn, &RebornController::thumbnailChanged, this, [this] {
+            if (!waiting || reborn->thumbnail().isEmpty()) return;
+            waiting = false;
+            result.insert(QStringLiteral("thumbnail_cold_ms"), int(elapsed.elapsed()));
+            result.insert(QStringLiteral("hover_preserves_position"), pauseTime == player->getTime().toVLCTick());
+            const auto image = reborn->previewImage();
+            result.insert(QStringLiteral("thumbnail_width"), image.width());
+            image.save(report + QStringLiteral(".thumbnail.png"));
+            elapsed.restart();
+            reborn->hidePreview();
+            reborn->requestPreview(.25);
+            result.insert(QStringLiteral("thumbnail_cache_ms"), int(elapsed.elapsed()));
+            result.insert(QStringLiteral("thumbnail_cache_hit"), !reborn->thumbnail().isEmpty());
+            for (int n = 0; n < 100; ++n) reborn->requestPreview(n / 100.);
+            reborn->hidePreview();
+            result.insert(QStringLiteral("preview_hidden"), reborn->thumbnail().isEmpty());
+            seekControls();
+        });
+        reborn->requestPreview(.25);
+        QTimer::singleShot(5000, this, [this] {
+            if (waiting) { waiting = false; result.insert(QStringLiteral("thumbnail_failed"), true); controls(); }
+        });
+    }
+    QQuickItem *namedItem(QQuickItem *item, const QString &name) {
+        if (item->objectName() == name && item->isVisible()) return item;
+        for (auto child : item->childItems()) if (auto found = namedItem(child, name)) return found;
+        return nullptr;
+    }
+    bool mouse(QEvent::Type type, double position, Qt::MouseButton button = Qt::NoButton,
+               Qt::MouseButtons buttons = Qt::NoButton) {
+        auto window = qobject_cast<QQuickWindow *>(intf->p_mi->intfMainWindow());
+        if (!window) return false;
+        auto bar = namedItem(window->contentItem(), QStringLiteral("rebornSeekBar"));
+        if (!bar) return false;
+        const auto local = bar->mapToScene(QPointF(bar->width() * position, bar->height() / 2));
+        QMouseEvent event(type, local, window->mapToGlobal(local.toPoint()), button, buttons, Qt::NoModifier);
+        QCoreApplication::sendEvent(window, &event);
+        return true;
+    }
+    void seekControls() {
+        auto window = qobject_cast<QQuickWindow *>(intf->p_mi->intfMainWindow());
+        if (window) {
+            const QPointF local(window->width() / 2., window->height() - 100.);
+            QMouseEvent event(QEvent::MouseMove, local, window->mapToGlobal(local.toPoint()), Qt::NoButton, Qt::NoButton, Qt::NoModifier);
+            QCoreApplication::sendEvent(window, &event);
+        }
+        QTimer::singleShot(200, this, [this] { seekClicks(); });
+    }
+    void seekClicks() {
+        result.insert(QStringLiteral("seek_bar_found"), mouse(QEvent::MouseMove, .25));
+        QTimer::singleShot(700, this, [this] {
+            grab(QStringLiteral(".hover.png"));
+            mouse(QEvent::MouseButtonPress, .4, Qt::LeftButton, Qt::LeftButton);
+            mouse(QEvent::MouseButtonRelease, .4, Qt::LeftButton);
+            QTimer::singleShot(600, this, [this] {
+                result.insert(QStringLiteral("click_seek"), std::abs(player->getPosition() - .4) < .04);
+                mouse(QEvent::MouseButtonPress, .4, Qt::LeftButton, Qt::LeftButton);
+                dragStep(41);
+            });
+        });
+    }
+    void dragStep(int n) {
+        if (n <= 60) {
+            mouse(QEvent::MouseMove, n / 100., Qt::NoButton, Qt::LeftButton);
+            QTimer::singleShot(30, this, [this, n] { dragStep(n + 1); });
+            return;
+        }
+        mouse(QEvent::MouseButtonRelease, .6, Qt::LeftButton);
+        QTimer::singleShot(800, this, [this] {
+            result.insert(QStringLiteral("drag_position"), player->getPosition());
+            result.insert(QStringLiteral("drag_seek"), std::abs(player->getPosition() - .6) < .04);
+            pauseTime = player->getTime().toVLCTick();
+            controls();
+        });
+    }
+    void abPlayback() {
+        player->setTime(VLCTime(VLC_TICK_FROM_SEC(1)));
+        QTimer::singleShot(700, this, [this] {
+            player->setABloopState(PlayerController::ABLOOP_STATE_A);
+            QTimer::singleShot(1000, this, [this] {
+                player->setABloopState(PlayerController::ABLOOP_STATE_B);
+                abPrevious = player->getTime().toVLCTick();
+                connect(player, &PlayerController::timeChanged, this, [this] {
+                    const auto now = player->getTime().toVLCTick();
+                    if (now + VLC_TICK_FROM_MS(200) < abPrevious) abWrapped = true;
+                    abPrevious = now;
+                });
+                QTimer::singleShot(2200, this, [this] {
+                    result.insert(QStringLiteral("ab_loop_active"), player->getABloopState() == PlayerController::ABLOOP_STATE_B);
+                    result.insert(QStringLiteral("ab_loop_restarts"), abWrapped);
+                    result.insert(QStringLiteral("ab_A_ms"), int(MS_FROM_VLC_TICK(player->getABLoopA().toVLCTick())));
+                    result.insert(QStringLiteral("ab_B_ms"), int(MS_FROM_VLC_TICK(player->getABLoopB().toVLCTick())));
+                    player->setABloopState(PlayerController::ABLOOP_STATE_NONE);
+                    QTimer::singleShot(100, this, [this] {
+                        result.insert(QStringLiteral("ab_loop_cleared"), player->getABloopState() == PlayerController::ABLOOP_STATE_NONE);
+                        finish();
+                    });
+                });
+            });
+        });
+    }
+    void repeatPreference(const QString &mode) {
+        const int expected = qEnvironmentVariableIntValue("VLC_REBORN_TEST_REPEAT_COUNT");
+        if (mode == QStringLiteral("repeat-save")) {
+            reborn->setRepeatCount(expected);
+            result.insert(QStringLiteral("repeat_selection_saved"), reborn->repeatCount() == expected);
+            // Close while playing. Shutdown inputChanged must not overwrite it.
+            QTimer::singleShot(300, this, [this] {
+                grab(QStringLiteral(".repeat-choice.png"));
+                auto window = qobject_cast<QQuickWindow *>(intf->p_mi->intfMainWindow());
+                auto button = window ? namedItem(window->contentItem(), QStringLiteral("rebornRepeatButton")) : nullptr;
+                auto image = button ? button->grabToImage(QSize(160, 160)) : nullptr;
+                if (!image) { finish(); return; }
+                connect(image.get(), &QQuickItemGrabResult::ready, this, [this, image] {
+                    image->saveToFile(report + QStringLiteral(".repeat-button.png"));
+                    finish();
+                });
+            });
+            return;
+        }
+        result.insert(QStringLiteral("repeat_preference_restored"), reborn->repeatCount() == expected);
+        if (reborn->repeatCount() != expected) { finish(); return; }
+        previousPosition = player->getPosition();
+        auto wraps = std::make_shared<int>(0);
+        connect(player, &PlayerController::positionChanged, this, [this, expected, wraps] {
+            const double position = player->getPosition();
+            if (previousPosition > .75 && position < .25) {
+                ++*wraps;
+                if (expected < 0 && *wraps >= 3) {
+                    result.insert(QStringLiteral("restored_unlimited_repeats"), true);
+                    result.insert(QStringLiteral("repeat_survives_media_restart"), reborn->repeatCount() == expected);
+                    finish();
+                }
+            }
+            previousPosition = position;
+        });
+        connect(player, &PlayerController::playingStateChanged, this, [this, expected, wraps] {
+            if (player->getPlayingState() != PlayerController::PLAYING_STATE_STOPPED) return;
+            result.insert(QStringLiteral("restored_repeat_count_behavior"), expected >= 0 && *wraps == expected);
+            result.insert(QStringLiteral("repeat_survives_stop"), reborn->repeatCount() == expected);
+            finish();
+        });
+        player->setRate(4.f);
+        player->setPosition(.85);
+    }
+    void repeatPlayback() {
+        previousPosition = player->getPosition();
+        connect(player, &PlayerController::positionChanged, this, [this] {
+            if (previousPosition > .75 && player->getPosition() < .25) repeated = true;
+            previousPosition = player->getPosition();
+        });
+        connect(player, &PlayerController::playingStateChanged, this, [this] {
+            if (player->getPlayingState() != PlayerController::PLAYING_STATE_STOPPED) return;
+            result.insert(QStringLiteral("repeat_once_restarts"), repeated);
+            result.insert(QStringLiteral("repeat_once_stops"), true);
+            finish();
+        });
+        reborn->setRepeatCount(1);
+        player->setRate(4.f);
+    }
+    void memory(const QString &mode) {
+        if (mode == QStringLiteral("save")) {
+            player->setTime(VLCTime(VLC_TICK_FROM_SEC(6)));
+            player->setRate(1.25f);
+            player->setAudioDelayMS(120);
+            player->setSubtitleDelayMS(230);
+            reborn->setBoost(125);
+            {
+                vlc_player_locker lock {player->getPlayer()};
+                if (vlc_player_GetTrackCount(player->getPlayer(), AUDIO_ES) > 1)
+                    vlc_player_SelectEsId(player->getPlayer(), vlc_player_GetTrackAt(player->getPlayer(), AUDIO_ES, 1)->es_id, VLC_PLAYER_SELECT_EXCLUSIVE);
+                if (vlc_player_GetTrackCount(player->getPlayer(), SPU_ES) > 0)
+                    vlc_player_SelectEsId(player->getPlayer(), vlc_player_GetTrackAt(player->getPlayer(), SPU_ES, 0)->es_id, VLC_PLAYER_SELECT_EXCLUSIVE);
+            }
+            QTimer::singleShot(500, this, [this] {
+                result.insert(QStringLiteral("memory_save_position"), int(MS_FROM_VLC_TICK(player->getTime().toVLCTick())));
+                finish();
+            });
+        } else {
+            result.insert(QStringLiteral("resume_prompt"), !reborn->resumeText().isEmpty());
+            result.insert(QStringLiteral("speed_memory"), std::abs(player->getRate() - 1.25f) < .01);
+            result.insert(QStringLiteral("volume_memory"), std::abs(player->getVolume() - 1.25f) < .01);
+            result.insert(QStringLiteral("audio_delay_memory"), player->getAudioDelayMS() == 120);
+            result.insert(QStringLiteral("subtitle_delay_memory"), player->getSubtitleDelayMS() == 230);
+            {
+                vlc_player_locker lock {player->getPlayer()};
+                result.insert(QStringLiteral("audio_track_memory"), vlc_player_GetTrackCount(player->getPlayer(), AUDIO_ES) > 1 && vlc_player_GetTrackAt(player->getPlayer(), AUDIO_ES, 1)->selected);
+                result.insert(QStringLiteral("subtitle_track_memory"), vlc_player_GetTrackCount(player->getPlayer(), SPU_ES) > 0 && vlc_player_GetTrackAt(player->getPlayer(), SPU_ES, 0)->selected);
+            }
+            reborn->resume(true);
+            QTimer::singleShot(300, this, [this] {
+                result.insert(QStringLiteral("resume_seek"), player->getTime().toVLCTick() > VLC_TICK_FROM_SEC(5));
+                result.insert(QStringLiteral("recent_has_file"), !reborn->recent().isEmpty());
+                reborn->clearHistory();
+                result.insert(QStringLiteral("clear_history"), reborn->recent().isEmpty());
+                finish();
+            });
+        }
+    }
+    void controls() {
+        reborn->copyTimestamp();
+        result.insert(QStringLiteral("copy_timestamp"), QApplication::clipboard()->text() == player->getTime().formatHMS());
+        reborn->copyPath();
+        result.insert(QStringLiteral("copy_path"), QApplication::clipboard()->text() == player->getUrl().toLocalFile());
+        player->snapshot();
+        player->setRate(1.5f);
+        reborn->setBoost(150);
+        reborn->setRepeatCount(2);
+        QTimer::singleShot(600, this, [this] {
+            result.insert(QStringLiteral("speed_1_5"), std::abs(player->getRate() - 1.5f) < .01f);
+            result.insert(QStringLiteral("boost_150"), std::abs(player->getVolume() - 1.5f) < .01f);
+            result.insert(QStringLiteral("repeat_selection"), reborn->repeatCount() == 2);
+            reborn->setRepeatCount(0);
+            reborn->setBoost(100);
+            player->setRate(1.f);
+            player->frameNext();
+            QTimer::singleShot(400, this, [this] { record(); });
+        });
+    }
+    void record() {
+        result.insert(QStringLiteral("frame_next"), player->getTime().toVLCTick() > pauseTime);
+        const auto before = player->getTime().toVLCTick();
+        player->framePrev();
+        QTimer::singleShot(400, this, [this, before] {
+            result.insert(QStringLiteral("frame_previous"), player->getTime().toVLCTick() < before);
+            player->setTime(VLCTime(VLC_TICK_FROM_SEC(1)));
+            QTimer::singleShot(300, this, [this] { startRecord(); });
+        });
+    }
+    void startRecord() {
+        player->setRecording(true);
+        {
+            vlc_player_locker lock {player->getPlayer()};
+            vlc_player_Resume(player->getPlayer());
+        }
+        QTimer::singleShot(1200, this, [this] {
+            result.insert(QStringLiteral("recording_active"), player->isRecording());
+            player->setRecording(false);
+            compact();
+        });
+    }
+    void grab(const QString &suffix) {
+        if (auto quick = qobject_cast<QQuickWindow *>(intf->p_mi->intfMainWindow())) {
+            const auto image = quick->grabWindow();
+            if (!image.isNull()) image.save(report + suffix);
+        }
+    }
+    void compact() {
+        grab(QStringLiteral(".normal.png"));
+        auto window = qobject_cast<QQuickWindow *>(intf->p_mi->intfMainWindow());
+        auto button = window ? namedItem(window->contentItem(), QStringLiteral("rebornRepeatButton")) : nullptr;
+        if (button) QMetaObject::invokeMethod(button, "clicked");
+        QTimer::singleShot(400, this, [this, button] {
+            grab(QStringLiteral(".repeat-menu.png"));
+            if (button) QMetaObject::invokeMethod(button, "forceUnlock");
+            compactWindow();
+        });
+    }
+    void compactWindow() {
+        auto ctx = intf->p_mi;
+        ctx->setMinimalView(true);
+        reborn->enterCompact(ctx->intfMainWindow());
+        ctx->setInterfaceAlwaysOnTop(true);
+        QTimer::singleShot(500, this, [this] {
+            auto ctx = intf->p_mi;
+            auto window = ctx->intfMainWindow();
+            result.insert(QStringLiteral("compact_mode"), reborn->compact() && ctx->isMinimalView());
+            result.insert(QStringLiteral("compact_width"), window->width());
+            result.insert(QStringLiteral("compact_height"), window->height());
+            result.insert(QStringLiteral("keep_above_requested"), bool(window->flags() & Qt::WindowStaysOnTopHint));
+            grab(QStringLiteral(".compact.png"));
+            window->resize(640, 360);
+            QTimer::singleShot(400, this, [this] { returnFromCompact(); });
+        });
+    }
+    void returnFromCompact() {
+            auto ctx = intf->p_mi;
+            auto window = ctx->intfMainWindow();
+            result.insert(QStringLiteral("compact_resized"), window->width() == 640 && window->height() == 360);
+            reborn->leaveCompact(window);
+            ctx->setMinimalView(false);
+            result.insert(QStringLiteral("return_normal"), !reborn->compact());
+            reborn->enterCompact(window);
+            result.insert(QStringLiteral("compact_size_remembered"), window->width() == 640 && window->height() == 360);
+            reborn->leaveCompact(window);
+            player->setFullscreen(true);
+            QTimer::singleShot(500, this, [this] {
+                result.insert(QStringLiteral("fullscreen"), player->isFullscreen());
+                mouse(QEvent::MouseMove, .25);
+                QTimer::singleShot(700, this, [this] {
+                    result.insert(QStringLiteral("fullscreen_thumbnail"), !reborn->thumbnail().isEmpty());
+                    grab(QStringLiteral(".fullscreen.png"));
+                    mouse(QEvent::MouseButtonPress, .3, Qt::LeftButton, Qt::LeftButton);
+                    mouse(QEvent::MouseButtonRelease, .3, Qt::LeftButton);
+                    QTimer::singleShot(500, this, [this] {
+                        result.insert(QStringLiteral("fullscreen_click_seek"), std::abs(player->getPosition() - .3) < .08);
+                        player->setFullscreen(false);
+                        QTimer::singleShot(300, this, [this] { dropFile(); });
+                    });
+                });
+            });
+    }
+    void dropFile() {
+        auto window = intf->p_mi->intfMainWindow();
+        const QPoint center(window->width() / 2, window->height() / 2);
+        QMimeData mime;
+        mime.setUrls({player->getUrl()});
+        const int count = intf->p_mainPlaylistController->count();
+        QDragEnterEvent enter(center, Qt::CopyAction, &mime, Qt::LeftButton, Qt::NoModifier);
+        QCoreApplication::sendEvent(window, &enter);
+        QDropEvent drop(center, Qt::CopyAction, &mime, Qt::LeftButton, Qt::NoModifier);
+        QCoreApplication::sendEvent(window, &drop);
+        QTimer::singleShot(500, this, [this, count] {
+            result.insert(QStringLiteral("drag_drop_file"), intf->p_mainPlaylistController->count() > count);
+            finish();
+        });
+    }
+
+    void finish() {
+        QFile file(report);
+        if (file.open(QIODevice::WriteOnly)) file.write(QJsonDocument(result).toJson());
+        qApp->quit();
+    }
+};
+}
+void rebornStartIntegrationTest(qt_intf_t *intf, RebornController *reborn) {
+    if (qEnvironmentVariable("VLC_REBORN_TEST_MODE") == QStringLiteral("preview-benchmark"))
+        new SeekBenchmark(intf, reborn);
+    else if (qEnvironmentVariable("VLC_REBORN_TEST_MODE") == QStringLiteral("video-info"))
+        new VideoInfoTest(intf, reborn);
+    else if (qEnvironmentVariable("VLC_REBORN_TEST_MODE") == QStringLiteral("skip3"))
+        new Skip3Test(intf, reborn);
+    else if (qEnvironmentVariable("VLC_REBORN_TEST_MODE") == QStringLiteral("skipflash"))
+        new SkipFlashTest(intf, reborn);
+    else if (qEnvironmentVariable("VLC_REBORN_TEST_MODE") == QStringLiteral("popupstable"))
+        new PopupStabilityTest(intf, reborn);
+    else if (qEnvironmentVariable("VLC_REBORN_TEST_MODE") == QStringLiteral("pip"))
+        new PipTest(intf, reborn);
+    else if (qEnvironmentVariable("VLC_REBORN_TEST_MODE") == QStringLiteral("pipback"))
+        new PipBackTest(intf, reborn);
+    else if (qEnvironmentVariable("VLC_REBORN_TEST_MODE") == QStringLiteral("seekpreview"))
+        new SeekPreviewTest(intf, reborn);
+    else if (qEnvironmentVariable("VLC_REBORN_TEST_MODE") == QStringLiteral("pipicon"))
+        new PipIconOsdTest(intf, reborn);
+    else if (qEnvironmentVariable("VLC_REBORN_TEST_MODE") == QStringLiteral("gifloop"))
+        new GifLoopTest(intf, reborn);
+    else if (qEnvironmentVariable("VLC_REBORN_TEST_MODE") == QStringLiteral("playstats"))
+        new PlayStatsTest(intf, reborn);
+    else if (qEnvironmentVariable("VLC_REBORN_TEST_MODE") == QStringLiteral("pipinput"))
+        new PipInputTest(intf, reborn);
+    else if (qEnvironmentVariable("VLC_REBORN_TEST_MODE") == QStringLiteral("pipvisual"))
+        new PipVisualTest(intf, reborn);
+    else if (qEnvironmentVariable("VLC_REBORN_TEST_MODE") == QStringLiteral("pipstress"))
+        new PipStressTest(intf, reborn);
+    else if (qEnvironmentVariable("VLC_REBORN_TEST_MODE") == QStringLiteral("pipspike"))
+        new PipSpikeTest(intf, reborn);
+    else if (qEnvironmentVariable("VLC_REBORN_TEST_MODE") == QStringLiteral("popups"))
+        new PopupCompareTest(intf, reborn);
+    else if (qEnvironmentVariable("VLC_REBORN_TEST_MODE") == QStringLiteral("icons"))
+        new IconStatesTest(intf, reborn);
+    else if (qEnvironmentVariable("VLC_REBORN_TEST_MODE") == QStringLiteral("preview-p1"))
+        new P1Benchmark(intf, reborn);
+    else if (!qEnvironmentVariableIsEmpty("VLC_REBORN_TEST_REPORT")) new Integration(intf, reborn);
+}
