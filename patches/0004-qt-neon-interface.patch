+            {
+                for (auto &list : modelData)
+                {
+                    const int info = list.indexOf(int(ControlListModel::INFO_BUTTON));
+                    if (info >= 0 && !list.contains(int(ControlListModel::VIDEO_INFO_BUTTON)))
+                    {
+                        list.insert(info + 1, int(ControlListModel::VIDEO_INFO_BUTTON));
