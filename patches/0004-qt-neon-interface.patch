+// Provider only retrieves already-converted images; no decoding or compression on the UI thread.
+struct NeonPreviewImages {
+    QMutex mutex;
+    QMap<quint64, QImage> images;
+};
+class NeonPreviewProvider : public QQuickImageProvider {
+    std::shared_ptr<NeonPreviewImages> images;
+public:
+    explicit NeonPreviewProvider(std::shared_ptr<NeonPreviewImages> store)
+        : QQuickImageProvider(QQuickImageProvider::Image, QQmlImageProviderBase::ForceAsynchronousImageLoading), images(std::move(store)) {}
+    QImage requestImage(const QString &id, QSize *size, const QSize &) override {
+        QMutexLocker lock(&images->mutex);
+        QImage image = images->images.value(id.toULongLong());
+        if (size) *size = image.size();
+        return image;
+    }
+};
+struct RebornController::Request {
+    RebornController *owner;
+    quint64 generation;
+    qint64 time;
+    bool precise, png;
+    qint64 started;
+};
+
+RebornController::RebornController(qt_intf_t *intf, PlayerController *player, QObject *parent)
+    : QObject(parent), m_intf(intf), m_player(player)
+{
+    m_resumeExpiry.setSingleShot(true);
+    connect(&m_resumeExpiry, &QTimer::timeout, this, [this] { dismissResumeOffer(); });
+    var_Create(m_intf, "neon-preview-media-pts", VLC_VAR_BOOL);
+    var_SetBool(m_intf, "neon-preview-media-pts", true);
+    m_images = std::make_shared<NeonPreviewImages>();
+    m_previewClock.start(); m_uiHeartbeat.start();
+    m_pngDelivery = qEnvironmentVariableIsSet("VLC_NEON_PREVIEW_PNG");
+    // P1 retained FFmpeg thumbnails are the default where FFmpeg is available; VLC_NEON_PREVIEW_BACKEND=vlc forces P0.
+    if (NeonFFThumbnailer::available() && qgetenv("VLC_NEON_PREVIEW_BACKEND") != "vlc")
+        m_ff = std::make_unique<NeonFFThumbnailer>();
+    m_forcePrecise = qEnvironmentVariableIsSet("VLC_NEON_PREVIEW_PRECISE");
+    rebornStartIntegrationTest(intf, this);
+    m_memory = intf->mainSettings->value(QStringLiteral("Reborn/mediaMemory"), true).toBool();
+    m_keepAbove = intf->mainSettings->value(QStringLiteral("Reborn/keepAbove"), true).toBool();
+    m_repeat = qBound(-1, intf->mainSettings->value(QStringLiteral("Reborn/repeatCount"), 0).toInt(), 5);
+    applyRepeatCount();
+    m_debounce.setSingleShot(true);
+    bool delayOk = false;
+    const int delay = qEnvironmentVariableIntValue("VLC_NEON_PREVIEW_COALESCE_MS", &delayOk);
+    m_coalesceDelay = delayOk ? qBound(0, delay, 100) : 0;
+    m_debounce.setInterval(m_coalesceDelay);
+    m_dwell.setSingleShot(true);
+    bool dwellOk = false;
+    const int dwell = qEnvironmentVariableIntValue("VLC_NEON_PREVIEW_DWELL_MS", &dwellOk);
+    m_dwell.setInterval(dwellOk ? qBound(80, dwell, 500) : 150);
+    connect(&m_dwell, &QTimer::timeout, this, &RebornController::refinePreview);
+    // Yield new jobs for UI stalls or new playback losses. No playback controls are written.
+    m_pressureTimer.setInterval(100);
+    connect(&m_pressureTimer, &QTimer::timeout, this, [this] {
+        const auto lag = m_uiHeartbeat.restart();
+        // Startup/window placement is not thumbnail pressure. Only active work yields.
+        if (m_hovering && previewActive() && lag > 180) {
+            m_pressureUntil = m_previewClock.elapsed() + 750;
+            m_pending = m_wantedBucket; m_pendingPrecise = m_forcePrecise || m_fastSeekLimited;
+            cancelActivePreview();
+            m_previewMetrics["pressure_cancellations"] = m_previewMetrics.value("pressure_cancellations").toLongLong()+1;
+        }
+    });
+    m_pressureTimer.start();
+    connect(player, &PlayerController::statisticsUpdated, this, [this](const input_stats_t &stats) {
+        if (stats.i_late_pictures > m_latePictures || stats.i_lost_pictures > m_lostPictures || stats.i_lost_abuffers > m_lostAudio) {
+            m_pressureUntil = m_previewClock.elapsed() + 1000;
+            if (previewActive() && m_hovering) {
+                m_pending = m_wantedBucket;
+                m_pendingPrecise = m_forcePrecise || m_fastSeekLimited;
+                cancelActivePreview();
+                m_previewMetrics["pressure_cancellations"] = m_previewMetrics.value("pressure_cancellations").toLongLong()+1;
+            }
+        }
+        m_latePictures = stats.i_late_pictures; m_lostPictures = stats.i_lost_pictures; m_lostAudio = stats.i_lost_abuffers;
+    });
+    connect(&m_debounce, &QTimer::timeout, this, &RebornController::startPreview);
+    connect(player, &PlayerController::inputChanged, this, &RebornController::mediaChanged);
+    // Video Info panel: refresh when media, metadata, playback state or the selected tracks change.
+    connect(player, &PlayerController::inputChanged, this, &RebornController::videoInfoChanged);
+    connect(player, &PlayerController::currentMetaChanged, this, &RebornController::videoInfoChanged);
+    connect(player, &PlayerController::playingStateChanged, this, &RebornController::videoInfoChanged);
+    for (QAbstractItemModel *tracks : { static_cast<QAbstractItemModel *>(player->getVideoTracks()),
+                                        static_cast<QAbstractItemModel *>(player->getAudioTracks()) }) {
+        connect(tracks, &QAbstractItemModel::dataChanged, this, &RebornController::videoInfoChanged);
+        connect(tracks, &QAbstractItemModel::rowsInserted, this, &RebornController::videoInfoChanged);
+        connect(tracks, &QAbstractItemModel::rowsRemoved, this, &RebornController::videoInfoChanged);
+        connect(tracks, &QAbstractItemModel::modelReset, this, &RebornController::videoInfoChanged);
+    }
+    connect(player, &PlayerController::timeChanged, this, [this] {
+        if (m_path.isEmpty() || !m_loaded) return;
+        if (m_player->getPlayingState() != PlayerController::PLAYING_STATE_PLAYING
+            && m_player->getPlayingState() != PlayerController::PLAYING_STATE_PAUSED) return;
+        if (m_player->getTime().toVLCTick() < 0) return;
+        m_savedTime = MS_FROM_VLC_TICK(m_player->getTime().toVLCTick());
+        m_savedDuration = MS_FROM_VLC_TICK(m_player->getLength().toVLCTick());
+        m_savedRate = m_player->getRate();
+        m_savedVolume = m_player->getVolume();
+        m_savedAudioDelay = m_player->getAudioDelayMS();
+        m_savedSubtitleDelay = m_player->getSubtitleDelayMS();
+        vlc_player_locker lock {m_player->getPlayer()};
+        const auto selected = [this](es_format_category_e category) {
+            QByteArray ids;
+            auto player = m_player->getPlayer();
+            for (size_t i = 0; i < vlc_player_GetTrackCount(player, category); ++i) {
+                const auto track = vlc_player_GetTrackAt(player, category, i);
+                if (!track->selected) continue;
+                if (!ids.isEmpty()) ids += ',';
+                ids += vlc_es_id_GetStrId(track->es_id);
+            }
+            return ids;
+        };
+        m_savedAudioTracks = selected(AUDIO_ES);
+        m_savedSubtitleTracks = selected(SPU_ES);
+    });
+    connect(player, &PlayerController::playingStateChanged, this, [this] {
+        if (m_player->getPlayingState() == PlayerController::PLAYING_STATE_PLAYING && !m_loaded)
+            loadMedia();
+    });
+    connect(qApp, &QCoreApplication::aboutToQuit, this, &RebornController::saveMedia);
+    connect(player, &PlayerController::volumeChanged, this, [this] {
+        if (!m_limiterOwned) return;
+        auto aout = m_player->getAout();
+        const auto volume = m_player->getVolume();
+        if (volume <= 1) {
+            vlc_player_aout_EnableFilter(m_player->getPlayer(), "limiter", false);
+            m_limiterOwned = false;
+        } else if (aout) {
+            var_SetFloat(aout.get(), "limiter-threshold", -60.f * std::log10(volume) - 1.f);
+        }
+    });
+}
+
+RebornController::~RebornController()
+{
+    saveMedia();
+    // Delete joins workers. No callback can use this object after it returns.
+    m_ff.reset();
+    if (m_preparser) vlc_preparser_Delete(m_preparser);
+    if (m_request) vlc_preparser_req_Release(m_request);
+}
+
+void RebornController::mediaChanged()
+{
+    saveMedia();
+    ++m_generation;
+    hidePreview();
+    // New media: drop the retained decoder and give the FFmpeg backend a fresh chance.
+    if (m_ff) m_ff->releaseDecoder();
+    m_ffEnabled = true; m_ffFailures = 0; m_vlcOnce = false;
+    m_cache.clear(); m_previewIndex.clear();
+    { QMutexLocker lock(&m_images->mutex); m_images->images.clear(); }
+    m_latePictures = m_lostPictures = m_lostAudio = 0;
+    m_fastSeekLimited = false;
+    m_path = m_player->getUrl().toLocalFile();
+    if (!QFileInfo(m_path).isFile()) m_path.clear();
+    m_key = mediaKey();
+    m_savedTime = 0;
+    m_resume = 0;
+    m_resumeExpiry.stop();
+    m_loaded = false;
+    m_historySuppressed = false;
+    applyRepeatCount();
+    emit resumeChanged();
+    if (m_player->getPlayingState() == PlayerController::PLAYING_STATE_PLAYING)
+        loadMedia();
+}
+
+QString RebornController::mediaKey() const
+{
+    if (m_path.isEmpty()) return {};
+    const QFileInfo info(m_path);
+    const QByteArray identity = info.canonicalFilePath().toUtf8() + '\n'
+        + QByteArray::number(info.size()) + '\n'
+        + QByteArray::number(info.lastModified().toMSecsSinceEpoch());
+    return QString::fromLatin1(QCryptographicHash::hash(identity, QCryptographicHash::Sha256).toHex());
+}
+
+void RebornController::clearPreviewCache()
+{
+    // Development-only hook for independent miss measurements, never a user setting.
+    if (qEnvironmentVariableIsEmpty("VLC_REBORN_TEST_REPORT")) return;
+    hidePreview(); ++m_generation;
+    m_cache.clear(); m_previewIndex.clear();
+}
+
+void RebornController::installPreviewProvider(QQmlEngine *engine)
+{
+    engine->addImageProvider(QStringLiteral("neonpreview"), new NeonPreviewProvider(m_images));
+}
+
+QImage RebornController::previewImage() const
+{
+    if (auto entry = m_cache.object(m_displayBucket)) return entry->image;
+    return {};
+}
+
+QString RebornController::thumbnailFrameTime() const
+{
+    return m_actualTime >= 0 ? VLCTime(VLC_TICK_0 + VLC_TICK_FROM_MS(m_actualTime)).formatHMS() : QString();
+}
+
+bool RebornController::thumbnailApproximate() const
+{
+    return m_actualTime < 0 || std::abs(m_actualTime - m_wanted) > 80;
+}
+
+QVariantMap RebornController::previewMetrics() const
+{
+    auto out = m_previewMetrics;
+    out.insert("wanted_ms", m_wanted);
+    out.insert("actual_ms", m_actualTime);
+    out.insert("error_ms", m_actualTime >= 0 ? QVariant(m_actualTime - m_wanted) : QVariant());
+    out.insert("bucket_ms", m_bucketSize);
+    out.insert("tolerance_ms", std::max<qint64>(1000, m_bucketSize * 2));
+    out.insert("cache_bytes", m_cache.totalCost());
+    out.insert("cache_entries", m_cache.size());
+    out.insert("active", previewActive());
+    out.insert("backend", m_ff && m_ffEnabled ? "ffmpeg-retained" : "vlc");
+    out.insert("pending", m_pending >= 0);
+    out.insert("coalesce_ms", m_coalesceDelay);
+    out.insert("dwell_ms", m_dwell.interval());
+    out.insert("fast_seek_limited", m_fastSeekLimited);
+    return out;
+}
+
+void RebornController::updatePreviewIndex(qint64 key, qint64 actual)
+{
+    // contains() does not touch LRU order; iterating object() would promote every entry.
+    for (auto it = m_previewIndex.begin(); it != m_previewIndex.end();) {
+        if (it.value() == key || !m_cache.contains(it.value())) it = m_previewIndex.erase(it);
+        else ++it;
+    }
+    if (actual >= 0 && m_cache.contains(key)) m_previewIndex.insert(actual, key);
+}
+
+void RebornController::showThumbnail(qint64 key)
+{
+    auto entry = m_cache.object(key);
+    if (!entry) return;
+    const qint64 tolerance = std::max<qint64>(1000, m_bucketSize * 2);
+    if (entry->actual < 0 || std::abs(entry->actual - m_wanted) > tolerance) return;
+    m_actualTime = entry->actual;
+    if (m_displayBucket != key || m_thumbnail.isEmpty() || m_thumbnail != entry->url) {
+        if (entry->url.startsWith(QStringLiteral("image://"))) {
+            QMutexLocker lock(&m_images->mutex);
+            m_images->images.insert(entry->url.section(QLatin1Char('/'), -1).toULongLong(), entry->image);
+            // Retain the displayed image and two recently requested images for async handoff.
+            while (m_images->images.size() > 3) {
+                auto it = m_images->images.begin();
+                if (it.key() == entry->url.section(QLatin1Char('/'), -1).toULongLong()) ++it;
+                m_images->images.erase(it);
+            }
+        }
+        m_displayBucket = key;
+        m_thumbnail = entry->url;
+        emit thumbnailChanged();
+    }
+    emit previewChanged();
+}
+
+void RebornController::selectPreview()
+{
+    const auto tolerance = std::max<qint64>(1000, m_bucketSize * 2);
+    qint64 best = -1, error = tolerance + 1;
+    auto next = m_previewIndex.lowerBound(m_wanted);
+    const auto consider = [&](QMap<qint64, qint64>::const_iterator it) {
+        if (it == m_previewIndex.cend()) return;
+        const auto distance = std::abs(it.key() - m_wanted);
+        if (distance < error && m_cache.contains(it.value())) { error = distance; best = it.value(); }
+    };
+    consider(next);
+    if (next != m_previewIndex.cbegin()) consider(std::prev(next));
+    if (best >= 0) showThumbnail(best);
+    else if (m_actualTime < 0 || std::abs(m_actualTime - m_wanted) > tolerance) {
+        m_thumbnail.clear(); m_actualTime = m_displayBucket = -1;
+        emit thumbnailChanged(); emit previewChanged();
+    }
+}
+
+void RebornController::requestPreview(double position, double timelineWidth)
+{
+    if (qEnvironmentVariableIsSet("VLC_NEON_BENCH_NO_PREVIEW") && !qEnvironmentVariableIsEmpty("VLC_REBORN_TEST_REPORT")) return;
+    if (m_path.isEmpty() || !m_player->isSeekable() || !std::isfinite(position)) return;
+    const qint64 duration = MS_FROM_VLC_TICK(m_player->getLength().toVLCTick());
+    if (duration <= 0) return;
+    m_previewMetrics["requests"] = m_previewMetrics.value("requests").toLongLong() + 1;
+    QElapsedTimer lookup; lookup.start();
+    m_hovering = true;
+    const qint64 wanted = std::clamp<qint64>(qRound64(duration * qBound(0., position, 1.)), 0, duration - 1);
+    // About 8 logical pixels per bucket, bounded for short and very long media.
+    const double width = std::isfinite(timelineWidth) ? std::max(1., timelineWidth) : 1000.;
+    m_bucketSize = std::clamp<qint64>(qRound64(duration * 8. / width / 25.) * 25, 100, 2000);
+    const auto bucket = std::min(duration - 1, (wanted / m_bucketSize) * m_bucketSize + m_bucketSize / 2);
+    const bool moved = wanted != m_wanted;
+    m_wanted = wanted; m_wantedBucket = bucket;
+    if (moved) { m_stationary = false; m_dwell.start(); }
+    selectPreview();
+    if (auto entry = m_cache.object(bucket)) {
+        if (entry->actual >= 0 && std::abs(entry->actual - wanted) <= std::max<qint64>(1000, m_bucketSize * 2)) {
+            m_previewMetrics["cache_hits"] = m_previewMetrics.value("cache_hits").toLongLong() + 1;
+            if (!(m_pending == bucket && m_pendingPrecise && m_stationary)) m_pending = -1;
+            emit previewChanged();
+            m_previewMetrics["lookup_us"] = lookup.nsecsElapsed()/1000.;
+            return;
+        }
+    }
+    if (!m_thumbnail.isEmpty()) m_previewMetrics["nearby_hits"] = m_previewMetrics.value("nearby_hits").toLongLong() + 1;
+    queuePreview(bucket, m_forcePrecise || m_fastSeekLimited);
+    m_previewMetrics["lookup_us"] = lookup.nsecsElapsed()/1000.;
+    emit previewChanged();
+}
+
+void RebornController::queuePreview(qint64 time, bool precise)
+{
+    if (previewActive() && m_activeBucket == time && (m_activePrecise || !precise)) {
+        // Latest position is covered by the active request; discard an older pending bucket.
+        m_pending = -1;
+        return;
+    }
+    m_pending = time; m_pendingPrecise = precise;
+    m_previewMetrics["queued_at_ms"] = m_previewClock.elapsed();
+    if (!previewActive() && !m_debounce.isActive()) m_debounce.start(m_coalesceDelay);
+}
+
+void RebornController::refinePreview()
+{
+    if (!m_hovering || m_wanted < 0 || m_forcePrecise) return;
+    m_stationary = true;
+    // An already close frame needs no second decode. A precise cached bucket remains reusable.
+    if (m_actualTime >= 0 && std::abs(m_actualTime - m_wanted) <= std::max<qint64>(80, m_bucketSize / 2)) return;
+    if (auto entry = m_cache.object(m_wantedBucket); entry && entry->precise) return;
+    queuePreview(m_wantedBucket, true);
+}
+
+void RebornController::hidePreview()
+{
+    m_hovering = m_stationary = false;
+    m_pending = m_wanted = m_wantedBucket = -1;
+    m_actualTime = m_displayBucket = -1;
+    m_debounce.stop(); m_dwell.stop();
+    m_thumbnail.clear();
+    // Cancel on leaving/media change, never on every tiny mouse movement.
+    cancelActivePreview();
+    emit thumbnailChanged(); emit previewChanged();
+}
+
+void RebornController::cancelActivePreview()
+{
+    if (m_preparser && m_request) vlc_preparser_Cancel(m_preparser, m_request);
+    if (m_ffActive && m_ff) m_ff->cancel();
+}
+
+void RebornController::startPreview()
+{
+    if (previewActive() || m_pending < 0 || !m_hovering || m_path.isEmpty()) return;
+    if (m_previewClock.elapsed() < m_pressureUntil) {
+        m_debounce.start(int(m_pressureUntil - m_previewClock.elapsed()));
+        return;
+    }
+    if (!std::exchange(m_vlcOnce, false) && m_ff && m_ffEnabled && startFFPreview()) return;
+    if (!m_preparser) {
+        vlc_preparser_cfg cfg {};
+        cfg.types = VLC_PREPARSER_TYPE_THUMBNAIL;
+        cfg.max_thumbnailer_threads = 1;
+        cfg.timeout = VLC_TICK_FROM_SEC(2);
+        cfg.external_process = false;
+        m_preparser = vlc_preparser_New(VLC_OBJECT(m_intf), &cfg);
+        if (!m_preparser) return;
+    }
+    input_item_t *item;
+    {
+        vlc_player_locker lock {m_player->getPlayer()};
+        item = vlc_player_GetCurrentMedia(m_player->getPlayer());
+        if (item) input_item_Hold(item);
+    }
+    if (!item) return;
+    vlc_thumbnailer_arg arg {};
+    arg.seek.type = decltype(arg.seek.type)::VLC_THUMBNAILER_SEEK_TIME;
+    arg.seek.time = VLC_TICK_FROM_MS(m_pending);
+    arg.seek.speed = m_pendingPrecise ? decltype(arg.seek.speed)::VLC_THUMBNAILER_SEEK_PRECISE
+                                      : decltype(arg.seek.speed)::VLC_THUMBNAILER_SEEK_FAST;
+    arg.hw_dec = false;
+    auto data = new Request {this, m_generation, m_pending, m_pendingPrecise, m_pngDelivery, m_previewClock.elapsed()};
+    m_activeBucket = m_pending; m_activePrecise = m_pendingPrecise;
+    m_previewMetrics["scheduling_ms"] = m_previewClock.elapsed() - m_previewMetrics.value("queued_at_ms").toLongLong();
+    m_previewMetrics["extractions"] = m_previewMetrics.value("extractions").toLongLong() + 1;
+    if (m_pendingPrecise) m_previewMetrics["precise_extractions"] = m_previewMetrics.value("precise_extractions").toLongLong() + 1;
+    if (m_pendingPrecise && m_stationary && !m_forcePrecise) m_previewMetrics["refinements"] = m_previewMetrics.value("refinements").toLongLong() + 1;
+    static const vlc_thumbnailer_cbs cbs { &RebornController::thumbnailEnded };
+    m_pending = -1;
+    m_request = vlc_preparser_req_NewThumbnail(m_preparser, item, &arg, &cbs, data);
+    input_item_Release(item);
+    if (!m_request || vlc_preparser_Submit(m_preparser, m_request) != VLC_SUCCESS) {
+        if (m_request) vlc_preparser_req_Release(m_request);
+        m_request = nullptr; m_activeBucket = -1;
+        delete data;
+    } else emit previewExtractionStarted();
+}
+
+void RebornController::thumbnailEnded(vlc_preparser_req *handle, int status, picture_t *picture, void *opaque)
+{
+    std::unique_ptr<Request> request(static_cast<Request *>(opaque));
+    auto self = request->owner;
+    QElapsedTimer delivery; delivery.start();
+    const qint64 backendMs = self->m_previewClock.elapsed() - request->started;
+    QImage image; QString pngUrl;
+    qint64 actual = -1;
+    double encodeMs = 0, base64Ms = 0, scaleMs = 0;
+    if (status == VLC_SUCCESS && picture) {
+        if (picture->date != VLC_TICK_INVALID) actual = MS_FROM_VLC_TICK(picture->date - VLC_TICK_0);
+        if (request->png) {
+            block_t *block = nullptr;
+            if (picture_Export(VLC_OBJECT(self->m_intf), &block, nullptr, picture, VLC_CODEC_PNG, 320, 0, false) == VLC_SUCCESS) {
+                encodeMs = delivery.nsecsElapsed()/1e6;
+                QElapsedTimer base64; base64.start();
+                pngUrl = QStringLiteral("data:image/png;base64,") + QString::fromLatin1(QByteArray(reinterpret_cast<char *>(block->p_buffer), block->i_buffer).toBase64());
+                base64Ms = base64.nsecsElapsed()/1e6;
+                image = QImage::fromData(reinterpret_cast<const uchar *>(block->p_buffer), block->i_buffer);
+                block_Release(block);
+            }
+        } else {
+            // VLC's existing converter does scaling and colorspace conversion on this worker.
+            auto handler = image_HandlerCreate(self->m_intf);
+            if (handler) {
+                video_format_t in = picture->format, out {};
+                if (!in.i_sar_num || !in.i_sar_den) in.i_sar_num = in.i_sar_den = 1;
+                out.i_chroma = VLC_CODEC_RGBA;
+                out.i_width = out.i_visible_width = 320;
+                out.i_height = out.i_visible_height = std::clamp(unsigned(uint64_t(in.i_visible_height) * 320 * in.i_sar_den / std::max(1u, in.i_visible_width) / in.i_sar_num), 1u, 640u);
+                out.i_sar_num = out.i_sar_den = 1;
+                out.orientation = in.orientation;
+                picture_t *scaled = image_Convert(handler, picture, &in, &out);
+                if (scaled) {
+                    const plane_t &plane = scaled->p[0];
+                    image = QImage(plane.p_pixels + scaled->format.i_y_offset * plane.i_pitch + scaled->format.i_x_offset * 4,
+                                   scaled->format.i_visible_width, scaled->format.i_visible_height,
+                                   plane.i_pitch, QImage::Format_RGBA8888).copy();
+                    const auto orient = in.orientation;
+                    if (orient == ORIENT_HFLIPPED) image = image.mirrored(true, false);
+                    else if (orient == ORIENT_VFLIPPED) image = image.mirrored(false, true);
+                    else if (orient == ORIENT_ROTATED_180) image = image.transformed(QTransform().rotate(180));
+                    else if (orient == ORIENT_ROTATED_90) image = image.transformed(QTransform().rotate(90));
+                    else if (orient == ORIENT_ROTATED_270) image = image.transformed(QTransform().rotate(270));
+                    else if (orient == ORIENT_TRANSPOSED) image = image.transformed(QTransform().rotate(90)).mirrored(true, false);
+                    else if (orient == ORIENT_ANTI_TRANSPOSED) image = image.transformed(QTransform().rotate(90)).mirrored(false, true);
+                    picture_Release(scaled);
+                }
+                image_HandlerDelete(handler);
+            }
+            scaleMs = delivery.nsecsElapsed()/1e6;
+        }
+    }
+    const auto generation = request->generation;
+    const auto time = request->time;
+    const bool precise = request->precise;
+    const auto queued = vlc_tick_now();
+    QMetaObject::invokeMethod(self, [self, handle, generation, time, precise, image, pngUrl, actual, backendMs, encodeMs, base64Ms, scaleMs, queued] {
+        vlc_preparser_req_Release(handle);
+        self->m_request = nullptr; self->m_activeBucket = -1;
+        self->m_previewMetrics["backend_ms"] = backendMs;
+        self->m_previewMetrics["last_result_pts_ms"] = actual;
+        self->m_previewMetrics["scale_convert_copy_ms"] = scaleMs;
+        self->m_previewMetrics["png_scale_encode_ms"] = encodeMs;
+        self->m_previewMetrics["base64_ms"] = base64Ms;
+        self->m_previewMetrics["gui_delivery_ms"] = (vlc_tick_now() - queued)/1000.;
+        self->completePreview(generation, time, precise, image, pngUrl, actual);
+    }, Qt::QueuedConnection);
+}
+
+// Shared by the P0 (VLC preparser) and P1 (retained FFmpeg) completions: generation check, cache insert, display.
+void RebornController::completePreview(quint64 generation, qint64 time, bool precise, const QImage &image, const QString &pngUrl, qint64 actual)
+{
+    auto self = this;
+        if (generation == self->m_generation && !image.isNull()) {
+            auto entry = new Thumbnail {image, pngUrl, actual, precise};
+            if (entry->url.isEmpty()) {
+                const auto token = QString::number(++self->m_imageSerial);
+                entry->url = QStringLiteral("image://neonpreview/") + token;
+            }
+            self->m_cache.insert(time, entry, int(image.sizeInBytes() + pngUrl.size()*sizeof(QChar)));
+            self->updatePreviewIndex(time, actual);
+            if (self->m_hovering) self->selectPreview();
+            if (self->m_hovering && actual >= 0 && std::abs(actual-self->m_wanted) > std::max<qint64>(1000,self->m_bucketSize*2))
+                self->m_previewMetrics["obsolete_results"] = self->m_previewMetrics.value("obsolete_results").toLongLong()+1;
+            else if (self->m_displayBucket != time)
+                self->m_previewMetrics["cached_not_displayed"] = self->m_previewMetrics.value("cached_not_displayed").toLongLong()+1;
+            if (self->m_hovering && !precise && actual >= 0
+                && std::abs(actual - time) > std::max<qint64>(1000, self->m_bucketSize*2)) {
+                // Observed sparse random-access points: do not spend another dwell
+                // waiting for an image that fast seeking cannot provide usefully.
+                self->m_fastSeekLimited = true;
+                self->m_previewMetrics["fast_seek_fallbacks"] = self->m_previewMetrics.value("fast_seek_fallbacks").toLongLong()+1;
+                if (self->m_pending >= 0) self->m_pendingPrecise = true;
+                if (self->m_thumbnail.isEmpty()) self->queuePreview(self->m_wantedBucket, true);
+            }
+            if (self->m_stationary && !precise && self->m_pending < 0) self->refinePreview();
+        } else self->m_previewMetrics["failed_or_cancelled"] = self->m_previewMetrics.value("failed_or_cancelled").toLongLong()+1;
+        // Do not add a fresh coalescing delay after an extraction has already coalesced movement.
+    // Do not add a fresh coalescing delay after an extraction has already coalesced movement.
+    if (self->m_pending >= 0 && self->m_hovering) self->m_debounce.start(0);
+}
+
+bool RebornController::startFFPreview()
+{
+    const qint64 time = m_pending;
+    QByteArray path = QFile::encodeName(m_path);
+    int timeoutMs = 3000;
+    // Development-only fault injection (needs the test report variable, like clearPreviewCache) to exercise the P0 fallback.
+    if (!qEnvironmentVariableIsEmpty("VLC_REBORN_TEST_REPORT")) {
+        const auto fault = qgetenv("VLC_NEON_PREVIEW_FF_FAULT");
+        if (fault == "open") path = "/nonexistent/neon-ff-fault";
+        else if (fault == "timeout") timeoutMs = 1;
+    }
+    const QByteArray key = m_key.toLatin1();
+    const quint64 generation = m_generation;
+    const qint64 started = m_previewClock.elapsed();
+    m_previewMetrics["scheduling_ms"] = started - m_previewMetrics.value("queued_at_ms").toLongLong();
+    // 3s: above P0's 2s because a random long-GOP jump legitimately decodes ~150 4K frames; beyond it, P0 takes over.
+    const bool ok = m_ff->submit(path, key, time, timeoutMs, [this, generation, time, started](const NeonFFThumbnailer::Result &r) {
+        QVariantMap stats;
+        stats["ff_open_ms"] = r.openMs; stats["ff_seek_ms"] = r.seekMs; stats["ff_decode_ms"] = r.decodeMs;
+        stats["ff_scale_ms"] = r.scaleMs; stats["ff_total_ms"] = r.totalMs; stats["ff_frames"] = r.frames;
+        stats["ff_packets"] = r.packets; stats["ff_seeked"] = r.seeked; stats["ff_opened"] = r.opened;
+        const int status = int(r.status);
+        const QImage image = r.image; const qint64 actual = r.actualMs;
+        QMetaObject::invokeMethod(this, [=] { ffFinished(generation, time, stats, status, image, actual); }, Qt::QueuedConnection);
+        (void) started;
+    });
+    if (!ok) return false;
+    m_ffActive = true; m_activeBucket = time; m_activePrecise = true; m_pending = -1;
+    m_previewMetrics["extractions"] = m_previewMetrics.value("extractions").toLongLong() + 1;
+    m_previewMetrics["precise_extractions"] = m_previewMetrics.value("precise_extractions").toLongLong() + 1;
+    m_previewMetrics["ff_extractions"] = m_previewMetrics.value("ff_extractions").toLongLong() + 1;
+    emit previewExtractionStarted();
+    return true;
+}
+
+void RebornController::ffFinished(quint64 generation, qint64 time, const QVariantMap &stats, int status, const QImage &image, qint64 actual)
+{
+    m_ffActive = false; m_activeBucket = -1;
+    for (auto it = stats.cbegin(); it != stats.cend(); ++it) m_previewMetrics[it.key()] = it.value();
+    m_previewMetrics["backend_ms"] = stats.value("ff_total_ms");
+    m_previewMetrics["last_result_pts_ms"] = actual;
+    using S = int;
+    const S ok = S(0), cancelled = S(3);   // NeonFFThumbnailer::Status order: Ok, Failed, Timeout, Cancelled, Unsupported
+    if (status == ok) {
+        m_ffFailures = 0;
+        completePreview(generation, time, true, image, QString(), actual);
+        return;
+    }
+    if (status != cancelled && generation == m_generation && m_hovering) {
+        // Backend failure, timeout or unsupported media: serve this request through P0 right away. Two failures
+        // in a row (or unsupported media) retire the FFmpeg backend for this media.
+        m_previewMetrics["ff_fallbacks"] = m_previewMetrics.value("ff_fallbacks").toLongLong() + 1;
+        if (status == 4 || ++m_ffFailures >= 2) m_ffEnabled = false;
+        if (m_pending < 0) { m_pending = time; m_pendingPrecise = true; }
+        m_vlcOnce = true;
+    }
+    completePreview(generation, time, true, QImage(), QString(), -1);
+}
+
+// Same rule as modules/demux/image.c: two graphic-control blocks in the first 256 KB mean an animation (those go to avformat);
+// the NETSCAPE looping header only counts when the first frame is too big to see a second one. Still GIFs go through the image
+// demuxer, which cannot be repeated by seeking back, so they must not be given a repeat count.
+static bool isAnimatedGif(const QString &path)
+{
+    if (!path.endsWith(QLatin1String(".gif"), Qt::CaseInsensitive)) return false;
+    QFile file(path);
+    if (!file.open(QIODevice::ReadOnly)) return false;
+    constexpr qint64 peekSize = 256 * 1024;
+    const QByteArray data = file.read(peekSize);
+    if (data.size() < 13 || !data.startsWith("GIF8")) return false;
+    int controls = 0;
+    bool looping = false;
+    for (int i = 13; i + 3 <= data.size(); ++i) {
+        if (data[i] != 0x21) continue;
+        if (uchar(data[i + 1]) == 0xF9 && data[i + 2] == 0x04 && ++controls >= 2) return true;
+        if (uchar(data[i + 1]) == 0xFF && data[i + 2] == 0x0B && i + 14 <= data.size() && data.mid(i + 3, 11) == "NETSCAPE2.0") looping = true;
+    }
+    return looping && data.size() == peekSize;
+}
+
+void RebornController::applyRepeatCount()
+{
+    // A GIF loops forever, like a GIF should, unless the user chose a repeat count. The player's own repeat seeks the same input back
+    // to the start at the end of the stream: nothing is re-opened or re-probed, and other media keep the configured count.
+    const QUrl url = m_player->getUrl();
+    const bool gif = url.isLocalFile() && isAnimatedGif(url.toLocalFile());
+    const unsigned count = m_repeat < 0 || (gif && m_repeat == 0) ? UINT_MAX : unsigned(m_repeat);
+    vlc_player_locker lock {m_player->getPlayer()};
+    vlc_player_SetRepeatCount(m_player->getPlayer(), count);
+}
+
+void RebornController::setRepeatCount(int count)
+{
+    const int previous = m_repeat;
+    m_repeat = qBound(-1, count, 5);
+    applyRepeatCount();
+    // Persist the user's selection, not the input's remaining repeat counter.
+    // Write immediately so closing a different instance cannot lose this choice.
+    m_intf->mainSettings->setValue(QStringLiteral("Reborn/repeatCount"), m_repeat);
+    m_intf->mainSettings->sync();
+    if (previous != m_repeat)
+        emit repeatCountChanged();
+}
