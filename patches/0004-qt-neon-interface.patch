+// SPDX-License-Identifier: GPL-2.0-or-later
+// Opt-in check (VLC_REBORN_TEST_MODE=pipback, VLC_REBORN_TEST_REPORT=<prefix>): real Wayland session needed (fractional scale
+// and the client-side shadow margin matter). For the main window windowed (shadow margin) and maximized: after PiP -> Back the
+// video sub-surface must sit exactly on the main window's video item (position and size, surface coordinates), and no resume
+// prompt may appear. Screenshots <prefix>-back-windowed.png / -back-maximized.png.
+class PipBackTest : public QObject {
+    qt_intf_t *intf;
+    PlayerController *player;
+    RebornController *reborn;
+    QQuickWindow *window = nullptr;
+    QString prefix;
+    QStringList log;
+    bool failed = false;
+    void check(const QString &name, bool ok, const QString &detail = {}) { log << QStringLiteral("%1: %2 %3").arg(ok ? "PASS" : "FAIL", name, detail); if (!ok) failed = true; }
+    void after(int ms, std::function<void()> f) { QTimer::singleShot(ms, this, f); }
+    void shot(const QString &name) { QProcess::execute("spectacle", {"-b", "-n", "-f", "-o", prefix + "-" + name + ".png"}); }
+    // item geometry in the window's coordinates vs what the compositor applied to the sub-surface
+    void compareGeometry(const QString &what) {
+        auto *wayland = dynamic_cast<vlc::CompositorWayland *>(intf->p_compositor.get());
+        auto *provider = intf->p_mi->getVideoSurfaceProvider();
+        auto surface = provider ? provider->videoSurface() : nullptr;
+        if (!wayland || !surface) { check(what + ": video surface present", false); return; }
+        const QPointF pos = surface->mapToScene(QPointF(0, 0));
+        const QSizeF size(surface->width(), surface->height());
+        const QRect sub = wayland->videoSubsurfaceGeometry();
+        const bool ok = qAbs(sub.x() - pos.x()) <= 1.5 && qAbs(sub.y() - pos.y()) <= 1.5 && qAbs(sub.width() - size.width()) <= 1.5 && qAbs(sub.height() - size.height()) <= 1.5;
+        check(what + ": sub-surface == video item", ok, QStringLiteral("sub-surface %1,%2 %3x%4  item %5,%6 %7x%8  (window %9x%10, margin %11, dpr %12)")
+              .arg(sub.x()).arg(sub.y()).arg(sub.width()).arg(sub.height()).arg(pos.x()).arg(pos.y()).arg(size.width()).arg(size.height())
+              .arg(window->width()).arg(window->height()).arg(intf->p_mi->windowExtendedMargin()).arg(window->effectiveDevicePixelRatio()));
+    }
+    void round(const QString &label, bool minimizeBeforeBack, std::function<void()> next) {
+        after(1500, [=, this] {
+            compareGeometry(label + " before PiP");
+            reborn->togglePip(window);
+            after(2500, [=, this] {
+                reborn->offerResumeForTest(12 * 60 * 1000 + 12000);   // a pending offer that must not survive the exit
+                if (minimizeBeforeBack) window->showMinimized();
+                after(minimizeBeforeBack ? 1500 : 0, [=, this] {
+                reborn->exitPipWindow(true);   // Back
+                after(3000, [=, this] {
+                    check(label + ": no resume prompt after Back", reborn->resumeText().isEmpty(), reborn->resumeText());
+                    check(label + ": still playing", player->getPlayingState() == PlayerController::PLAYING_STATE_PLAYING);
+                    check(label + ": window state kept", label.startsWith("maximized") ? window->visibility() == QWindow::Maximized : window->visibility() == QWindow::Windowed, QString::number(int(window->visibility())));
+                    compareGeometry(label + " after Back");
+                    shot(QStringLiteral("back-") + label);
+                    next();
+                });
+                });
+            });
+        });
+    }
+    void run() {
+        round("windowed", false, [=, this] {
+            round("windowed-minimized", true, [=, this] {
+                window->showMaximized();
+                round("maximized", false, [=, this] {
+                    round("maximized-minimized", true, [=, this] { finish(); });
+                });
+            });
+        });
+    }
+    void finish() {
+        log << (failed ? "RESULT: FAIL" : "RESULT: PASS");
+        QFile f(prefix + ".txt"); if (f.open(QIODevice::WriteOnly | QIODevice::Text)) f.write(log.join('\n').toUtf8());
+        std::thread([] { std::this_thread::sleep_for(std::chrono::seconds(15)); std::_Exit(4); }).detach();
+        qApp->quit();
+    }
+    void ready(int tries = 0) {
+        window = qobject_cast<QQuickWindow *>(intf->p_mi ? intf->p_mi->intfMainWindow() : nullptr);
+        if (!window || !player->isSeekable() || !intf->p_mi->hasEmbededVideo()
+                || player->getPlayingState() != PlayerController::PLAYING_STATE_PLAYING) {
+            if (tries < 200) QTimer::singleShot(250, this, [this, tries] { ready(tries + 1); }); else { log << "not ready"; finish(); }
+            return;
+        }
+        QTimer::singleShot(2500, this, [this] { run(); });
+    }
+public:
+    PipBackTest(qt_intf_t *i, RebornController *r) : QObject(r), intf(i), player(i->p_mainPlayerController), reborn(r),
+        prefix(qEnvironmentVariable("VLC_REBORN_TEST_REPORT")) {
+        QTimer::singleShot(500, this, [this] { ready(); });
+        QTimer::singleShot(150000, this, [this] { log << "timeout"; failed = true; finish(); });
+    }
+};
diff --git a/reborn/tests/pip_icon_osd_test.hpp b/reborn/tests/pip_icon_osd_test.hpp
