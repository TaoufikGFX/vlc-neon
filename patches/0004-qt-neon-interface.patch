+void RebornController::clearHistory()
+{
+    m_intf->mainSettings->remove(QStringLiteral("Reborn/history"));
+    m_historySuppressed = true;
+    emit recentChanged();
+}
+void RebornController::removeRecent(const QString &key)
+{
+    if (key.size() != 64 || key.contains(QLatin1Char('/'))) return;
+    m_intf->mainSettings->remove(QStringLiteral("Reborn/history/") + key);
+    if (key == m_key) m_historySuppressed = true;
+    emit recentChanged();
+}
+// Selected video/audio track details from VLC's own track information (the data behind Tools > Media Information).
+// Empty strings mean "not available" and are shown as an em dash by the panel.
+QVariantMap RebornController::videoInfo() const
+{
+    QVariantMap out;
+    const auto codec = [](const es_format_t &fmt) {
+        const vlc_fourcc_t cc = fmt.i_original_fourcc ? fmt.i_original_fourcc : fmt.i_codec;
+        const char *description = vlc_fourcc_GetDescription(fmt.i_cat, fmt.i_codec);
+        QString text = description && *description ? QString::fromUtf8(description) : QString();
+        const QByteArray fourcc(reinterpret_cast<const char *>(&cc), 4);
+        const bool printable = cc && std::all_of(fourcc.begin(), fourcc.end(), [](char c) { return c >= 0x20 && c < 0x7f; });
+        if (printable) text += (text.isEmpty() ? QString() : QStringLiteral(" ")) + QStringLiteral("(%1)").arg(QString::fromLatin1(fourcc));
+        return text;
+    };
+    const auto language = [](const es_format_t &fmt) {
+        if (!fmt.psz_language || !*fmt.psz_language) return QString();
+        if (const iso639_lang_t *lang = vlc_find_iso639(fmt.psz_language, true))
+            if (lang->psz_eng_name && *lang->psz_eng_name) return QString::fromUtf8(lang->psz_eng_name);
+        return QString::fromUtf8(fmt.psz_language);
+    };
+    QString title = m_player->getTitle();
+    if (title.isEmpty()) title = m_player->getName();
+    out["title"] = title;
+    vlc_player_locker lock {m_player->getPlayer()};
+    if (const auto *video = vlc_player_GetSelectedTrack(m_player->getPlayer(), VIDEO_ES)) {
+        const auto &fmt = video->fmt;
+        const unsigned w = fmt.video.i_visible_width ? fmt.video.i_visible_width : fmt.video.i_width;
+        const unsigned h = fmt.video.i_visible_height ? fmt.video.i_visible_height : fmt.video.i_height;
+        out["hasVideo"] = true;
+        out["videoResolution"] = w && h ? QStringLiteral("%1×%2").arg(w).arg(h) : QString();
+        out["videoCodec"] = codec(fmt);
+        out["videoLanguage"] = language(fmt);
+        out["videoType"] = tr("Video");
+    } else out["hasVideo"] = false;
+    if (const auto *audio = vlc_player_GetSelectedTrack(m_player->getPlayer(), AUDIO_ES)) {
+        const auto &fmt = audio->fmt;
+        out["hasAudio"] = true;
+        out["audioCodec"] = codec(fmt);
+        out["audioLanguage"] = language(fmt);
+        out["audioSampleRate"] = fmt.audio.i_rate ? QStringLiteral("%1 Hz").arg(fmt.audio.i_rate) : QString();
+    } else out["hasAudio"] = false;
+    return out;
+}
