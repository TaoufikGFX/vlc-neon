diff --git a/reborn/tests/gif_loop_test.hpp b/reborn/tests/gif_loop_test.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..c1139f742f86fa6594508cecf8efd5f170274e5f
--- /dev/null
+++ b/reborn/tests/gif_loop_test.hpp
@@ -0,0 +1,30 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Opt-in check (VLC_REBORN_TEST_MODE=gifloop, VLC_REBORN_TEST_REPORT=<prefix>): plays a short animated GIF (the media given on the command
+// line) and counts how many times playback starts within 14 s: it must loop (>= 3 starts for a 3 s GIF) and the playlist loop setting must stay "none".
+class GifLoopTest : public QObject {
+    qt_intf_t *intf;
+    PlayerController *player;
+    QString prefix;
+    int starts = 0, wraps = 0, stoppedCount = 0;
+    double previous = 0;
+    QStringList events;
+    QElapsedTimer clock;
+    qint64 maxLength = 0;
+public:
+    GifLoopTest(qt_intf_t *i, QObject *parent) : QObject(parent), intf(i), player(i->p_mainPlayerController), prefix(qEnvironmentVariable("VLC_REBORN_TEST_REPORT")) {
+        clock.start();
+        connect(player, &PlayerController::positionChanged, this, [this](double p) { if (previous > 0.6 && p < previous - 0.4) ++wraps; previous = p; });
+        connect(player, &PlayerController::playingStateChanged, this, [this](PlayerController::PlayingState s) { events << QStringLiteral("%1 ms: state %2 pos %3").arg(clock.elapsed()).arg(int(s)).arg(player->getPosition()); if (s == PlayerController::PLAYING_STATE_PLAYING) ++starts; if (s == PlayerController::PLAYING_STATE_STOPPED) ++stoppedCount; });
+        connect(player, &PlayerController::lengthChanged, this, [this](VLCDuration l) { maxLength = std::max<qint64>(maxLength, MS_FROM_VLC_TICK(l.toVLCTick())); });
+        auto *tick = new QTimer(this); connect(tick, &QTimer::timeout, this, [this] { events << QStringLiteral("%1 ms: pos %2 time %3 state %4").arg(clock.elapsed()).arg(player->getPosition()).arg(MS_FROM_VLC_TICK(player->getTime().toVLCTick())).arg(int(player->getPlayingState())); }); tick->start(1000);
+        QTimer::singleShot(14000, this, [this] {
+            const bool noRepeat = intf->p_mainPlaylistController->getRepeatMode() == vlc::playlist::PlaylistController::PLAYBACK_REPEAT_NONE;
+            const bool ok = wraps >= 3 && stoppedCount == 0 && noRepeat;
+            QFile f(prefix + ".txt");
+            if (f.open(QIODevice::WriteOnly | QIODevice::Text))
+                f.write(QStringLiteral("%1: loops (position wrap-arounds, no re-open) %2 in 14 s, length %3 ms, playlist repeat unchanged=%4, stopped states=%5\nRESULT: %1\n").arg(ok ? "PASS" : "FAIL").arg(wraps).arg(maxLength).arg(noRepeat).arg(stoppedCount).toUtf8() + events.join('\n').toUtf8());
+            std::thread([] { std::this_thread::sleep_for(std::chrono::seconds(10)); std::_Exit(4); }).detach();
+            qApp->quit();
+        });
+    }
+};
diff --git a/reborn/tests/icon_states_test.hpp b/reborn/tests/icon_states_test.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..aa411527ba216e20259df35c3bbf037ef63f16ea
--- /dev/null
+++ b/reborn/tests/icon_states_test.hpp
@@ -0,0 +1,85 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Opt-in screenshots (VLC_REBORN_TEST_MODE=icons, VLC_REBORN_TEST_REPORT=<prefix>): right side of the control bar in the
+// states normal / muted / boost / fullscreen -> <prefix>-<state>.png, plus <prefix>.txt with each button's glyph + tooltip.
+// Run with QT_QPA_PLATFORM=offscreen.
+class IconStatesTest : public QObject {
+    qt_intf_t *intf;
+    PlayerController *player;
+    QQuickWindow *window = nullptr;
+    QString prefix;
+    QStringList log;
+    static QQuickItem *find(QQuickItem *root, const QStringList &descriptions, bool visibleOnly = true) {
+        const QString d = root->property("description").toString();
+        for (const QString &wanted : descriptions) if ((!visibleOnly || root->isVisible()) && (d == wanted || (wanted.endsWith(':') && d.startsWith(wanted)))) return root;
+        for (auto c : root->childItems()) if (auto f = find(c, descriptions, visibleOnly)) return f;
+        return nullptr;
+    }
+    void dump(const char *state) {
+        log << QStringLiteral("%1: player volume=%2 muted=%3 fullscreen=%4").arg(state).arg(player->getVolume()).arg(player->isMuted()).arg(player->isFullscreen());
+        for (const char *d : {"Repeat:", "Picture-in-Picture / Mini Player", "Mute", "Unmute", "Renderer", "Fullscreen", "Exit fullscreen"})
+            if (auto *b = find(window->contentItem(), {QString::fromLatin1(d)}, false))
+                if (b->isVisible() || QByteArray(d).contains("ullscreen"))
+                log << QStringLiteral("%1: %2 glyph=U+%3 tooltip=\"%4\"").arg(state, d)
+                       .arg(uint(b->property("text").toString().isEmpty() ? 0 : b->property("text").toString().at(0).unicode()), 4, 16, QLatin1Char('0'))
+                       .arg(b->property("description").toString());
+        QQuickItem *boost = nullptr; std::function<void(QQuickItem *)> walk = [&](QQuickItem *i) {
+            if (!boost && i->objectName() == QLatin1String("rebornBoostButton")) boost = i;
+            for (auto c : i->childItems()) walk(c); };
+        walk(window->contentItem());
+        if (boost) log << QStringLiteral("%1: boost glyph=U+%2 checked=%3 tooltip=\"%4\"").arg(state)
+                           .arg(uint(boost->property("text").toString().at(0).unicode()), 4, 16, QLatin1Char('0'))
+                           .arg(boost->property("checked").toBool()).arg(boost->property("description").toString());
+    }
+    void shot(const char *state) {
+        QQuickItem *left = find(window->contentItem(), {"Picture-in-Picture / Mini Player"});
+        QQuickItem *right = find(window->contentItem(), {"Fullscreen", "Exit fullscreen"});
+        if (!right) right = find(window->contentItem(), {"Renderer"});
+        if (!left || !right) { log << QStringLiteral("%1: toolbar buttons not found").arg(state); return; }
+        const QPointF a = left->mapToScene(QPointF(0, 0)), b = right->mapToScene(QPointF(right->width(), right->height()));
+        const QRect r = QRectF(a.x() - 90, a.y() - 14, b.x() - a.x() + 130, right->height() + 28).toRect().intersected(window->grabWindow().rect());
+        window->grabWindow().copy(r).scaled(r.size() * 3, Qt::KeepAspectRatio, Qt::FastTransformation).save(prefix + "-" + state + ".png");
+        dump(state);
+    }
+    void run() {
+        auto after = [this](int ms, std::function<void()> f) { QTimer::singleShot(ms, this, f); };
+        shot("normal");
+        // The dummy audio output never reports volume/mute to the player (Player.volume stays -1), so the muted and boost
+        // states are forced on the items themselves: the mute glyph/boost accent mapping itself is unchanged QML.
+        auto mute = [this]() { return find(window->contentItem(), {"Mute", "Unmute"}); };
+        auto boostItem = [this]() { QQuickItem *b = nullptr; std::function<void(QQuickItem *)> w = [&](QQuickItem *i) {
+            if (!b && i->objectName() == QLatin1String("rebornBoostButton")) b = i; for (auto c : i->childItems()) w(c); };
+            w(window->contentItem()); return b; };
+        mute()->setProperty("text", QString(QChar(0xe052)));        // VLCIcons.volume_muted
+        mute()->setProperty("description", QStringLiteral("Unmute"));
+        after(500, [=, this] { shot("muted"); mute()->setProperty("text", QString(QChar(0xe04f)));  // VLCIcons.volume_high
+        mute()->setProperty("description", QStringLiteral("Mute"));
+        boostItem()->setProperty("checked", true);
+        after(500, [=, this] { shot("boost"); boostItem()->setProperty("checked", false); player->setFullscreen(true);
+        after(1500, [=, this] { shot("fullscreen"); player->setFullscreen(false);
+            QFile f(prefix + ".txt"); if (f.open(QIODevice::WriteOnly | QIODevice::Text)) f.write(log.join('\n').toUtf8());
+            after(300, [] { qApp->quit(); }); }); }); });
+    }
+    void ready(int tries = 0) {
+        window = qobject_cast<QQuickWindow *>(intf->p_mi ? intf->p_mi->intfMainWindow() : nullptr);
+        if (!window || !find(window->contentItem(), {"Renderer"}) || !player->isSeekable()) {
+            if (tries < 80) QTimer::singleShot(250, this, [this, tries] { ready(tries + 1); });
+            else {
+                QStringList seen; std::function<void(QQuickItem *)> walk = [&](QQuickItem *i) {
+                    if (!i->property("description").toString().isEmpty()) seen << i->property("description").toString() + (i->isVisible() ? "" : " (hidden)");
+                    for (auto c : i->childItems()) walk(c); };
+                if (window) walk(window->contentItem());
+                QFile f(prefix + ".txt"); if (f.open(QIODevice::WriteOnly | QIODevice::Text)) f.write(("not ready; seekable=" + QString::number(player->isSeekable()) + "\n" + seen.join('\n')).toUtf8());
+                qApp->quit();
+            }
+            return;
+        }
+        window->resize(1700, 900);   // the offscreen window is narrow: the layout would hide the right-most buttons
+        QTimer::singleShot(1500, this, [this] { run(); });
+    }
+public:
+    IconStatesTest(qt_intf_t *i, RebornController *r) : QObject(r), intf(i), player(i->p_mainPlayerController),
+        prefix(qEnvironmentVariable("VLC_REBORN_TEST_REPORT")) {
+        QTimer::singleShot(500, this, [this] { ready(); });
+        QTimer::singleShot(90000, this, [] { qApp->quit(); });
+    }
+};
diff --git a/reborn/tests/p1_benchmark.hpp b/reborn/tests/p1_benchmark.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..0f66fe1e336f618ef3aff53a1207acb95a0c316d
--- /dev/null
+++ b/reborn/tests/p1_benchmark.hpp
@@ -0,0 +1,98 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Opt-in backend benchmark (VLC_REBORN_TEST_MODE=preview-p1): issues scripted precise preview requests through the real
+// RebornController (cache, buckets, scheduling, QImage conversion) and records request -> finished-extraction time.
+// Targets come from VLC_NEON_P1_SCENARIOS/<name>.txt (one millisecond timestamp per line). Isolated settings only.
+#include <QJsonArray>
+class P1Benchmark : public QObject {
+    qt_intf_t *intf;
+    RebornController *reborn;
+    PlayerController *player;
+    QElapsedTimer clock, request;
+    QTimer poll;
+    QJsonArray rows;
+    QJsonObject stats;
+    QString report, scenarioDir, imageDir;
+    QStringList names;
+    QList<qint64> targets;
+    int scenario = -1, index = 0;
+    qint64 duration = 0, pausedTime = 0, extractionsBefore = 0, hitsBefore = 0;
+    double width = 73600;   // makes the timestamp bucket 100ms so each scripted target is its own cache key
+    QVariantMap metrics() const { return reborn->previewMetrics(); }
+    void ready(int tries = 0) {
+        duration = MS_FROM_VLC_TICK(player->getLength().toVLCTick());
+        if (duration <= 0 || !player->hasVideoOutput()) {
+            if (tries < 60) QTimer::singleShot(250, this, [this, tries] { ready(tries + 1); }); else finish();
+            return;
+        }
+        connect(player, &PlayerController::statisticsUpdated, this, [this](const input_stats_t &s) {
+            stats.insert("late", double(s.i_late_pictures)); stats.insert("lost_video", double(s.i_lost_pictures));
+            stats.insert("lost_audio_buffers", double(s.i_lost_abuffers)); stats.insert("displayed", double(s.i_displayed_pictures));
+        });
+        const bool playing = !qEnvironmentVariableIsEmpty("VLC_NEON_BENCH_PLAYING");
+        if (!playing) { vlc_player_locker lock(player->getPlayer()); vlc_player_Pause(player->getPlayer()); }
+        QTimer::singleShot(700, this, [this, playing] {
+            pausedTime = player->getTime().toVLCTick();
+            stats.insert("playing", playing); stats.insert("start_time_ms", double(MS_FROM_VLC_TICK(pausedTime)));
+            clock.start(); nextScenario();
+        });
+    }
+    void nextScenario() {
+        if (++scenario >= names.size()) {
+            const qint64 now = player->getTime().toVLCTick();
+            stats.insert("end_time_ms", double(MS_FROM_VLC_TICK(now)));
+            stats.insert("paused_time_unchanged", pausedTime == now);
+            finish(); return;
+        }
+        QFile f(scenarioDir + "/" + names[scenario] + ".txt");
+        targets.clear();
+        if (f.open(QIODevice::ReadOnly)) for (const auto &l : f.readAll().split('\n')) if (!l.trimmed().isEmpty()) targets << l.trimmed().toLongLong();
+        index = 0;
+        reborn->clearPreviewCache();
+        QTimer::singleShot(100, this, [this] { issue(); });
+    }
+    void issue() {
+        if (index >= targets.size()) { nextScenario(); return; }
+        const auto m = metrics();
+        extractionsBefore = m.value("extractions").toLongLong(); hitsBefore = m.value("cache_hits").toLongLong();
+        request.restart();
+        reborn->requestPreview(double(targets[index]) / duration, width);
+        poll.start(1);
+    }
+    void check() {
+        const auto m = metrics();
+        const bool hit = m.value("cache_hits").toLongLong() > hitsBefore;
+        const bool done = m.value("extractions").toLongLong() > extractionsBefore && !m.value("active").toBool();
+        const bool timeout = request.elapsed() > 10000;
+        if (!hit && !done && !timeout) return;
+        poll.stop();
+        const double ms = request.nsecsElapsed() / 1e6;
+        QJsonObject row {{"scenario", names[scenario]}, {"index", index}, {"target_ms", double(targets[index])}, {"latency_ms", ms},
+                         {"hit", hit}, {"timeout", timeout}, {"metrics", QJsonObject::fromVariantMap(m)}};
+        if (!imageDir.isEmpty() && done && !timeout && m.value("last_result_pts_ms").toLongLong() == m.value("actual_ms").toLongLong()) {
+            const auto image = reborn->previewImage();
+            if (!image.isNull()) image.save(QString("%1/%2_%3.png").arg(imageDir, names[scenario]).arg(index));
+        }
+        rows.append(row);
+        ++index;
+        QTimer::singleShot(0, this, [this] { issue(); });
+    }
+    void finish() {
+        QJsonObject out {{"rows", rows}, {"playback", stats}, {"elapsed_ms", double(clock.elapsed())}, {"final_metrics", QJsonObject::fromVariantMap(metrics())}};
+        QFile file(report); if (file.open(QIODevice::WriteOnly)) file.write(QJsonDocument(out).toJson());
+        qApp->quit();
+    }
+public:
+    P1Benchmark(qt_intf_t *i, RebornController *r) : QObject(r), intf(i), reborn(r), player(i->p_mainPlayerController),
+        report(qEnvironmentVariable("VLC_REBORN_TEST_REPORT")), scenarioDir(qEnvironmentVariable("VLC_NEON_P1_SCENARIOS")),
+        imageDir(qEnvironmentVariable("VLC_NEON_P1_IMAGES")) {
+        names = qEnvironmentVariable("VLC_NEON_P1_LIST", "fwd_seq,same_gop_fwd,same_gop_bwd,same_gop_rand,backward,cross_gop,random").split(',');
+        connect(&poll, &QTimer::timeout, this, [this] { check(); });
+        qApp->installEventFilter(this); QTimer::singleShot(500, this, [this] { ready(); });
+        QTimer::singleShot(600000, this, [this] { stats.insert("timeout", true); finish(); });
+    }
+    bool eventFilter(QObject *, QEvent *event) override {   // keep stray user input from perturbing the run
+        if (!event->spontaneous()) return false;
+        return event->type() == QEvent::KeyPress || event->type() == QEvent::KeyRelease || event->type() == QEvent::MouseMove
+            || event->type() == QEvent::MouseButtonPress || event->type() == QEvent::MouseButtonRelease || event->type() == QEvent::Wheel;
+    }
+};
diff --git a/reborn/tests/pip_back_test.hpp b/reborn/tests/pip_back_test.hpp
