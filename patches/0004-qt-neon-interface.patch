@@ -0,0 +1,89 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Opt-in check (VLC_REBORN_TEST_MODE=pipicon, VLC_REBORN_TEST_REPORT=<prefix>, VLC_REBORN_TEST_MEDIA2=<file>): real Wayland session needed.
+// Enters PiP, starts ANOTHER media while in PiP (the core would draw the file name as a title OSD), also triggers the volume and seek
+// OSD hotkeys, with the PiP overlay visible, and screenshots <prefix>-newvideo-early / -late / -osd / -menu. Checks that the core OSD
+// variables are overridden while PiP is up and restored after leaving it.
+class PipIconOsdTest : public QObject {
+    qt_intf_t *intf;
+    PlayerController *player;
+    RebornController *reborn;
+    QQuickWindow *window = nullptr;
+    QString prefix;
+    QStringList log;
+    bool failed = false;
+    void check(const QString &name, bool ok, const QString &detail = {}) { log << QStringLiteral("%1: %2 %3").arg(ok ? "PASS" : "FAIL", name, detail); if (!ok) failed = true; }
+    QWindow *pipWin() { for (QWindow *w : QGuiApplication::topLevelWindows()) if (w->title().startsWith("VLC Neon Picture-in-Picture")) return w; return nullptr; }
+    void move(QWindow *w, QPointF p) {
+        QMouseEvent ev(QEvent::MouseMove, p, p, w->mapToGlobal(p.toPoint()), Qt::NoButton, Qt::NoButton, Qt::NoModifier);
+        QCoreApplication::sendEvent(w, &ev);
+    }
+    void shot(const QString &name) { QProcess::execute("spectacle", {"-b", "-n", "-f", "-o", prefix + "-" + name + ".png"}); }
+    bool osdOff() {
+        vlc_object_t *o = VLC_OBJECT(vlc_object_instance(intf));
+        return !var_InheritBool(o, "osd") && !var_InheritBool(o, "video-title-show");
+    }
+    void run() {
+        auto after = [this](int ms, std::function<void()> f) { QTimer::singleShot(ms, this, f); };
+        check("OSD enabled before PiP", !osdOff());
+        reborn->togglePip(window);
+        after(2500, [=, this] {
+            QWindow *w = pipWin();
+            if (!w) { check("PiP window found", false); finish(); return; }
+            check("core OSD + title off while PiP is up", osdOff());
+            const QString media = qEnvironmentVariable("VLC_REBORN_TEST_MEDIA2");
+            intf->p_mainPlaylistController->append(QVariant(QUrl::fromLocalFile(media)), true);
+            auto wiggle = [=, this] { for (int i = 0; i < 5; ++i) move(w, QPointF(w->width() / 2 + i * 7, w->height() / 2 + i * 3)); };
+            after(900, [=, this] {
+                wiggle();
+                after(500, [=, this] {
+                    shot("newvideo-early");
+                    after(1500, [=, this] {
+                        wiggle();
+                        shot("newvideo-late");
+                        // volume and seek OSD (core hotkeys)
+                        intf->p_mi->sendHotkey(Qt::Key_Up, Qt::NoModifier);
+                        intf->p_mi->sendHotkey(Qt::Key_Right, Qt::ShiftModifier);
+                        after(300, [=, this] {
+                            wiggle();
+                            shot("osd");
+                            QMetaObject::invokeMethod(w, "update");
+                            // the context menu (icon on "Back to main window")
+                            QMouseEvent press(QEvent::MouseButtonPress, QPointF(w->width() / 2, w->height() / 2), QPointF(w->width() / 2, w->height() / 2),
+                                              w->mapToGlobal(QPoint(w->width() / 2, w->height() / 2)), Qt::RightButton, Qt::RightButton, Qt::NoModifier);
+                            QMouseEvent release(QEvent::MouseButtonRelease, press.position(), press.position(), press.globalPosition(), Qt::RightButton, Qt::NoButton, Qt::NoModifier);
+                            QCoreApplication::sendEvent(w, &press); QCoreApplication::sendEvent(w, &release);
+                            after(600, [=, this] {
+                                shot("menu");
+                                reborn->exitPipWindow(true);
+                                after(2500, [=, this] {
+                                    check("core OSD + title restored after PiP", !osdOff());
+                                    finish();
+                                });
+                            });
+                        });
+                    });
+                });
+            });
+        });
+    }
+    void finish() {
+        log << (failed ? "RESULT: FAIL" : "RESULT: PASS");
+        QFile f(prefix + ".txt"); if (f.open(QIODevice::WriteOnly | QIODevice::Text)) f.write(log.join('\n').toUtf8());
+        std::thread([] { std::this_thread::sleep_for(std::chrono::seconds(15)); std::_Exit(4); }).detach();
+        qApp->quit();
+    }
+    void ready(int tries = 0) {
+        window = qobject_cast<QQuickWindow *>(intf->p_mi ? intf->p_mi->intfMainWindow() : nullptr);
+        if (!window || !player->isSeekable() || !intf->p_mi->hasEmbededVideo()) {
+            if (tries < 200) QTimer::singleShot(250, this, [this, tries] { ready(tries + 1); }); else { log << "not ready"; failed = true; finish(); }
+            return;
+        }
+        QTimer::singleShot(2500, this, [this] { run(); });
+    }
+public:
+    PipIconOsdTest(qt_intf_t *i, RebornController *r) : QObject(r), intf(i), player(i->p_mainPlayerController), reborn(r),
+        prefix(qEnvironmentVariable("VLC_REBORN_TEST_REPORT")) {
+        QTimer::singleShot(500, this, [this] { ready(); });
+        QTimer::singleShot(100000, this, [this] { log << "timeout"; failed = true; finish(); });
+    }
+};
diff --git a/reborn/tests/pip_input_test.hpp b/reborn/tests/pip_input_test.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..d771afe5db3457302c8f70d6fff6cb776c4e62a2
--- /dev/null
+++ b/reborn/tests/pip_input_test.hpp
@@ -0,0 +1,148 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Opt-in check (VLC_REBORN_TEST_MODE=pipinput, VLC_REBORN_TEST_REPORT=<prefix>): needs a real Wayland session.
+// Pointer input in PiP (overlay shows on hover without any click, hides 2 s after the pointer stops, stays over a button,
+// a click on the video does not pause, a double click goes back), the core OSD icon, and the minimized-window cases
+// (playback keeps going, quitting does not hang). Screenshots <prefix>-osd-main.png / -osd-pip.png / -hover.png.
+class PipInputTest : public QObject {
+    qt_intf_t *intf;
+    PlayerController *player;
+    RebornController *reborn;
+    QQuickWindow *window = nullptr;
+    QString prefix;
+    QStringList log;
+    bool failed = false;
+    QWindow *pipWin() { for (QWindow *w : QGuiApplication::topLevelWindows()) if (w->title().startsWith("VLC Neon Picture-in-Picture")) return w; return nullptr; }
+    static QQuickItem *walk(QQuickItem *i, const std::function<bool(QQuickItem *)> &pred) {
+        if (pred(i)) return i;
+        for (auto c : i->childItems()) if (auto f = walk(c, pred)) return f;
+        return nullptr;
+    }
+    qreal overlayOpacity() {
+        auto *w = qobject_cast<QQuickWindow *>(pipWin());
+        QQuickItem *o = w ? walk(w->contentItem(), [](QQuickItem *i) { return i->objectName() == "pipOverlay"; }) : nullptr;
+        return o ? o->opacity() : -1;
+    }
+    void check(const QString &name, bool ok, const QString &detail = {}) { log << QStringLiteral("%1: %2 %3").arg(ok ? "PASS" : "FAIL", name, detail); if (!ok) failed = true; }
+    void move(QWindow *w, QPointF p) {
+        QMouseEvent ev(QEvent::MouseMove, p, p, w->mapToGlobal(p.toPoint()), Qt::NoButton, Qt::NoButton, Qt::NoModifier);
+        QCoreApplication::sendEvent(w, &ev);
+    }
+    void click(QWindow *w, QPointF p) {
+        QMouseEvent press(QEvent::MouseButtonPress, p, p, w->mapToGlobal(p.toPoint()), Qt::LeftButton, Qt::LeftButton, Qt::NoModifier);
+        QMouseEvent release(QEvent::MouseButtonRelease, p, p, w->mapToGlobal(p.toPoint()), Qt::LeftButton, Qt::NoButton, Qt::NoModifier);
+        QCoreApplication::sendEvent(w, &press); QCoreApplication::sendEvent(w, &release);
+    }
+    void shot(const QString &name) { QProcess::execute("spectacle", {"-b", "-n", "-f", "-o", prefix + "-" + name + ".png"}); }
+    void pause() { vlc_player_locker lock(player->getPlayer()); vlc_player_Pause(player->getPlayer()); }
+    void resume() { vlc_player_locker lock(player->getPlayer()); vlc_player_Resume(player->getPlayer()); }
+    void after(int ms, std::function<void()> f) { QTimer::singleShot(ms, this, f); }
+    bool playing() { return player->getPlayingState() == PlayerController::PLAYING_STATE_PLAYING; }
+    void run() {
+        // 1. positive control: the core OSD icon in the main window (screenshot 250 ms after pausing)
+        log << QStringLiteral("osd variable before PiP: %1").arg(var_InheritBool(intf, "osd"));
+        pause();
+        after(250, [=, this] {
+            shot("osd-main");
+            resume();
+            after(1500, [=, this] {
+                reborn->togglePip(window);
+                after(2500, [=, this] {
+                    QWindow *w = pipWin();
+                    if (!w) { check("PiP window present", false); finish(); return; }
+                    log << QStringLiteral("osd variable in PiP: %1").arg(var_InheritBool(intf, "osd"));
+                    check("core OSD off while PiP is open", !var_InheritBool(intf, "osd"));
+                    // 2. the OSD icon after pausing inside the PiP
+                    pause();
+                    after(250, [=, this] {
+                        shot("osd-pip");
+                        resume();
+                        after(1500, [=, this] { hoverPhase(w); });
+                    });
+                });
+            });
+        });
+    }
+    void hoverPhase(QWindow *w) {
+        check("overlay hidden before the pointer arrives", overlayOpacity() < 0.05, QString::number(overlayOpacity()));
+        for (int i = 0; i < 6; ++i) move(w, QPointF(w->width() * 0.3 + i * 9, w->height() * 0.4 + i * 4));   // over the video, no click
+        after(450, [=, this] {
+            check("overlay shows on hover, without a click", overlayOpacity() > 0.95, QString::number(overlayOpacity()));
+            check("still playing (no click happened)", playing());
+            shot("hover");
+            after(2800, [=, this] {
+                check("overlay hides about 2 s after the pointer stopped", overlayOpacity() < 0.05, QString::number(overlayOpacity()));
+                // 3. pointer over a button: stays shown
+                auto *qw = qobject_cast<QQuickWindow *>(w);
+                QQuickItem *play = walk(qw->contentItem(), [](QQuickItem *i) { const QString d = i->property("description").toString(); return d == "Pause" || d == "Play"; });
+                const QPointF c = play ? play->mapToScene(QPointF(play->width() / 2, play->height() / 2)) : QPointF(w->width() / 2, w->height() - 40);
+                move(w, QPointF(w->width() * 0.3, w->height() * 0.4)); move(w, c);
+                // the first move makes the (hidden) overlay appear; the pointer then keeps moving, over the now visible button
+                after(500, [=, this] { move(w, c + QPointF(1, 1)); });
+                after(900, [=, this] { log << QStringLiteral("   debug: play button hovered=%1 visible=%2 pos=%3,%4 size=%5 overlay opacity=%6").arg(play ? play->property("hovered").toBool() : -1).arg(play ? play->isVisible() : -1).arg(c.x()).arg(c.y()).arg(play ? play->width() : -1).arg(overlayOpacity()); });
+                after(3500, [=, this] {
+                    check("overlay stays while the pointer is over a button", overlayOpacity() > 0.95, QString::number(overlayOpacity()));
+                    // 4. a click on the video does not pause
+                    move(w, QPointF(w->width() * 0.25, w->height() * 0.3));
+                    const bool before = playing();
+                    click(w, QPointF(w->width() * 0.25, w->height() * 0.3));
+                    after(700, [=, this] {
+                        check("single click on the video does not pause", before && playing());
+                    // jump feedback: the +3 s button flashes on Player.jumped (like the toolbar's)
+                    { auto *qw = qobject_cast<QQuickWindow *>(w);
+                      QQuickItem *skip3 = walk(qw->contentItem(), [](QQuickItem *i) { return i->property("description").toString() == "Forward 3 seconds"; });
+                      check("+3 s button present (size >= 430 px wide shows it)", skip3 != nullptr);
+                      player->jumpBy(3);
+                      after(40, [=, this] { check("+3 s button flashes on Player.jumped", skip3 && skip3->property("_flash").toDouble() > 0.05, skip3 ? QString::number(skip3->property("_flash").toDouble()) : QString()); }); }
+                        // 5. double click: back to the main window
+                        click(w, QPointF(w->width() * 0.25, w->height() * 0.3));
+                        click(w, QPointF(w->width() * 0.25, w->height() * 0.3));
+                        after(2500, [=, this] {
+                            check("double click goes back to the main window", !reborn->pipActive());
+                            minimizedPhase();
+                        });
+                    });
+                });
+            });
+        });
+    }
+    void minimizedPhase() {
+        // enter PiP, minimize the main window, Close: the video goes back into the minimized window and must keep playing
+        reborn->togglePip(window);
+        after(2500, [=, this] {
+            window->showMinimized();
+            after(1500, [=, this] {
+                reborn->exitPipWindow(false);
+                after(2500, [=, this] {
+                    const qint64 t0 = MS_FROM_VLC_TICK(player->getTime().toVLCTick());
+                    after(3000, [=, this] {
+                        const qint64 t1 = MS_FROM_VLC_TICK(player->getTime().toVLCTick());
+                        check("playback keeps going with the main window minimized", t1 - t0 > 2000, QStringLiteral("%1 -> %2 ms in 3 s").arg(t0).arg(t1));
+                        check("still playing", playing());
+                        finish();
+                    });
+                });
+            });
+        });
+    }
+    void finish() {
+        log << (failed ? "RESULT: FAIL" : "RESULT: PASS") << "QUIT: requested now (the watchdog writes <prefix>.quit-hang if the process is still alive after 15 s)";
+        QFile f(prefix + ".txt"); if (f.open(QIODevice::WriteOnly | QIODevice::Text)) f.write(log.join('\n').toUtf8());
+        const QString hang = prefix + ".quit-hang";
+        std::thread([hang] { std::this_thread::sleep_for(std::chrono::seconds(15)); QFile h(hang); if (h.open(QIODevice::WriteOnly)) h.write("quit hung"); std::_Exit(4); }).detach();
+        qApp->quit();
+    }
+    void ready(int tries = 0) {
+        window = qobject_cast<QQuickWindow *>(intf->p_mi ? intf->p_mi->intfMainWindow() : nullptr);
+        if (!window || !player->isSeekable() || !intf->p_mi->hasEmbededVideo() || !playing()) {
+            if (tries < 200) QTimer::singleShot(250, this, [this, tries] { ready(tries + 1); }); else { log << "not ready"; finish(); }
+            return;
+        }
+        QTimer::singleShot(2500, this, [this] { run(); });
+    }
+public:
+    PipInputTest(qt_intf_t *i, RebornController *r) : QObject(r), intf(i), player(i->p_mainPlayerController), reborn(r),
+        prefix(qEnvironmentVariable("VLC_REBORN_TEST_REPORT")) {
+        QTimer::singleShot(500, this, [this] { ready(); });
+        QTimer::singleShot(150000, this, [this] { log << "timeout"; failed = true; finish(); });
+    }
+};
diff --git a/reborn/tests/pip_spike_test.hpp b/reborn/tests/pip_spike_test.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..35cf1e79536e4484fea778b5b9292fdc1232bc32
--- /dev/null
+++ b/reborn/tests/pip_spike_test.hpp
@@ -0,0 +1,139 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Opt-in PiP measurement/behaviour check (VLC_REBORN_TEST_MODE=pipspike, VLC_REBORN_TEST_REPORT=<prefix>): needs a real Wayland session
+// (e.g. a private `dbus-run-session -- kwin_wayland --virtual`). Measures the process CPU time while the same video plays
+//   A) in the normal main window, B) in the single-window PiP (main window shrunk), C) in a separate bare PiP window,
+// triggers the re-parent both ways, and takes a screenshot of each state with spectacle (<prefix>-<state>.png).
+class PipSpikeTest : public QObject {
+    qt_intf_t *intf;
+    PlayerController *player;
+    RebornController *reborn;
+    QQuickWindow *window = nullptr;
+    QString prefix;
+    QStringList log;
+    QElapsedTimer clock;
+    static double cpuSeconds() {
+        QFile f("/proc/self/stat"); if (!f.open(QIODevice::ReadOnly)) return 0;
+        QFile g("/proc/self/stat"); g.open(QIODevice::ReadOnly);
+        const QByteArray data = g.readAll(); const QList<QByteArray> p = data.mid(data.lastIndexOf(')') + 2).split(' ');
+        return (p.value(11).toLongLong() + p.value(12).toLongLong()) / double(sysconf(_SC_CLK_TCK));   // utime + stime
+    }
+    void note(const QString &s) { log << QStringLiteral("[%1 ms] %2").arg(clock.elapsed(), 6).arg(s); }
+    void shot(const QString &name) { QProcess::execute("spectacle", {"-b", "-n", "-f", "-o", prefix + "-" + name + ".png"}); }
+    // measure the CPU use over `ms` of playback, then continue
+    void measure(const QString &state, int ms, std::function<void()> next) {
+        const double c0 = cpuSeconds(); QElapsedTimer t; t.start();
+        QTimer::singleShot(ms, this, [=, this] {
+            const double pct = 100.0 * (cpuSeconds() - c0) / (t.elapsed() / 1000.0);
+            note(QStringLiteral("%1: process CPU %2 %% of one core over %3 ms, position %4 ms").arg(state).arg(pct, 0, 'f', 1).arg(t.elapsed()).arg(MS_FROM_VLC_TICK(player->getTime().toVLCTick())));
+            next();
+        });
+    }
+    void finish() {
+        QFile f(prefix + ".txt"); if (f.open(QIODevice::WriteOnly | QIODevice::Text)) f.write(log.join('\n').toUtf8());
+        qApp->quit();
+    }
+    QWindow *pipWin() { for (QWindow *w : QGuiApplication::topLevelWindows()) if (w->title().startsWith("VLC Neon Picture-in-Picture")) return w; return nullptr; }
+    void key(QWindow *w, int k) {
+        QKeyEvent press(QEvent::KeyPress, k, Qt::NoModifier), release(QEvent::KeyRelease, k, Qt::NoModifier);
+        QCoreApplication::sendEvent(w, &press); QCoreApplication::sendEvent(w, &release);
+    }
+    void run() {
+        auto after = [this](int ms, std::function<void()> f) { QTimer::singleShot(ms, this, f); };
+        clock.start();
+        note(QStringLiteral("main window %1x%2 dpr %3, platform %4").arg(window->width()).arg(window->height()).arg(window->devicePixelRatio()).arg(QGuiApplication::platformName()));
+        // keyboard / close / back behaviour, last
+        auto stageEnd = [=, this] {
+            note(QStringLiteral("end: pip active %1, main window visibility %2").arg(reborn->pipActive()).arg(int(window->visibility())));
+            finish();
+        };
+        auto stageClose = [=, this] {   // Close with the main window minimized: the video moves back, the window stays minimized
+            reborn->togglePip(window);
+            after(2000, [=, this] {
+                window->showMinimized();
+                after(1500, [=, this] {
+                    reborn->exitPipWindow(false);
+                    after(2500, [=, this] {
+                        note(QStringLiteral("Close with minimized main window: pip active %1, main visibility %2 (9 = Minimized), playing state %3, position %4 ms")
+                             .arg(reborn->pipActive()).arg(int(window->visibility())).arg(int(player->getPlayingState())).arg(MS_FROM_VLC_TICK(player->getTime().toVLCTick())));
+                        stageEnd();
+                    });
+                });
+            });
+        };
+        auto stageKeys = [=, this] {
+            reborn->togglePip(window);
+            after(2500, [=, this] {
+                QWindow *w = pipWin();
+                if (!w) { note("keys: PiP window not found"); stageEnd(); return; }
+                const int state0 = int(player->getPlayingState());
+                key(w, Qt::Key_Space);
+                after(800, [=, this] {
+                    note(QStringLiteral("Space: playing state %1 -> %2 (2 = playing, 3 = paused?)").arg(state0).arg(int(player->getPlayingState())));
+                    key(w, Qt::Key_Space);
+                    after(800, [=, this] {
+                        const qint64 t0 = MS_FROM_VLC_TICK(player->getTime().toVLCTick());
+                        key(w, Qt::Key_Right);   // VLC hotkey: forward jump
+                        after(1200, [=, this] {
+                            note(QStringLiteral("Right arrow: position %1 -> %2 ms").arg(t0).arg(MS_FROM_VLC_TICK(player->getTime().toVLCTick())));
+                            key(w, Qt::Key_Escape);
+                            after(2500, [=, this] {
+                                note(QStringLiteral("Esc: pip active %1 (expect 0)").arg(reborn->pipActive()));
+                                stageClose();
+                            });
+                        });
+                    });
+                });
+            });
+        };
+        auto stageBack = [=, this] {   // Back with the main window minimized: must restore it
+            const int before = int(window->visibility());
+            reborn->exitPipWindow(true);
+            after(3000, [=, this] {
+                note(QStringLiteral("Back with minimized main window: visibility %1 -> %2 (9 = Minimized, 2 = Windowed)").arg(before).arg(int(window->visibility())));
+                shot("back-in-main");
+                measure("A' main window again", 4000, stageKeys);
+            });
+        };
+        auto stageC2 = [=, this] {
+            window->showMinimized();   // what the user does: minimize the main window
+            after(2000, [=, this] { measure("C2 separate PiP window, main window minimized", 8000, stageBack); });
+        };
+        auto stageC = [=, this] {
+            note(QStringLiteral("C: switching to the separate PiP window (pid %1)").arg(getpid()));
+            const qint64 t0 = player->getTime().toVLCTick();
+            reborn->togglePip(window);
+            note(QStringLiteral("C: pip active %1, pipHosted %2").arg(reborn->pipActive()).arg(reborn->pipHosted()));
+            after(2500, [=, this] {
+                shot("separate-pip");
+                note(QStringLiteral("C: video advanced %1 ms in the 2.5 s after switching").arg(MS_FROM_VLC_TICK(player->getTime().toVLCTick() - t0)));
+                measure("C separate PiP window, main window visible (placeholder)", 6000, stageC2);
+            });
+        };
+        auto stageB = [=, this] {
+            reborn->togglePip(window);
+            after(2500, [=, this] {
+                shot("single-window-pip");
+                measure("B single-window PiP", 8000, [=, this] {
+                    reborn->togglePip(window);
+                    after(2500, stageC);
+                });
+            });
+        };
+        after(2000, [=, this] { shot("main"); measure("A main window", 8000, stageC); });
+        Q_UNUSED(stageB);
+    }
+    void ready(int tries = 0) {
+        window = qobject_cast<QQuickWindow *>(intf->p_mi ? intf->p_mi->intfMainWindow() : nullptr);
+        if (!window || !player->isSeekable() || !intf->p_mi->hasEmbededVideo()) {
+            if (tries < 120) QTimer::singleShot(250, this, [this, tries] { ready(tries + 1); }); else { log << "not ready (no embedded video?)"; QFile f(prefix + ".txt"); if (f.open(QIODevice::WriteOnly | QIODevice::Text)) f.write(log.join('\n').toUtf8()); qApp->quit(); }
+            return;
+        }
+        QTimer::singleShot(1500, this, [this] { run(); });
+    }
+public:
+    PipSpikeTest(qt_intf_t *i, RebornController *r) : QObject(r), intf(i), player(i->p_mainPlayerController), reborn(r),
+        prefix(qEnvironmentVariable("VLC_REBORN_TEST_REPORT")) {
+        QTimer::singleShot(500, this, [this] { ready(); });
+        QTimer::singleShot(150000, this, [] { qApp->quit(); });
+    }
+};
diff --git a/reborn/tests/pip_stress_test.hpp b/reborn/tests/pip_stress_test.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..00e685a197725e6eec528ac3a6ce76e084aa9318
--- /dev/null
+++ b/reborn/tests/pip_stress_test.hpp
@@ -0,0 +1,126 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Opt-in stress test (VLC_REBORN_TEST_MODE=pipstress, VLC_REBORN_TEST_REPORT=<prefix>): needs a real Wayland session (the
+// private headless KWin used by the PiP tests). Enters/exits Picture-in-Picture right after the video starts, 100 times in
+// quick succession, resizes the window during playback, and uses Back/Close while the main window is minimized.
+// A watchdog thread FAILS the test (and ends the process) if the GUI thread does not run for more than 500 ms.
+class PipStressTest : public QObject {
+    qt_intf_t *intf;
+    PlayerController *player;
+    RebornController *reborn;
+    QQuickWindow *window = nullptr;
+    QString prefix;
+    QStringList log;
+    std::atomic<qint64> beat {0};
+    std::atomic<bool> finished {false}, started {false};
+    std::mutex stageLock;
+    QString stage = "startup";
+    QElapsedTimer clock;
+    std::thread dog;
+    QTimer heartbeat;
+    qint64 worstGap = 0;
+    static qint64 nowMs() { return std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch()).count(); }
+    void setStage(const QString &s) { { std::lock_guard<std::mutex> l(stageLock); stage = s; } log << QStringLiteral("[%1 ms] %2").arg(clock.elapsed(), 6).arg(s); }
+    void writeReport(const QString &result) {
+        log << result;
+        QFile f(prefix + ".txt"); if (f.open(QIODevice::WriteOnly | QIODevice::Text)) { f.write(log.join('\n').toUtf8()); f.write("\n"); }
+    }
+    QWindow *pipWin() { for (QWindow *w : QGuiApplication::topLevelWindows()) if (w->title().startsWith("VLC Neon Picture-in-Picture")) return w; return nullptr; }
+    void watchdog() {
+        while (!finished) {
+            std::this_thread::sleep_for(std::chrono::milliseconds(50));
+            if (!started) continue;
+            const qint64 gap = nowMs() - beat.load();
+            if (gap > worstGap) worstGap = gap;
+            if (gap > 500) {
+                QString where; { std::lock_guard<std::mutex> l(stageLock); where = stage; }
+                QFile f(prefix + ".txt");
+                if (f.open(QIODevice::WriteOnly | QIODevice::Text)) f.write((log.join('\n') + QStringLiteral("\nRESULT: FAIL - the GUI thread was blocked for %1 ms during: %2\n").arg(gap).arg(where)).toUtf8());
+                f.close();
+                std::_Exit(3);
+            }
+        }
+    }
+    void after(int ms, std::function<void()> f) { QTimer::singleShot(ms, this, f); }
+    // `n` more toggles, a random 40..250 ms apart: enters, aborts while opening, exits, ...
+    void rapid(int n, std::function<void()> next) {
+        if (n <= 0) { next(); return; }
+        reborn->togglePip(window);
+        after(40 + QRandomGenerator::global()->bounded(210), [=, this] { rapid(n - 1, next); });
+    }
+    // bring the PiP back to Idle
+    void settle(std::function<void()> next) {
+        if (reborn->pipActive() && !reborn->pipHosted() && !pipWin()) { next(); return; }
+        if (reborn->pipHosted()) reborn->exitPipWindow(false);
+        else reborn->togglePip(window);
+        after(300, [=, this] { if (reborn->pipActive() || pipWin()) settle(next); else next(); });
+    }
+    void run() {
+        clock.start();
+        started = true;
+        setStage("1. enter PiP right after the video started");
+        reborn->togglePip(window);
+        after(2500, [=, this] {
+            log << QStringLiteral("   pipActive=%1 pipHosted=%2").arg(reborn->pipActive()).arg(reborn->pipHosted());
+            settle([=, this] {
+            setStage("2. 100 quick enter/exit toggles");
+            rapid(100, [=, this] { settle([=, this] {
+                setStage("3. enter, then resize the window 80 times during playback");
+                reborn->togglePip(window);
+                after(1500, [=, this] {
+                    QWindow *w = pipWin();
+                    auto step = std::make_shared<std::function<void(int)>>();
+                    *step = [=, this](int i) {
+                        if (i >= 80 || !w) {
+                            settle([=, this] {
+                                setStage("4. Back and Close with the main window minimized (10 cycles)");
+                                window->showMinimized();
+                                auto cycle = std::make_shared<std::function<void(int)>>();
+                                *cycle = [=, this](int i) {
+                                    if (i >= 10) { settle([=, this] { setStage("5. final state"); finish(); }); return; }
+                                    reborn->togglePip(window);
+                                    after(700, [=, this] { reborn->exitPipWindow(i % 2 == 0); after(500, [=, this] { (*cycle)(i + 1); }); });
+                                };
+                                (*cycle)(0);
+                            });
+                            return;
+                        }
+                        const int width = 300 + (i % 20) * 12;
+                        w->resize(width, qRound(width * 9.0 / 16));
+                        after(30, [=, this] { (*step)(i + 1); });
+                    };
+                    (*step)(0);
+                });
+            }); });
+            });
+        });
+    }
+    void finish() {
+        finished = true;
+        const bool playing = player->getPlayingState() == PlayerController::PLAYING_STATE_PLAYING;
+        const bool idle = !reborn->pipActive() && !pipWin();
+        log << QStringLiteral("   final: playing=%1 pip idle=%2 worst GUI-thread gap %3 ms").arg(playing).arg(idle).arg(worstGap);
+        writeReport(playing && idle ? "RESULT: PASS" : "RESULT: FAIL - final state wrong");
+        qApp->quit();
+    }
+    void ready(int tries = 0) {
+        window = qobject_cast<QQuickWindow *>(intf->p_mi ? intf->p_mi->intfMainWindow() : nullptr);
+        // as early as possible: the first moment the video is embedded
+        if (!window || !intf->p_mi->hasEmbededVideo()) {
+            if (tries < 400) QTimer::singleShot(25, this, [this, tries] { ready(tries + 1); }); else { writeReport("RESULT: FAIL - no video"); qApp->quit(); }
+            return;
+        }
+        run();
+    }
+public:
+    PipStressTest(qt_intf_t *i, RebornController *r) : QObject(r), intf(i), player(i->p_mainPlayerController), reborn(r),
+        prefix(qEnvironmentVariable("VLC_REBORN_TEST_REPORT")) {
+        beat = nowMs();
+        heartbeat.setInterval(20);
+        connect(&heartbeat, &QTimer::timeout, this, [this] { beat = nowMs(); });
+        heartbeat.start();
+        dog = std::thread([this] { watchdog(); });
+        dog.detach();
+        QTimer::singleShot(300, this, [this] { ready(); });
+        QTimer::singleShot(170000, this, [this] { writeReport("RESULT: FAIL - timeout"); qApp->quit(); });
+    }
+};
diff --git a/reborn/tests/pip_test.hpp b/reborn/tests/pip_test.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..24f2a234eb30b2a6cb389d9be51df26631492967
--- /dev/null
+++ b/reborn/tests/pip_test.hpp
@@ -0,0 +1,88 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Opt-in check (VLC_REBORN_TEST_MODE=pip, VLC_REBORN_TEST_REPORT=<prefix>): toggles Picture-in-Picture through the toolbar
+// button, checks placement (inside the work area, bottom-right, margin), aspect ratio, title, checked state and tooltip,
+// renders <prefix>-pip.png (hover overlay shown) and <prefix>-pip-idle.png, then toggles back. Run with QT_QPA_PLATFORM=offscreen.
+class PipTest : public QObject {
+    qt_intf_t *intf;
+    PlayerController *player;
+    RebornController *reborn;
+    QQuickWindow *window = nullptr;
+    QString prefix;
+    QStringList log;
+    bool failed = false;
+    static QQuickItem *walk(QQuickItem *i, const std::function<bool(QQuickItem *)> &pred) {
+        if (pred(i)) return i;
+        for (auto c : i->childItems()) if (auto f = walk(c, pred)) return f;
+        return nullptr;
+    }
+    QQuickItem *pipButton() { return walk(window->contentItem(), [](QQuickItem *i) { const QString d = i->property("description").toString(); return d == "Picture-in-Picture" || d == "Exit Picture-in-Picture"; }); }
+    void check(const QString &name, bool ok, const QString &detail = {}) { log << QStringLiteral("%1: %2 %3").arg(ok ? "PASS" : "FAIL", name, detail); if (!ok) failed = true; }
+    void mouse(const QPointF &p) {
+        QMouseEvent ev(QEvent::MouseMove, p, p, window->mapToGlobal(p.toPoint()), Qt::NoButton, Qt::NoButton, Qt::NoModifier);
+        QCoreApplication::sendEvent(window, &ev);
+    }
+    void run() {
+        auto after = [this](int ms, std::function<void()> f) { QTimer::singleShot(ms, this, f); };
+        QQuickItem *b = pipButton();
+        if (!b) { check("PiP button present", false); finish(); return; }
+        check("button idle tooltip", b->property("description").toString() == "Picture-in-Picture", b->property("description").toString());
+        check("button idle not checked", !b->property("checked").toBool());
+        const QSize before = window->size();
+        QMetaObject::invokeMethod(b, "clicked");
+        after(1500, [=, this] {
+            const QRect work = window->screen()->availableGeometry();
+            const QRect g = window->geometry();
+            check("PiP active", reborn->compact());
+            check("title", window->title() == "VLC Neon Picture-in-Picture", window->title());
+            check("inside work area", work.contains(g), QStringLiteral("window %1,%2 %3x%4 work %5,%6 %7x%8").arg(g.x()).arg(g.y()).arg(g.width()).arg(g.height()).arg(work.x()).arg(work.y()).arg(work.width()).arg(work.height()));
+            check("bottom-right margin 16", qAbs(work.right() - g.right() - 15) <= 1 && qAbs(work.bottom() - g.bottom() - 15) <= 1, QStringLiteral("right gap %1 bottom gap %2").arg(work.right() - g.right()).arg(work.bottom() - g.bottom()));
+            check("stays above", intf->p_mi->isInterfaceAlwaysOnTop());
+            check("smaller than main window (or default size)", g.width() < before.width() || g.width() == 480, QStringLiteral("%1 vs %2").arg(g.width()).arg(before.width()));
+            const double aspect = 16.0 / 9;   // test media is 16:9
+            check("aspect ratio kept", qAbs(double(g.width()) / g.height() - aspect) < 0.03, QStringLiteral("%1x%2").arg(g.width()).arg(g.height()));
+            QQuickItem *back = walk(window->contentItem(), [](QQuickItem *i) { return i->property("description").toString() == "Back to main window"; });
+            QQuickItem *close = walk(window->contentItem(), [](QQuickItem *i) { return i->property("description").toString() == "Close Picture-in-Picture"; });
+            QQuickItem *skip = walk(window->contentItem(), [](QQuickItem *i) { return i->property("description").toString() == "Forward 10 seconds"; });
+            check("overlay buttons: back, close, play/pause, +-10 s", back && close && skip && walk(window->contentItem(), [](QQuickItem *i) { const QString d = i->property("description").toString(); return d == "Pause" || d == "Play"; }));
+            window->grabWindow().save(prefix + "-pip-idle.png");
+            mouse(QPointF(g.width() / 2, g.height() / 2));
+            after(500, [=, this] {
+                window->grabWindow().save(prefix + "-pip.png");
+                // user resizes to a wrong ratio: the window must come back to the video ratio
+                window->resize(600, 600);
+                after(500, [=, this] {
+                    check("resize keeps aspect", qAbs(double(window->width()) / window->height() - 16.0 / 9) < 0.03, QStringLiteral("%1x%2").arg(window->width()).arg(window->height()));
+                    QMetaObject::invokeMethod(walk(window->contentItem(), [](QQuickItem *i) { return i->property("description").toString() == "Back to main window"; }), "clicked");
+                    after(1200, [=, this] {
+                        check("PiP closed", !reborn->compact());
+                        check("title restored", window->title() != "VLC Neon Picture-in-Picture", window->title());
+                        check("back to the main window size", window->size() == before, QStringLiteral("%1x%2 vs %3x%4").arg(window->width()).arg(window->height()).arg(before.width()).arg(before.height()));
+                        check("above restored", !intf->p_mi->isInterfaceAlwaysOnTop());
+                        QQuickItem *b3 = pipButton();
+                        check("toolbar button back to idle", b3 && b3->property("description").toString() == "Picture-in-Picture" && !b3->property("checked").toBool());
+                        finish();
+                    });
+                });
+            });
+        });
+    }
+    void finish() {
+        log << (failed ? "RESULT: FAIL" : "RESULT: PASS");
+        QFile f(prefix + ".txt"); if (f.open(QIODevice::WriteOnly | QIODevice::Text)) f.write(log.join('\n').toUtf8());
+        qApp->quit();
+    }
+    void ready(int tries = 0) {
+        window = qobject_cast<QQuickWindow *>(intf->p_mi ? intf->p_mi->intfMainWindow() : nullptr);
+        if (!window || !pipButton() || !player->isSeekable()) {
+            if (tries < 80) QTimer::singleShot(250, this, [this, tries] { ready(tries + 1); }); else { log << "not ready"; finish(); }
+            return;
+        }
+        QTimer::singleShot(1500, this, [this] { run(); });
+    }
+public:
+    PipTest(qt_intf_t *i, RebornController *r) : QObject(r), intf(i), player(i->p_mainPlayerController), reborn(r),
+        prefix(qEnvironmentVariable("VLC_REBORN_TEST_REPORT")) {
+        QTimer::singleShot(500, this, [this] { ready(); });
+        QTimer::singleShot(90000, this, [this] { log << "timeout"; finish(); });
+    }
+};
diff --git a/reborn/tests/pip_visual_test.hpp b/reborn/tests/pip_visual_test.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..ed3ba0cc43bc5744ab39c616bce6a731e72a51fa
--- /dev/null
+++ b/reborn/tests/pip_visual_test.hpp
@@ -0,0 +1,70 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Opt-in visual check (VLC_REBORN_TEST_MODE=pipvisual, VLC_REBORN_TEST_REPORT=<prefix>): real Wayland session needed.
+// Enters PiP, hovers it (overlay visible), screenshots; moves the pointer over the main window (placeholder), screenshots;
+// writes the item tree of the PiP window. <prefix>-pip.png, <prefix>-main.png, <prefix>.txt
+class PipVisualTest : public QObject {
+    qt_intf_t *intf;
+    PlayerController *player;
+    RebornController *reborn;
+    QQuickWindow *window = nullptr;
+    QString prefix;
+    QStringList log;
+    QWindow *pipWin() { for (QWindow *w : QGuiApplication::topLevelWindows()) if (w->title().startsWith("VLC Neon Picture-in-Picture")) return w; return nullptr; }
+    static void tree(QQuickItem *i, int depth, QStringList &out) {
+        if (!i->isVisible()) return;
+        out << QString(depth * 2, ' ') + QString::fromLatin1(i->metaObject()->className()) + (i->objectName().isEmpty() ? QString() : QStringLiteral(" #") + i->objectName());
+        for (auto c : i->childItems()) tree(c, depth + 1, out);
+    }
+    void move(QWindow *w, QPointF p) {
+        QMouseEvent ev(QEvent::MouseMove, p, p, w->mapToGlobal(p.toPoint()), Qt::NoButton, Qt::NoButton, Qt::NoModifier);
+        QCoreApplication::sendEvent(w, &ev);
+    }
+    void shot(const QString &name) { QProcess::execute("spectacle", {"-b", "-n", "-f", "-o", prefix + "-" + name + ".png"}); }
+    void run() {
+        auto after = [this](int ms, std::function<void()> f) { QTimer::singleShot(ms, this, f); };
+        reborn->togglePip(window);
+        after(2500, [=, this] {
+            QWindow *w = pipWin();
+            if (!w) { log << "PiP window not found"; finish(); return; }
+            // pointer wiggle over the PiP: overlay appears
+            for (int i = 0; i < 5; ++i) move(w, QPointF(w->width() / 2 + i * 7, w->height() / 2 + i * 3));
+            // the overlay also stays visible while paused: that shows it without relying on synthetic hover
+            { vlc_player_locker lock(player->getPlayer()); vlc_player_Pause(player->getPlayer()); }
+            after(1200, [=, this] {
+                shot("pip-default");
+                QStringList items;
+                if (auto *v = qobject_cast<QQuickWindow *>(w)) tree(v->contentItem(), 0, items);
+                log << "PiP window item tree (visible items only):" << items;
+                // now over the main window several times (the placeholder)
+                // medium, then minimum PiP size: what stays on screen when there is no room
+                w->resize(340, 191);
+                after(1200, [=, this] {
+                    shot("pip-medium");
+                    log << QStringLiteral("medium size reached: %1x%2").arg(w->width()).arg(w->height());
+                    w->resize(240, 135);
+                    after(1200, [=, this] {
+                        shot("pip-min");
+                        log << QStringLiteral("min size reached: %1x%2").arg(w->width()).arg(w->height());
+                        for (int i = 0; i < 40; ++i) move(window, QPointF(100 + i * 20, 200 + (i % 7) * 30));
+                        after(800, [=, this] { shot("main"); finish(); });
+                    });
+                });
+            });
+        });
+    }
+    void finish() { QFile f(prefix + ".txt"); if (f.open(QIODevice::WriteOnly | QIODevice::Text)) f.write(log.join('\n').toUtf8()); qApp->quit(); }
+    void ready(int tries = 0) {
+        window = qobject_cast<QQuickWindow *>(intf->p_mi ? intf->p_mi->intfMainWindow() : nullptr);
+        if (!window || !player->isSeekable() || !intf->p_mi->hasEmbededVideo()) {
+            if (tries < 200) QTimer::singleShot(250, this, [this, tries] { ready(tries + 1); }); else { log << "not ready"; finish(); }
+            return;
+        }
+        QTimer::singleShot(2500, this, [this] { run(); });
+    }
+public:
+    PipVisualTest(qt_intf_t *i, RebornController *r) : QObject(r), intf(i), player(i->p_mainPlayerController), reborn(r),
+        prefix(qEnvironmentVariable("VLC_REBORN_TEST_REPORT")) {
+        QTimer::singleShot(500, this, [this] { ready(); });
+        QTimer::singleShot(120000, this, [] { qApp->quit(); });
+    }
+};
diff --git a/reborn/tests/play_stats_test.hpp b/reborn/tests/play_stats_test.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..dc6b31cb8de10aa8bd7438d5d0d2b9dd095d6b47
--- /dev/null
+++ b/reborn/tests/play_stats_test.hpp
@@ -0,0 +1,31 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Opt-in check (VLC_REBORN_TEST_MODE=playstats, VLC_REBORN_TEST_REPORT=<prefix>): plays the media given on the command line for ~12 s and
+// writes decoder/vout statistics (decoded, displayed, late and lost pictures) and the process CPU use to <prefix>.txt.
+class PlayStatsTest : public QObject {
+    qt_intf_t *intf;
+    PlayerController *player;
+    QString prefix;
+    input_stats_t last{};
+    QElapsedTimer clock;
+    static double cpuSeconds() {
+        QFile f("/proc/self/stat"); if (!f.open(QIODevice::ReadOnly)) return 0;
+        const QList<QByteArray> p = f.readAll().split(' ');
+        return (p.value(13).toDouble() + p.value(14).toDouble()) / sysconf(_SC_CLK_TCK);
+    }
+    double cpu0 = 0;
+public:
+    PlayStatsTest(qt_intf_t *i, QObject *parent) : QObject(parent), intf(i), player(i->p_mainPlayerController), prefix(qEnvironmentVariable("VLC_REBORN_TEST_REPORT")) {
+        connect(player, &PlayerController::statisticsUpdated, this, [this](const input_stats_t &s) { last = s; });
+        QTimer::singleShot(2500, this, [this] { clock.start(); cpu0 = cpuSeconds(); });
+        QTimer::singleShot(14500, this, [this] {
+            const double secs = clock.elapsed() / 1000.0;
+            QFile f(prefix + ".txt");
+            if (f.open(QIODevice::WriteOnly | QIODevice::Text))
+                f.write(QStringLiteral("state=%1 position=%2 decoded_video=%3 displayed=%4 late=%5 lost=%6 | process CPU over %7 s: %8 %% of one core\n")
+                        .arg(int(player->getPlayingState())).arg(player->getPosition(), 0, 'f', 3).arg(last.i_decoded_video).arg(last.i_displayed_pictures)
+                        .arg(last.i_late_pictures).arg(last.i_lost_pictures).arg(secs, 0, 'f', 1).arg((cpuSeconds() - cpu0) / secs * 100, 0, 'f', 0).toUtf8());
+            std::thread([] { std::this_thread::sleep_for(std::chrono::seconds(10)); std::_Exit(4); }).detach();
+            qApp->quit();
+        });
+    }
+};
diff --git a/reborn/tests/popup_compare_test.hpp b/reborn/tests/popup_compare_test.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..c33f04913fe60eafff703a8a4beb68722087911e
--- /dev/null
+++ b/reborn/tests/popup_compare_test.hpp
@@ -0,0 +1,68 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Opt-in screenshots (VLC_REBORN_TEST_MODE=popups, VLC_REBORN_TEST_REPORT=<prefix>): the Playback Speed popup next to the
+// Volume Boost popup -> <prefix>-boost100.png and <prefix>-boost200.png. Run with QT_QPA_PLATFORM=offscreen.
+// The dummy audio output never reports a volume, so the boost level is forced on the popup/button items.
+class PopupCompareTest : public QObject {
+    qt_intf_t *intf;
+    PlayerController *player;
+    QQuickWindow *window = nullptr;
+    QString prefix;
+    static QQuickItem *walk(QQuickItem *i, const std::function<bool(QQuickItem *)> &pred) {
+        if (pred(i)) return i;
+        for (auto c : i->childItems()) if (auto f = walk(c, pred)) return f;
+        return nullptr;
+    }
+    QQuickItem *speedButton() { return walk(window->contentItem(), [](QQuickItem *i) { return i->property("description").toString() == "change playback speed"; }); }
+    QQuickItem *boostButton() { return walk(window->contentItem(), [](QQuickItem *i) { return i->objectName() == "rebornBoostButton"; }); }
+    static QQuickItem *popupItem(QQuickItem *button) { return button->property("popup").value<QObject *>()->property("contentItem").value<QQuickItem *>(); }
+    QImage grabPopup(QQuickItem *button) {
+        QQuickItem *content = popupItem(button);
+        const QPointF p = content->mapToScene(QPointF(0, 0));
+        const QRect r = QRectF(p.x() - 14, p.y() - 14, content->width() + 28, content->height() + 28).toRect();
+        return window->grabWindow().copy(r);
+    }
+    void run() {
+        auto after = [this](int ms, std::function<void()> f) { QTimer::singleShot(ms, this, f); };
+        QQuickItem *speed = speedButton(), *boost = boostButton();
+        if (!speed || !boost) { qApp->quit(); return; }
+        auto session = std::make_shared<std::function<void(int)>>();
+        *session = [=, this](int level) {
+            QMetaObject::invokeMethod(speed->property("popup").value<QObject *>(), "open");
+            after(600, [=, this] {
+                const QImage a = grabPopup(speed);
+                QMetaObject::invokeMethod(speed->property("popup").value<QObject *>(), "close");
+                after(400, [=, this] {
+                    boost->setProperty("checked", level > 100);
+                    QMetaObject::invokeMethod(boost->property("popup").value<QObject *>(), "open");
+                    after(400, [=, this] {
+                        popupItem(boost)->setProperty("currentValue", level);
+                        after(400, [=, this] {
+                            const QImage b = grabPopup(boost);
+                            QImage out(a.width() + b.width() + 20, qMax(a.height(), b.height()), QImage::Format_ARGB32);
+                            out.fill(QColor("#202020")); QPainter pr(&out); pr.drawImage(0, 0, a); pr.drawImage(a.width() + 20, 0, b); pr.end();
+                            out.scaled(out.size() * 2, Qt::KeepAspectRatio, Qt::FastTransformation).save(prefix + QStringLiteral("-boost%1.png").arg(level));
+                            QMetaObject::invokeMethod(boost->property("popup").value<QObject *>(), "close");
+                            after(400, [=, this] { if (level == 100) (*session)(200); else qApp->quit(); });
+                        });
+                    });
+                });
+            });
+        };
+        (*session)(100);
+    }
+    void ready(int tries = 0) {
+        window = qobject_cast<QQuickWindow *>(intf->p_mi ? intf->p_mi->intfMainWindow() : nullptr);
+        if (!window || !speedButton() || !boostButton() || !player->isSeekable()) {
+            if (tries < 80) QTimer::singleShot(250, this, [this, tries] { ready(tries + 1); }); else qApp->quit();
+            return;
+        }
+        window->resize(1700, 900);
+        QTimer::singleShot(1500, this, [this] { run(); });
+    }
+public:
+    PopupCompareTest(qt_intf_t *i, RebornController *r) : QObject(r), intf(i), player(i->p_mainPlayerController),
+        prefix(qEnvironmentVariable("VLC_REBORN_TEST_REPORT")) {
+        QTimer::singleShot(500, this, [this] { ready(); });
+        QTimer::singleShot(90000, this, [] { qApp->quit(); });
+    }
+};
diff --git a/reborn/tests/popup_stability_test.hpp b/reborn/tests/popup_stability_test.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..fdb48dfb2c6a36af5fb478051c42894a46680af8
--- /dev/null
+++ b/reborn/tests/popup_stability_test.hpp
@@ -0,0 +1,109 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Opt-in check (VLC_REBORN_TEST_MODE=popupstable, VLC_REBORN_TEST_REPORT=<prefix>, VLC_REBORN_TEST_WIDTH=<px>): opens the Volume
+// Boost and Playback Speed popups, moves the mouse over every row, waits past the control-bar auto-hide delay and checks that
+// the popup never moves and the control bar stays visible. Writes <prefix>-<popup>-{before,after}.png and <prefix>.txt.
+class PopupStabilityTest : public QObject {
+    qt_intf_t *intf;
+    PlayerController *player;
+    QQuickWindow *window = nullptr;
+    QString prefix;
+    QStringList log;
+    bool failed = false;
+    static QQuickItem *walk(QQuickItem *i, const std::function<bool(QQuickItem *)> &pred) {
+        if (pred(i)) return i;
+        for (auto c : i->childItems()) if (auto f = walk(c, pred)) return f;
+        return nullptr;
+    }
+    QQuickItem *boostButton() { return walk(window->contentItem(), [](QQuickItem *i) { return i->objectName() == "rebornBoostButton"; }); }
+    QQuickItem *speedButton() { return walk(window->contentItem(), [](QQuickItem *i) { return i->property("description").toString() == "change playback speed"; }); }
+    QQuickItem *controlBar() { return walk(window->contentItem(), [](QQuickItem *i) { return i->property("identifier").isValid() && i->metaObject()->indexOfSignal("requestLockUnlockAutoHide(bool)") >= 0; }); }
+    static QObject *popupOf(QQuickItem *b) { return b->property("popup").value<QObject *>(); }
+    static QQuickItem *contentOf(QQuickItem *b) { return popupOf(b)->property("contentItem").value<QQuickItem *>(); }
+    QPointF scenePos(QQuickItem *b) { return contentOf(b)->mapToScene(QPointF(0, 0)); }
+    void mouse(const QPointF &p) {
+        QMouseEvent ev(QEvent::MouseMove, p, p, window->mapToGlobal(p.toPoint()), Qt::NoButton, Qt::NoButton, Qt::NoModifier);
+        QCoreApplication::sendEvent(window, &ev);
+    }
+    QObject *fsm() { for (QObject *o : window->findChildren<QObject *>()) if (o->property("lockCount").isValid() && o->property("isVisible").isValid()) return o; return nullptr; }
+    QString fsmState() { QObject *f = fsm(); return f ? QStringLiteral("auto-hide lockCount=%1 toolbarVisible=%2").arg(f->property("lockCount").toInt()).arg(f->property("isVisible").toBool()) : QStringLiteral("auto-hide FSM not found"); }
+    QString barState() {
+        QQuickItem *bar = controlBar();
+        return bar ? QStringLiteral("state=%1 visible=%2 opacity=%3").arg(bar->property("state").toString()).arg(bar->isVisible()).arg(bar->opacity()) : QStringLiteral("control bar not found");
+    }
+    bool barHidden() { QQuickItem *bar = controlBar(); return bar && (bar->property("state").toString() == "hidden" || bar->opacity() < 0.5 || !bar->isVisible()); }
+    void shot(QQuickItem *b, const QString &name) {
+        QQuickItem *c = contentOf(b); const QPointF p = c->mapToScene(QPointF(0, 0));
+        const QRect r = QRectF(p.x() - 20, p.y() - 20, c->width() + 40, c->height() + 40).toRect().intersected(QRect(QPoint(0, 0), window->size()));
+        window->grabWindow().save(prefix + "-" + name + "-full.png");
+        window->grabWindow().copy(r).save(prefix + "-" + name + ".png");
+    }
+    void testPopup(const QString &name, std::function<QQuickItem *()> button, std::function<void()> next) {
+        auto after = [this](int ms, std::function<void()> f) { QTimer::singleShot(ms, this, f); };
+        QQuickItem *b = button();
+        if (!b) { log << name + ": button not found"; failed = true; next(); return; }
+        QMetaObject::invokeMethod(popupOf(b), "open");
+        after(700, [=, this] {
+            const QPointF start = scenePos(b);
+            QQuickItem *c = contentOf(b);
+            auto positions = std::make_shared<QList<QPointF>>(); positions->append(start);
+            { QQuickItem *ov = walk(window->contentItem(), [](QQuickItem *i) { return QByteArray(i->metaObject()->className()).contains("Overlay"); }); QPointF bo = b->mapToScene(QPointF(0,0)); log << QStringLiteral("debug: window %1x%2 overlay %3x%4 button at %5,%6 size %7x%8").arg(window->width()).arg(window->height()).arg(ov ? ov->width() : -1).arg(ov ? ov->height() : -1).arg(bo.x()).arg(bo.y()).arg(b->width()).arg(b->height()); }
+            log << QStringLiteral("%1 [window %2px]: popup opened at x=%3 y=%4 w=%5 h=%6, bar %7, %8").arg(name).arg(window->width()).arg(start.x()).arg(start.y()).arg(c->width()).arg(c->height()).arg(barState(), fsmState());
+            shot(b, name + "-before");
+            // hover over every row (and the gaps between them), top to bottom, then back up
+            auto steps = std::make_shared<QList<QPointF>>();
+            for (qreal y = 6; y < c->height() - 4; y += 12) steps->append(c->mapToScene(QPointF(c->width() / 2, y)));
+            for (qreal y = c->height() - 6; y > 4; y -= 12) steps->append(c->mapToScene(QPointF(c->width() / 2, y)));
+            auto move = std::make_shared<std::function<void(int)>>();
+            *move = [=, this](int i) {
+                if (i >= steps->size()) {
+                    const int wait = int(intf->p_mi->mouseHideTimeout()) + 3000;
+                    after(wait, [=, this] {
+                        positions->append(scenePos(b));
+                        qreal minx = 1e9, maxx = -1e9, miny = 1e9, maxy = -1e9;
+                        for (auto &p : *positions) { minx = qMin(minx, p.x()); maxx = qMax(maxx, p.x()); miny = qMin(miny, p.y()); maxy = qMax(maxy, p.y()); }
+                        const bool stable = maxx - minx < 0.5 && maxy - miny < 0.5;
+                        const bool open = popupOf(b)->property("visible").toBool();
+                        const bool barOk = !barHidden();
+                        log << QStringLiteral("%1: popup x range %2..%3, y range %4..%5 over %6 samples -> %7; popup still open: %8; bar after %9 ms: %10, %12 -> %11")
+                               .arg(name).arg(minx).arg(maxx).arg(miny).arg(maxy).arg(positions->size()).arg(stable ? "STABLE" : "MOVED").arg(open).arg(wait).arg(barState()).arg(barOk ? "VISIBLE" : "HIDDEN").arg(fsmState());
+                        QObject *f = fsm(); if (!f || f->property("lockCount").toInt() < 1 || !f->property("isVisible").toBool()) { failed = true; log << name + ": auto-hide NOT locked while the popup is open"; }
+                        if (!stable || !open || !barOk) failed = true;
+                        shot(b, name + "-after");
+                        QMetaObject::invokeMethod(popupOf(b), "close");
+                        after(500, next);
+                    });
+                    return;
+                }
+                // stress: shove the button sideways now and then, as a control bar relayout would do
+                if (i % 8 == 4) b->setX(b->x() + (i % 16 == 4 ? 70 : -70));
+                mouse(steps->at(i));
+                after(60, [=, this] { positions->append(scenePos(b)); (*move)(i + 1); });
+            };
+            (*move)(0);
+        });
+    }
+    void run() {
+        testPopup("boost", [this] { return boostButton(); }, [this] {
+            testPopup("speed", [this] { return speedButton(); }, [this] {
+                log << (failed ? "RESULT: FAIL" : "RESULT: PASS");
+                QFile f(prefix + ".txt"); if (f.open(QIODevice::WriteOnly | QIODevice::Text)) f.write(log.join('\n').toUtf8());
+                qApp->quit();
+            });
+        });
+    }
+    void ready(int tries = 0) {
+        window = qobject_cast<QQuickWindow *>(intf->p_mi ? intf->p_mi->intfMainWindow() : nullptr);
+        if (!window || !speedButton() || !boostButton() || !player->isSeekable()) {
+            if (tries < 80) QTimer::singleShot(250, this, [this, tries] { ready(tries + 1); }); else qApp->quit();
+            return;
+        }
+        window->resize(qEnvironmentVariableIntValue("VLC_REBORN_TEST_WIDTH") ? qEnvironmentVariableIntValue("VLC_REBORN_TEST_WIDTH") : 1700, 900);
+        QTimer::singleShot(2000, this, [this] { run(); });
+    }
+public:
+    PopupStabilityTest(qt_intf_t *i, RebornController *r) : QObject(r), intf(i), player(i->p_mainPlayerController),
+        prefix(qEnvironmentVariable("VLC_REBORN_TEST_REPORT")) {
+        QTimer::singleShot(500, this, [this] { ready(); });
+        QTimer::singleShot(150000, this, [] { qApp->quit(); });
+    }
+};
diff --git a/reborn/tests/qt_integration.cpp b/reborn/tests/qt_integration.cpp
