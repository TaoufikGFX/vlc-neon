+/* The core handles the jump hotkeys on its own (never through PlayerController::jumpBy()). Resolve the
+ * pressed key through the user's key mapping so the toolbar buttons can still flash for it. The key itself
+ * is forwarded to the core unchanged, so the jump is performed (and reported) exactly once. */
+static void notifyHotkeyJump(qt_intf_t *p_intf, int vlcKey)
+{
+    static const struct { const char *keyName; const char *sizeVar; int sign; } jumps[] = {
+        { "jump-extrashort", "extrashort-jump-size", -1 }, { "jump+extrashort", "extrashort-jump-size", 1 },
+        { "jump-short",      "short-jump-size",      -1 }, { "jump+short",      "short-jump-size",      1 },
+        { "jump-medium",     "medium-jump-size",     -1 }, { "jump+medium",     "medium-jump-size",     1 },
+        { "jump-long",       "long-jump-size",       -1 }, { "jump+long",       "long-jump-size",       1 },
+    };
+    PlayerController *player = p_intf->p_mainPlayerController;
+    if (vlcKey == 0 || !player || !player->isSeekable())
+        return;
+    for (const auto &jump : jumps)
+    {
+        uint_fast32_t *keys = nullptr;
+        const size_t count = vlc_actions_get_keycodes(p_intf, jump.keyName, false, &keys);
+        const bool match = std::find(keys, keys + count, static_cast<uint_fast32_t>(vlcKey)) != keys + count;
+        free(keys);
+        if (match)
+        {
+            emit player->jumped(jump.sign * int(var_InheritInteger(p_intf, jump.sizeVar)));
+            return;
+        }
+    }
+}
