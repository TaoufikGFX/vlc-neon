diff --git a/modules/gui/qt/player/reborn_ffthumb.cpp b/modules/gui/qt/player/reborn_ffthumb.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..5766c853bc4c2d949aeb194102a48224506a3d6f
--- /dev/null
+++ b/modules/gui/qt/player/reborn_ffthumb.cpp
@@ -0,0 +1,269 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "reborn_ffthumb.hpp"
+
+#ifndef NEON_FF_THUMBS
+// FFmpeg development files were not found at configure time: the controller keeps using the P0 VLC backend.
+struct NeonFFThumbnailer::Impl {};
+bool NeonFFThumbnailer::available() { return false; }
+NeonFFThumbnailer::NeonFFThumbnailer() {}
+NeonFFThumbnailer::~NeonFFThumbnailer() {}
+bool NeonFFThumbnailer::submit(const QByteArray &, const QByteArray &, qint64, int, Callback) { return false; }
+void NeonFFThumbnailer::cancel() {}
+void NeonFFThumbnailer::releaseDecoder() {}
+#else
+
+extern "C" {
+#include <libavcodec/avcodec.h>
+#include <libavformat/avformat.h>
+#include <libavutil/display.h>
+#include <libswscale/swscale.h>
+}
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <mutex>
+#include <thread>
+#ifdef __linux__
+#include <pthread.h>
+#include <sys/resource.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+#endif
+
+namespace {
+constexpr int kThumbWidth = 320;          // same output width as the P0 thumbnail
+constexpr int kDecoderThreads = 2;        // same software thread budget as P0 thumbnails
+constexpr auto kIdleRelease = std::chrono::seconds(15);
+using Clock = std::chrono::steady_clock;
+double msSince(Clock::time_point t) { return std::chrono::duration<double, std::milli>(Clock::now() - t).count(); }
+
+// Demuxer + software decoder + scaler, kept alive between requests. Touched only by the worker thread.
+struct Decoder {
+    AVFormatContext *fc = nullptr;
+    AVCodecContext *cc = nullptr;
+    AVStream *st = nullptr;
+    AVPacket *pkt = nullptr;
+    AVFrame *frame = nullptr;
+    SwsContext *sws = nullptr;
+    int stream = -1;
+    int64_t startTs = 0;                  // container start in stream time base; removed from reported times
+    int64_t curTs = AV_NOPTS_VALUE;       // timestamp of the last frame the decoder produced (valid GOP position)
+    QByteArray key;
+
+    bool isOpen() const { return fc != nullptr; }
+    void close() {
+        if (sws) sws_freeContext(sws);
+        av_frame_free(&frame);
+        av_packet_free(&pkt);
+        avcodec_free_context(&cc);
+        avformat_close_input(&fc);
+        *this = Decoder();
+    }
+    // 0 ok, 1 unsupported media (P0 handles it), -1 failure
+    int open(const QByteArray &path, const QByteArray &mediaKey) {
+        if (avformat_open_input(&fc, path.constData(), nullptr, nullptr) < 0) { fc = nullptr; return -1; }
+        // Containers we serve (mkv/mp4/...) carry codec parameters in their headers, so the extra
+        // packet reads of avformat_find_stream_info() are skipped to keep open cheap.
+        stream = av_find_best_stream(fc, AVMEDIA_TYPE_VIDEO, -1, -1, nullptr, 0);
+        if (stream < 0) { close(); return -1; }
+        st = fc->streams[stream];
+        if (st->disposition & AV_DISPOSITION_ATTACHED_PIC) { close(); return 1; }
+        // Rotation/flip metadata is applied by the P0 path; do not duplicate it here.
+        if (const AVPacketSideData *sd = av_packet_side_data_get(st->codecpar->coded_side_data,
+                                                                 st->codecpar->nb_coded_side_data,
+                                                                 AV_PKT_DATA_DISPLAYMATRIX)) {
+            if (sd->size >= 9 * sizeof(int32_t) && (av_display_rotation_get(reinterpret_cast<const int32_t *>(sd->data)) != 0.0)) {
+                close(); return 1;
+            }
+        }
+        for (unsigned i = 0; i < fc->nb_streams; ++i)
+            if (int(i) != stream) fc->streams[i]->discard = AVDISCARD_ALL;
+        const AVCodec *codec = avcodec_find_decoder(st->codecpar->codec_id);
+        if (!codec) { close(); return 1; }
+        cc = avcodec_alloc_context3(codec);
+        if (!cc || avcodec_parameters_to_context(cc, st->codecpar) < 0) { close(); return -1; }
+        cc->thread_count = kDecoderThreads;       // software only: no hw device is ever attached
+        cc->flags |= AV_CODEC_FLAG_OUTPUT_CORRUPT;
+        if (avcodec_open2(cc, codec, nullptr) < 0) { close(); return -1; }
+        pkt = av_packet_alloc(); frame = av_frame_alloc();
+        if (!pkt || !frame) { close(); return -1; }
+        startTs = fc->start_time != AV_NOPTS_VALUE ? av_rescale_q(fc->start_time, AV_TIME_BASE_Q, st->time_base) : 0;
+        key = mediaKey;
+        return 0;
+    }
+};
+} // namespace
+
+struct NeonFFThumbnailer::Impl {
+    struct Req { QByteArray path, key; qint64 target = 0; int timeoutMs = 0; Callback cb; quint64 id = 0; };
+    std::mutex mu;
+    std::condition_variable cv;
+    std::thread worker;
+    bool stop = false, hasReq = false, release = false;
+    Req req;
+    std::atomic<quint64> lastId { 0 }, cancelledUpTo { 0 };
+    Decoder dec;
+
+    ~Impl() {
+        { std::lock_guard<std::mutex> l(mu); stop = true; cancelledUpTo = lastId.load(); }
+        cv.notify_all();
+        if (worker.joinable()) worker.join();
+        dec.close();
+    }
+
+    void loop() {
+#ifdef __linux__
+        // Same policy as the P0 thumbnail executor: background priority so playback keeps its scheduling headroom.
+        pthread_setname_np(pthread_self(), "neon-ffthumb");
+        setpriority(PRIO_PROCESS, static_cast<id_t>(syscall(SYS_gettid)), 10);
+#endif
+        std::unique_lock<std::mutex> lock(mu);
+        for (;;) {
+            const bool woke = cv.wait_for(lock, kIdleRelease, [&] { return stop || hasReq || release; });
+            if (stop) return;
+            if (release || (!woke && !hasReq)) { release = false; dec.close(); if (!hasReq) continue; }
+            if (!hasReq) continue;
+            Req r = std::move(req); hasReq = false;
+            lock.unlock();
+            Result res = run(r);
+            if (r.cb) r.cb(res);
+            lock.lock();
+        }
+    }
+
+    bool cancelled(quint64 id) const { return id <= cancelledUpTo.load(std::memory_order_relaxed); }
+
+    Result run(const Req &r) {
+        Result res;
+        const auto t0 = Clock::now();
+        const auto deadline = t0 + std::chrono::milliseconds(r.timeoutMs);
+        if (cancelled(r.id)) { res.status = Status::Cancelled; return res; }
+        if (dec.isOpen() && dec.key != r.key) dec.close();
+        if (!dec.isOpen()) {
+            const int rc = dec.open(r.path, r.key);
+            if (rc != 0) { res.status = rc > 0 ? Status::Unsupported : Status::Failed; return res; }
+            res.opened = true;
+        }
+        res.openMs = msSince(t0);
+        Decode(r, res, deadline, t0);
+        res.totalMs = msSince(t0);
+        return res;
+    }
+
+    void Decode(const Req &r, Result &res, Clock::time_point deadline, Clock::time_point t0) {
+        Decoder &d = dec;
+        const AVRational tb = d.st->time_base;
+        const int64_t target = av_rescale_q(r.target, AVRational{1, 1000}, tb) + d.startTs;
+
+        // Continue in the current GOP when the target is ahead of the decoded position and the keyframe the
+        // demuxer would restart from is not newer than that position (no keyframe could be skipped to).
+        bool needSeek = true;
+        if (d.curTs != AV_NOPTS_VALUE && d.curTs < target) {
+            const AVIndexEntry *e = avformat_index_get_entry_from_timestamp(d.st, target, AVSEEK_FLAG_BACKWARD);
+            if (e && e->timestamp <= d.curTs) needSeek = false;
+        }
+        const auto tSeek = Clock::now();
+        if (needSeek) {
+            if (av_seek_frame(d.fc, d.stream, target, AVSEEK_FLAG_BACKWARD) < 0) {
+                d.close(); res.status = Status::Failed; return;   // reopen next time
+            }
+            avcodec_flush_buffers(d.cc);
+            d.curTs = AV_NOPTS_VALUE;
+            res.seeked = true;
+        }
+        res.seekMs = msSince(tSeek);
+
+        const auto tDecode = Clock::now();
+        bool got = false, eof = false;
+        while (!got && !eof) {
+            if (cancelled(r.id)) { res.status = Status::Cancelled; return; }
+            if (Clock::now() > deadline) { res.status = Status::Timeout; return; }
+            int rc = av_read_frame(d.fc, d.pkt);
+            if (rc < 0) { avcodec_send_packet(d.cc, nullptr); eof = true; }   // drain
+            else if (d.pkt->stream_index != d.stream) { av_packet_unref(d.pkt); continue; }
+            else { ++res.packets; avcodec_send_packet(d.cc, d.pkt); av_packet_unref(d.pkt); }
+            while (avcodec_receive_frame(d.cc, d.frame) >= 0) {
+                ++res.frames;
+                int64_t ts = d.frame->best_effort_timestamp;
+                if (ts == AV_NOPTS_VALUE) { av_frame_unref(d.frame); d.close(); res.status = Status::Unsupported; return; }
+                d.curTs = ts;
+                if (ts >= target) { got = true; break; }
+                av_frame_unref(d.frame);
+            }
+        }
+        res.decodeMs = msSince(tDecode);
+        if (!got) {
+            // End of stream before reaching the target: the decoder is drained, so force a seek+flush next time.
+            d.curTs = AV_NOPTS_VALUE;
+            res.status = Status::Failed; return;
+        }
+        if (eof) d.curTs = AV_NOPTS_VALUE;
+
+        const auto tScale = Clock::now();
+        AVRational sar = d.frame->sample_aspect_ratio;
+        if (sar.num <= 0 || sar.den <= 0) sar = d.st->sample_aspect_ratio;
+        if (sar.num <= 0 || sar.den <= 0) sar = AVRational{1, 1};
+        const int h = int(std::clamp<int64_t>(int64_t(kThumbWidth) * d.frame->height * sar.den
+                                                  / (int64_t(std::max(1, d.frame->width)) * sar.num), 1, 640));
+        d.sws = sws_getCachedContext(d.sws, d.frame->width, d.frame->height, AVPixelFormat(d.frame->format),
+                                     kThumbWidth, h, AV_PIX_FMT_RGBA, SWS_BILINEAR, nullptr, nullptr, nullptr);
+        if (d.sws) {
+            // swscale assumes BT.601 unless told otherwise. Use the stream's matrix, falling back to VLC's rule for
+            // untagged video (HD => BT.709), and treat untagged range as limited like VLC does.
+            const AVFrame *f = d.frame;
+            int cs = SWS_CS_DEFAULT;
+            switch (f->colorspace) {
+            case AVCOL_SPC_BT709: cs = SWS_CS_ITU709; break;
+            case AVCOL_SPC_FCC: cs = SWS_CS_FCC; break;
+            case AVCOL_SPC_BT470BG: case AVCOL_SPC_SMPTE170M: cs = SWS_CS_ITU601; break;
+            case AVCOL_SPC_SMPTE240M: cs = SWS_CS_SMPTE240M; break;
+            case AVCOL_SPC_BT2020_NCL: case AVCOL_SPC_BT2020_CL: cs = SWS_CS_BT2020; break;
+            default: cs = (f->width >= 1280 || f->height >= 576) ? SWS_CS_ITU709 : SWS_CS_ITU601; break;
+            }
+            const int srcFull = f->color_range == AVCOL_RANGE_JPEG;
+            sws_setColorspaceDetails(d.sws, sws_getCoefficients(cs), srcFull, sws_getCoefficients(SWS_CS_DEFAULT), 1,
+                                     0, 1 << 16, 1 << 16);
+        }
+        QImage image(kThumbWidth, h, QImage::Format_RGBA8888);
+        if (!d.sws || image.isNull()) { av_frame_unref(d.frame); res.status = Status::Failed; return; }
+        uint8_t *dst[4] = { image.bits(), nullptr, nullptr, nullptr };
+        int dstStride[4] = { int(image.bytesPerLine()), 0, 0, 0 };
+        sws_scale(d.sws, d.frame->data, d.frame->linesize, 0, d.frame->height, dst, dstStride);
+        res.actualMs = av_rescale_q(d.curTs - d.startTs, tb, AVRational{1, 1000});
+        av_frame_unref(d.frame);
+        res.image = std::move(image);
+        res.scaleMs = msSince(tScale);
+        res.status = Status::Ok;
+        (void) t0;
+    }
+};
+
+bool NeonFFThumbnailer::available() { return true; }
+NeonFFThumbnailer::NeonFFThumbnailer() : d(new Impl) {}
+NeonFFThumbnailer::~NeonFFThumbnailer() = default;
+
+bool NeonFFThumbnailer::submit(const QByteArray &path, const QByteArray &mediaKey, qint64 targetMs, int timeoutMs, Callback cb)
+{
+    std::lock_guard<std::mutex> l(d->mu);
+    if (d->stop || d->hasReq) return false;
+    if (!d->worker.joinable()) {
+        try { d->worker = std::thread([impl = d.get()] { impl->loop(); }); }
+        catch (...) { return false; }
+    }
+    d->req = { path, mediaKey, targetMs, timeoutMs, std::move(cb), ++d->lastId };
+    d->hasReq = true;
+    d->cv.notify_one();
+    return true;
+}
+
+void NeonFFThumbnailer::cancel() { d->cancelledUpTo.store(d->lastId.load()); }
+
+void NeonFFThumbnailer::releaseDecoder()
+{
+    std::lock_guard<std::mutex> l(d->mu);
+    d->release = true;
+    d->cancelledUpTo.store(d->lastId.load());
+    d->cv.notify_one();
+}
+#endif
