@@ -0,0 +1,39 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// P1: one retained software FFmpeg decoder for seekbar thumbnails. Independent of the playback decoder.
+#ifndef VLC_REBORN_FFTHUMB_HPP
+#define VLC_REBORN_FFTHUMB_HPP
+
+#include <QByteArray>
+#include <QImage>
+#include <QtGlobal>
+#include <functional>
+#include <memory>
+
+class NeonFFThumbnailer
+{
+public:
+    enum class Status { Ok, Failed, Timeout, Cancelled, Unsupported };
+    struct Result {
+        Status status = Status::Failed;
+        QImage image;                 // owned 320px RGBA8888
+        qint64 actualMs = -1;         // frame time on the media timeline (container start removed)
+        int frames = 0, packets = 0;  // decoded / demuxed for this request
+        bool seeked = false, opened = false;
+        double openMs = 0, seekMs = 0, decodeMs = 0, scaleMs = 0, totalMs = 0;
+    };
+    using Callback = std::function<void(const Result &)>;   // runs on the worker thread
+
+    static bool available();
+    NeonFFThumbnailer();
+    ~NeonFFThumbnailer();   // joins the worker; no callback runs afterwards
+
+    // One request at a time (the controller serialises). `mediaKey` identifies the file contents so a replaced file reopens.
+    bool submit(const QByteArray &path, const QByteArray &mediaKey, qint64 targetMs, int timeoutMs, Callback cb);
+    void cancel();            // abort the running request (reported as Cancelled); decoder state stays valid
+    void releaseDecoder();    // drop demuxer/decoder/scaler (media change); safe from any thread
+
+private:
+    struct Impl;
+    std::unique_ptr<Impl> d;
+};
+#endif
