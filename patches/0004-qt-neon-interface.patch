+void RebornController::saveMedia()
+{
+    if (m_key.isEmpty() || !m_loaded || m_historySuppressed) return;
+    auto settings = m_intf->mainSettings;
+    settings->beginGroup(QStringLiteral("Reborn/history/") + m_key);
+    settings->setValue(QStringLiteral("path"), m_path);
+    settings->setValue(QStringLiteral("position"), m_savedTime);
+    settings->setValue(QStringLiteral("duration"), m_savedDuration);
+    settings->setValue(QStringLiteral("lastPlayed"), QDateTime::currentMSecsSinceEpoch());
+    if (m_memory) {
+        settings->setValue(QStringLiteral("rate"), m_savedRate);
+        settings->setValue(QStringLiteral("volume"), m_savedVolume);
+        settings->setValue(QStringLiteral("audioDelay"), m_savedAudioDelay);
+        settings->setValue(QStringLiteral("subtitleDelay"), m_savedSubtitleDelay);
+        settings->setValue(QStringLiteral("audioTracks"), m_savedAudioTracks);
+        settings->setValue(QStringLiteral("subtitleTracks"), m_savedSubtitleTracks);
+    }
+    settings->endGroup();
+    const auto entries = recent();
+    for (int i = 100; i < entries.size(); ++i)
+        settings->remove(QStringLiteral("Reborn/history/") + entries[i].toMap().value(QStringLiteral("key")).toString());
+    emit recentChanged();
+}
+
+void RebornController::loadMedia()
+{
+    m_loaded = true;
+    if (m_key.isEmpty()) return;
+    auto settings = m_intf->mainSettings;
+    settings->beginGroup(QStringLiteral("Reborn/history/") + m_key);
+    m_resume = settings->value(QStringLiteral("position"), 0).toLongLong();
+    const auto duration = settings->value(QStringLiteral("duration"), 0).toLongLong();
+    if (m_resume < 5000 || (duration > 0 && m_resume > duration - 5000)) m_resume = 0;
+    if (m_resume > 0) m_resumeExpiry.start(15000);   // the offer is for the moment the media opens, not for later view reloads
+    if (m_memory) {
+        m_player->setRate(settings->value(QStringLiteral("rate"), 1).toFloat());
+        const float volume = settings->value(QStringLiteral("volume"), m_player->getVolume()).toFloat();
+        if (volume > 1) setBoost(qRound(volume * 100));
+        else m_player->setVolume(volume);
+        m_player->setAudioDelayMS(settings->value(QStringLiteral("audioDelay"), 0).toInt());
+        m_player->setSubtitleDelayMS(settings->value(QStringLiteral("subtitleDelay"), 0).toInt());
+        vlc_player_locker lock {m_player->getPlayer()};
+        if (settings->contains(QStringLiteral("audioTracks")))
+            vlc_player_SelectTracksByStringIds(m_player->getPlayer(), AUDIO_ES,
+                settings->value(QStringLiteral("audioTracks")).toByteArray().constData());
+        if (settings->contains(QStringLiteral("subtitleTracks")))
+            vlc_player_SelectTracksByStringIds(m_player->getPlayer(), SPU_ES,
+                settings->value(QStringLiteral("subtitleTracks")).toByteArray().constData());
+    }
+    settings->endGroup();
+    emit resumeChanged();
+}
