+    jumpBy( -var_InheritInteger( d->p_intf, "short-jump-size" ) );
+}
+
+/* Relative seek by `seconds` (negative = backward), clamped to [0, duration]. */
+void PlayerController::jumpBy(int seconds)
+{
+    Q_D(PlayerController);
+    if( !jumpByLocked( d, seconds ) )
+        return;
+    /* Emitted after the player lock is released: QML listeners (button flash) run synchronously. */
+    emit jumped( seconds );
+}
+
+bool PlayerController::jumpByLocked( PlayerControllerPrivate *d, int seconds )
+{
     vlc_player_locker lock{ d->m_player };
     if( !d->isCurrentItemSynced() )
-        return;
-    vlc_player_JumpTime( d->m_player, vlc_tick_from_sec( -i_interval ) );
+        return false;
+
+    /* Use the time/length tracked for the seek bar: vlc_player_GetTime() reports VLC_TICK_INVALID (== 0)
+     * while no clock point is available (e.g. paused), which is indistinguishable from the start of media. */
+    if( !d->m_time.valid() )
+    {
+        /* Position unknown: let the player resolve the jump itself. */
+        vlc_player_JumpTime( d->m_player, vlc_tick_from_sec( seconds ) );
+        return true;
+    }
+
+    vlc_tick_t target = d->m_time.toVLCTick() + vlc_tick_from_sec( seconds );
+    const vlc_tick_t length = d->m_length.valid() ? d->m_length.toVLCTick() : 0;
+    if( length > 0 && target > length )
+        target = length;
+    if( target < 0 )
+        target = 0;
+    msg_Dbg( d->p_intf, "jumpBy %d s: %lld ms -> %lld ms (duration %lld ms)", seconds,
+             (long long) MS_FROM_VLC_TICK( d->m_time.toVLCTick() ), (long long) MS_FROM_VLC_TICK( target ),
+             (long long) MS_FROM_VLC_TICK( length ) );
+    vlc_player_SetTime( d->m_player, target );
+    return true;
 }
 
 void PlayerController::jumpTime(VLCTime i_time)
