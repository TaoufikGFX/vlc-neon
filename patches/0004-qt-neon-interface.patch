+QVariantList RebornController::recent() const
+{
+    QVariantList result;
+    auto settings = m_intf->mainSettings;
+    settings->beginGroup(QStringLiteral("Reborn/history"));
+    for (const auto &key : settings->childGroups()) {
+        settings->beginGroup(key);
+        QVariantMap entry;
+        entry.insert(QStringLiteral("key"), key);
+        for (const auto &field : settings->childKeys()) entry.insert(field, settings->value(field));
+        entry.insert(QStringLiteral("name"), QFileInfo(entry.value(QStringLiteral("path")).toString()).fileName());
+        settings->endGroup();
+        result.append(entry);
+    }
+    settings->endGroup();
+    std::sort(result.begin(), result.end(), [](const QVariant &a, const QVariant &b) {
+        return a.toMap().value(QStringLiteral("lastPlayed")).toLongLong() > b.toMap().value(QStringLiteral("lastPlayed")).toLongLong();
+    });
+    return result;
+}
