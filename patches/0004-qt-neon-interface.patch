@@ -846,6 +909,27 @@ bool ControlbarProfileModel::reload()
 
     m_settings->endGroup();
 
+    if (migrateVideoInfo || migrateSkip3)
+    {
+        // Only record a migration as done once the upgraded toolbar has really been written; otherwise the next
+        // start retries instead of leaving the user with the flag set and the buttons missing.
+        bool persisted = true;
+        if (migrated)
+        {
+            save(false);
+            m_settings->sync();
+            persisted = m_settings->status() == QSettings::NoError;
+        }
+        if (persisted)
+        {
+            if (migrateVideoInfo)
+                m_settings->setValue(kVideoInfoMigrated, true);
+            if (migrateSkip3)
+                m_settings->setValue(kSkip3Migrated, true);
+            m_settings->sync();
+        }
+    }
+
     return true;
 }
 
