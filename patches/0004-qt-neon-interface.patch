+
+            if (migrateSkip3 && identifier == int(PlayerControlbarModel::Videoplayer))
+            {
+                for (auto &list : modelData)
+                {
+                    const int back = list.indexOf(int(ControlListModel::SKIP_BACK_BUTTON));
+                    if (back >= 0 && !list.contains(int(ControlListModel::SKIP_BACK_3_BUTTON)))
+                    {
