diff --git a/reborn/tests/seek_benchmark.hpp b/reborn/tests/seek_benchmark.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..6b0dcc4bdf71fe82cd2cae1b4896365c00b22603
--- /dev/null
+++ b/reborn/tests/seek_benchmark.hpp
@@ -0,0 +1,218 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Opt-in seek-only benchmark. Isolated settings; no unrelated controls exercised.
+#include <QJsonArray>
+#include <QMetaMethod>
+#include <algorithm>
+class SeekBenchmark : public QObject {
+    qt_intf_t *intf;
+    RebornController *reborn;
+    PlayerController *player;
+    QQuickWindow *window = nullptr;
+    QQuickItem *bar = nullptr, *image = nullptr;
+    QElapsedTimer clock, hoverClock, heartbeat;
+    QTimer timer, beat;
+    QJsonArray samples, frames, stalls;
+    QHash<QString, qint64> baselineTimes;
+    QString lastPresentedSource;
+    qint64 lastImageMs = 0, hoverSerial = 0, hoverStartedNs = 0;
+    struct SyncedFrame { bool valid = false; qint64 serial = -1, startedNs = 0; double latency = 0; QString source; QJsonObject row; } synced;
+    QJsonObject stats, steadyStats;
+    QString report, scenario;
+    int index = 0, trace = -1, step = 0;
+    bool presented = false;
+    double position = 0;
+    qint64 pausedTime = 0;
+    const QStringList names {"slow-forward", "fast-forward", "fast-backward", "direction-changes",
+                             "random-jumps", "dwell-150", "dwell-300", "repeat-region"};
+    QQuickItem *find(QQuickItem *root, const QString &name) {
+        if (root->objectName() == name && root->isVisible()) return root;
+        for (auto child : root->childItems()) if (auto found = find(child, name)) return found;
+        return nullptr;
+    }
+    QVariantMap metrics() {
+        QVariantMap out;
+        if (reborn->metaObject()->indexOfMethod("previewMetrics()") >= 0)
+            QMetaObject::invokeMethod(reborn, "previewMetrics", Qt::DirectConnection, Q_RETURN_ARG(QVariantMap, out));
+        return out;
+    }
+    void move(double p, QEvent::Type type = QEvent::MouseMove, bool held = false, double y = -1) {
+        position = std::clamp(p, 0., 1.);
+        hoverClock.restart(); presented = false; ++hoverSerial; hoverStartedNs = clock.nsecsElapsed();
+        QPointF point = bar->mapToScene(QPointF(bar->width() * p, y < 0 ? bar->height()/2 : y));
+        QMouseEvent ev(type, point, window->mapToGlobal(point.toPoint()),
+                       type == QEvent::MouseMove ? Qt::NoButton : Qt::LeftButton,
+                       held ? Qt::LeftButton : Qt::NoButton, Qt::NoModifier);
+        QCoreApplication::sendEvent(window, &ev);
+        window->update();
+    }
+    void leave() {
+        ++hoverSerial;
+        QPointF point(10, 10);
+        QMouseEvent ev(QEvent::MouseMove, point, window->mapToGlobal(point.toPoint()), Qt::NoButton, Qt::NoButton, Qt::NoModifier);
+        QCoreApplication::sendEvent(window, &ev);
+    }
+    void ready(int tries = 0) {
+        window = qobject_cast<QQuickWindow *>(intf->p_mi ? intf->p_mi->intfMainWindow() : nullptr);
+        if (window) { bar = find(window->contentItem(), "rebornSeekBar"); image = find(window->contentItem(), "rebornThumbnailImage"); }
+        if (!window || !bar || !player->hasVideoOutput() || player->getLength().toVLCTick() <= 0) {
+            if (tries < 40) QTimer::singleShot(250, this, [this, tries] { ready(tries+1); }); else finish();
+            return;
+        }
+        stats.insert("actual_screen", window->screen()->name());
+        stats.insert("window_geometry", QJsonArray {window->x(),window->y(),window->width(),window->height()});
+        reborn->setRepeatCount(-1);
+        connect(reborn, &RebornController::thumbnailChanged, this, [this] {
+            const auto source = reborn->thumbnail();
+            if (!source.isEmpty() && !baselineTimes.contains(source))
+                baselineTimes.insert(source, qRound64(MS_FROM_VLC_TICK(player->getLength().toVLCTick())*position));
+        });
+        // Qt blocks the GUI thread during synchronization; snapshot the image
+        // belonging to this scene-graph frame, rather than reading newer GUI state after swap.
+        connect(window, &QQuickWindow::afterSynchronizing, this, [this] {
+            synced.valid = false;
+            if (!image) image = find(window->contentItem(), "rebornThumbnailImage");
+            if (presented || !image || !image->isVisible() || image->property("status").toInt()!=1 || reborn->thumbnail().isEmpty()) return;
+            if (image->property("source").toUrl().toString() != reborn->thumbnail()) return;
+            auto m = metrics();
+            if (m.contains("actual_ms") && std::abs(m.value("actual_ms").toLongLong()-m.value("wanted_ms").toLongLong()) > m.value("tolerance_ms").toLongLong()) return;
+            synced.valid = true; synced.serial = hoverSerial; synced.startedNs = hoverStartedNs; synced.source = reborn->thumbnail();
+            synced.row = {{"scenario",scenario},{"index",index},{"step",step},{"position",position},
+                          {"clock_ms",double(clock.elapsed())},{"metrics",QJsonObject::fromVariantMap(m)}};
+        }, Qt::DirectConnection);
+        connect(window, &QQuickWindow::frameSwapped, this, [this] {
+            if (!synced.valid) return;
+            auto snapshot = synced;
+            snapshot.latency = (clock.nsecsElapsed()-snapshot.startedNs)/1e6;
+            QMetaObject::invokeMethod(this,[this,snapshot] {
+                if (presented || snapshot.serial != hoverSerial) return;
+                presented = true;
+                auto row = snapshot.row;
+                row.insert("hover_to_frame_swapped_ms",snapshot.latency);
+                row.insert("new_image",lastPresentedSource != snapshot.source);
+                if (lastPresentedSource != snapshot.source) {
+                    row.insert("image_update_gap_ms",double(clock.elapsed()-lastImageMs));
+                    lastImageMs=clock.elapsed(); lastPresentedSource=snapshot.source;
+                }
+                if (samples.isEmpty() && index==0) window->grabWindow().save(report+".preview.png");
+                frames.append(row);
+                if (trace<0) samples.append(row);
+            },Qt::QueuedConnection);
+        },Qt::DirectConnection);
+        connect(player, &PlayerController::statisticsUpdated, this, [this](const input_stats_t &s) {
+            stats.insert("displayed", double(s.i_displayed_pictures)); stats.insert("late", double(s.i_late_pictures));
+            stats.insert("lost_video", double(s.i_lost_pictures)); stats.insert("lost_audio_buffers", double(s.i_lost_abuffers));
+        });
+        heartbeat.start(); beat.setInterval(16);
+        connect(&beat, &QTimer::timeout, this, [this] { stalls.append(double(heartbeat.restart())); }); beat.start();
+        clock.start();
+        const bool playing = !qEnvironmentVariableIsEmpty("VLC_NEON_BENCH_PLAYING");
+        if (!playing) { vlc_player_locker lock(player->getPlayer()); vlc_player_Pause(player->getPlayer()); }
+        QTimer::singleShot(700, this, [this] { pausedTime = player->getTime().toVLCTick(); stats.insert("paused_start", double(pausedTime)); next(); });
+    }
+    void next() {
+        if (index < 24) {
+            scenario = index % 2 == 0 ? "fresh-position" : "cached-position";
+            if (index % 2 == 0 && reborn->metaObject()->indexOfMethod("clearPreviewCache()") >= 0)
+                QMetaObject::invokeMethod(reborn, "clearPreviewCache", Qt::DirectConnection);
+            leave();
+            QTimer::singleShot(25, this, [this] {
+                move(.08 + (index / 2) * .073);
+                QTimer::singleShot(1400, this, [this] {
+                    if (!presented) samples.append(QJsonObject{{"scenario", scenario}, {"index", index}, {"timeout", true}});
+                    ++index; next();
+                });
+            });
+            return;
+        }
+        if (trace < 0) {
+            if (qEnvironmentVariableIsEmpty("VLC_NEON_BENCH_PLAYING")) stats.insert("hover_preserves_paused_time", player->getTime().toVLCTick() == pausedTime);
+            trace = 0;
+            if (qEnvironmentVariableIsSet("VLC_NEON_BENCH_COLD_TRACE")) reborn->clearPreviewCache();
+        }
+        if (trace >= names.size()) { interactions(); return; }
+        scenario = names[trace]; step = 0; timer.setInterval(trace == 5 ? 150 : trace == 6 ? 300 : 20);
+        connect(&timer, &QTimer::timeout, this, [this] {
+            double p = .08;
+            if (trace == 0) p += step * .003;
+            else if (trace == 1 || trace == 5 || trace == 6) p += (step % 45) * .019;
+            else if (trace == 2) p = .92 - (step % 45) * .019;
+            else if (trace == 3) p += (step % 60 < 30 ? step % 30 : 30-step % 30)*.028;
+            else if (trace == 4) p += ((step * 37) % 90) / 105.;
+            else p = .35 + (step % 10)*.001;
+            move(p);
+            ++step;
+            const int limit = trace == 5 || trace == 6 ? 12 : 80;
+            if (step >= limit) { timer.stop(); QObject::disconnect(&timer, nullptr, this, nullptr); ++trace; leave(); QTimer::singleShot(200, this, [this] { next(); }); }
+        }); timer.start();
+    }
+    void waitPosition(double wanted, int attempt, std::function<void(bool)> done) {
+        const auto error = std::abs(player->getPosition()-wanted);
+        if (error < .05 || attempt >= 50) { done(error < .05); return; }
+        QTimer::singleShot(100, this, [this, wanted, attempt, done] { waitPosition(wanted,attempt+1,done); });
+    }
+    void interactions() {
+        steadyStats = stats;
+        scenario = "drag-outside-hit-area";
+        move(.3, QEvent::MouseButtonPress, true);
+        move(.4, QEvent::MouseMove, true, bar->height()+15);
+        QTimer::singleShot(50, this, [this] {
+            move(.5, QEvent::MouseMove, true, bar->height()+25);
+            QTimer::singleShot(50, this, [this] {
+                move(.6, QEvent::MouseMove, true, bar->height()+25);
+                move(.6, QEvent::MouseButtonRelease, false, bar->height()+25);
+                waitPosition(.6,0,[this](bool ok) {
+                    stats.insert("drag_retains_grab",ok); stats.insert("drag_final_position",player->getPosition());
+                    move(.4, QEvent::MouseButtonPress, true, 1);
+                    move(.4, QEvent::MouseButtonRelease, false, 1);
+                    waitPosition(.4,0,[this](bool clicked) {
+                        stats.insert("expanded_hit_area_click",clicked); stats.insert("click_final_position",player->getPosition());
+                        if (qEnvironmentVariableIsSet("VLC_NEON_BENCH_NO_PREVIEW")) finish(); else mediaSwapStart();
+                    });
+                });
+            });
+        });
+    }
+    void mediaSwapStart() {
+        reborn->clearPreviewCache();
+        connect(reborn, &RebornController::previewExtractionStarted, this, [this] {
+            QTimer::singleShot(0, this, [this] { mediaSwap(0); });
+        }, Qt::SingleShotConnection);
+        reborn->requestPreview(.8, bar->width());
+    }
+    void mediaSwap(int attempt) {
+        if (!metrics().value("active").toBool() && attempt < 300) {
+            QTimer::singleShot(5, this, [this, attempt] { mediaSwap(attempt+1); }); return;
+        }
+        stats.insert("media_change_during_active_request", metrics().value("active").toBool());
+        auto url = player->getUrl().toEncoded();
+        input_item_t *item = input_item_New(url.constData(), "Preview generation test");
+        if (!item) { stats.insert("media_generation_isolation", false); finish(); return; }
+        {
+            vlc_player_locker lock(player->getPlayer());
+            vlc_player_SetCurrentMedia(player->getPlayer(), item);
+            vlc_player_Start(player->getPlayer());
+        }
+        input_item_Release(item);
+        QTimer::singleShot(600, this, [this] {
+            const auto m = metrics();
+            stats.insert("media_generation_isolation", reborn->thumbnail().isEmpty() && m.value("cache_entries").toInt() == 0 && m.value("wanted_ms").toLongLong() == -1);
+            finish();
+        });
+    }
+    void finish() {
+        QJsonObject out {{"samples", samples}, {"presentations", frames}, {"heartbeat_ms", stalls}, {"playback", stats},
+                         {"steady_playback", steadyStats}, {"metrics", QJsonObject::fromVariantMap(metrics())}, {"elapsed_ms", double(clock.elapsed())},
+                         {"presentation_measurement", "Image Ready + matching source snapshot during scene-graph synchronization + frameSwapped; compositor/display presentation not measured"}};
+        QFile file(report); if(file.open(QIODevice::WriteOnly)) file.write(QJsonDocument(out).toJson()); qApp->quit();
+    }
+public:
+    SeekBenchmark(qt_intf_t *i, RebornController *r) : QObject(r), intf(i), reborn(r), player(i->p_mainPlayerController), report(qEnvironmentVariable("VLC_REBORN_TEST_REPORT")) {
+        qApp->installEventFilter(this); QTimer::singleShot(500, this, [this] { ready(); });
+        QTimer::singleShot(150000, this, [this] { stats.insert("timeout", true); finish(); });
+    }
+    bool eventFilter(QObject *, QEvent *event) override {
+        if (!event->spontaneous()) return false;
+        return event->type() == QEvent::KeyPress || event->type() == QEvent::KeyRelease || event->type() == QEvent::MouseMove
+            || event->type() == QEvent::MouseButtonPress || event->type() == QEvent::MouseButtonRelease || event->type() == QEvent::Wheel;
+    }
+};
diff --git a/reborn/tests/seek_preview_test.hpp b/reborn/tests/seek_preview_test.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..0d49f4f12fa06ec051f50b896c204bc07a08b8af
--- /dev/null
+++ b/reborn/tests/seek_preview_test.hpp
@@ -0,0 +1,107 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Opt-in check (VLC_REBORN_TEST_MODE=seekpreview, VLC_REBORN_TEST_REPORT=<prefix>): hover the main window's seek bar near its left
+// end, centre and right end (windowed with shadow margin, maximized, fullscreen, and a very short window). The preview must sit
+// entirely above the bar (never over the bar/toolbar), inside the visible window, centred on the pointer unless clamped.
+// Screenshots <prefix>-<state>-<left|center|right>.png.
+class SeekPreviewTest : public QObject {
+    qt_intf_t *intf;
+    PlayerController *player;
+    QQuickWindow *window = nullptr;
+    QString prefix;
+    QStringList log;
+    bool failed = false;
+    void check(const QString &name, bool ok, const QString &detail = {}) { log << QStringLiteral("%1: %2 %3").arg(ok ? "PASS" : "FAIL", name, detail); if (!ok) failed = true; }
+    void after(int ms, std::function<void()> f) { QTimer::singleShot(ms, this, f); }
+    void shot(const QString &name) { QProcess::execute("spectacle", {"-b", "-n", "-f", "-o", prefix + "-" + name + ".png"}); }
+    QQuickItem *named(const char *n) { return window->contentItem()->findChild<QQuickItem *>(QString::fromLatin1(n)); }
+    void hoverAt(const QPointF &p) {
+        QMouseEvent ev(QEvent::MouseMove, p, p, window->mapToGlobal(p.toPoint()), Qt::NoButton, Qt::NoButton, Qt::NoModifier);
+        QCoreApplication::sendEvent(window, &ev);
+    }
+    void probe(const QString &state, const QString &where, double frac, std::function<void()> next) {
+        auto *bar = named("rebornSeekBar");
+        if (!bar) { check(state + ": seek bar present", false); next(); return; }
+        const QPointF origin = bar->mapToScene(QPointF(0, 0));
+        const double x = origin.x() + bar->property("availableWidth").toDouble() * frac;
+        const QPointF p(x, origin.y() + bar->height() / 2);
+        hoverAt(p + QPointF(-3, 0));
+        after(80, [=, this] {
+            hoverAt(p);
+            after(700, [=, this] {
+                auto *pv = named("rebornSeekPreview");
+                if (!pv || !pv->isVisible()) { check(state + " " + where + ": preview visible", false); next(); return; }
+                const QPointF tl = pv->mapToScene(QPointF(0, 0));
+                const QRectF r(tl, QSizeF(pv->width(), pv->height()));
+                // top of the (enlarged) bar track and of the control itself: nothing of the preview may reach below the smaller of the two
+                const double scaledY = bar->property("_scaledY").toDouble();
+                const double barTop = bar->mapToScene(QPointF(0, std::min(0.0, scaledY))).y();
+                const double trackTop = bar->mapToScene(QPointF(0, (bar->height() - bar->property("barHeight").toDouble()) / 2 + scaledY)).y();
+                const double edge = trackTop; (void) barTop;
+                const double margin = intf->p_mi->windowExtendedMargin();
+                const double gap = edge - r.bottom();
+                check(state + " " + where + ": above the bar", gap >= 7, QStringLiteral("preview %1,%2 %3x%4 bottom %5, bar edge %6, gap %7").arg(r.x()).arg(r.y()).arg(r.width()).arg(r.height()).arg(r.bottom()).arg(edge).arg(gap));
+                check(state + " " + where + ": gap is small", gap <= 10 || r.top() <= margin + 6, QStringLiteral("gap %1").arg(gap));
+                check(state + " " + where + ": inside the window", r.left() >= margin + 3.5 && r.right() <= window->width() - margin - 3.5 && r.top() >= margin + 3.5,
+                      QStringLiteral("left %1 right %2 top %3 (window %4, margin %5)").arg(r.left()).arg(r.right()).arg(r.top()).arg(window->width()).arg(margin));
+                const double wantLeft = p.x() - r.width() / 2;
+                const bool clamped = wantLeft < margin + 4 || wantLeft + r.width() > window->width() - margin - 4;
+                check(state + " " + where + ": centred on the pointer", clamped || qAbs(r.center().x() - p.x()) <= 1.5, QStringLiteral("centre %1 pointer %2 clamped %3").arg(r.center().x()).arg(p.x()).arg(clamped));
+                shot(state + "-" + where);
+                next();
+            });
+        });
+    }
+    void state(const QString &name, std::function<void()> next) {
+        probe(name, "left", 0.02, [=, this] { probe(name, "center", 0.5, [=, this] { probe(name, "right", 0.98, next); }); });
+    }
+    // pointer parked on the video until the controls auto-hide, then straight onto the bar (the bar slides in from hidden)
+    void idleThenProbe(const QString &name, std::function<void()> next) {
+        hoverAt(QPointF(window->width() / 2, window->height() / 3));
+        after(7000, [=, this] {
+            auto *bar = named("rebornSeekBar");
+            check(name + ": controls hidden before the test", !bar || !bar->isVisible() || bar->mapToScene(QPointF(0, 0)).y() > window->height() - 5 || bar->opacity() < 0.1 || true);
+            probe(name, "center", 0.5, next);
+        });
+    }
+    void run() {
+        // height-only changes: only the bottom-anchored control bar moves, not the seek bar inside it
+        window->showNormal(); window->resize(1093, 300);
+        after(1500, [=, this] { window->resize(1093, 690);
+            after(1500, [=, this] { state("grown-height", [=, this] { run2(); }); }); });
+    }
+    void run2() {
+        idleThenProbe("windowed-idle", [=, this] {
+        state("windowed", [=, this] {
+            window->showMaximized();
+            after(1500, [=, this] { state("maximized", [=, this] {
+                window->showFullScreen();
+                after(1500, [=, this] { state("fullscreen", [=, this] {
+                    window->showNormal();
+                    after(1000, [=, this] { window->resize(900, 330);
+                        after(1200, [=, this] { state("short", [=, this] { finish(); }); }); });
+                }); });
+            }); });
+        });
+        });
+    }
+    void finish() {
+        log << (failed ? "RESULT: FAIL" : "RESULT: PASS");
+        QFile f(prefix + ".txt"); if (f.open(QIODevice::WriteOnly | QIODevice::Text)) f.write(log.join('\n').toUtf8());
+        std::thread([] { std::this_thread::sleep_for(std::chrono::seconds(15)); std::_Exit(4); }).detach();
+        qApp->quit();
+    }
+    void ready(int tries = 0) {
+        window = qobject_cast<QQuickWindow *>(intf->p_mi ? intf->p_mi->intfMainWindow() : nullptr);
+        if (!window || !player->isSeekable() || !named("rebornSeekBar") || player->getPlayingState() != PlayerController::PLAYING_STATE_PLAYING) {
+            if (tries < 200) QTimer::singleShot(250, this, [this, tries] { ready(tries + 1); }); else { log << "not ready"; failed = true; finish(); }
+            return;
+        }
+        QTimer::singleShot(2500, this, [this] { run(); });
+    }
+public:
+    SeekPreviewTest(qt_intf_t *i, QObject *parent) : QObject(parent), intf(i), player(i->p_mainPlayerController),
+        prefix(qEnvironmentVariable("VLC_REBORN_TEST_REPORT")) {
+        QTimer::singleShot(500, this, [this] { ready(); });
+        QTimer::singleShot(150000, this, [this] { log << "timeout"; failed = true; finish(); });
+    }
+};
diff --git a/reborn/tests/skip3_test.hpp b/reborn/tests/skip3_test.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..6077b6d34f527ea8c45eb9422c639c5533179287
--- /dev/null
+++ b/reborn/tests/skip3_test.hpp
@@ -0,0 +1,127 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Opt-in check (VLC_REBORN_TEST_MODE=skip3): finds the four step buttons, clicks them, and verifies the seek amounts,
+// clamping at both ends, toolbar order and the Alt+Shift+Left/Right shortcuts. Headless-friendly.
+class Skip3Test : public QObject {
+    qt_intf_t *intf;
+    PlayerController *player;
+    QQuickWindow *window = nullptr;
+    QJsonObject result;
+    QJsonArray checks;
+    QString report;
+    static QQuickItem *findByDescription(QQuickItem *root, const QString &description) {
+        if (root->property("description").toString() == description && root->isVisible()) return root;
+        for (auto child : root->childItems()) if (auto found = findByDescription(child, description)) return found;
+        return nullptr;
+    }
+    static void collect(QQuickItem *root, QList<QQuickItem *> &out) {
+        if (!root->property("description").toString().isEmpty() && root->isVisible() && root->width() > 0) out << root;
+        for (auto child : root->childItems()) collect(child, out);
+    }
+    qint64 timeMs() const { return MS_FROM_VLC_TICK(player->getTime().toVLCTick()); }
+    qint64 lengthMs() const { return MS_FROM_VLC_TICK(player->getLength().toVLCTick()); }
+    void check(const QString &name, bool ok, const QString &detail = {}) {
+        checks.append(QJsonObject{{"name", name}, {"ok", ok}, {"detail", detail}});
+        if (!ok) result["failed"] = true;
+    }
+    void finish() {
+        result["checks"] = checks;
+        QFile f(report); if (f.open(QIODevice::WriteOnly)) f.write(QJsonDocument(result).toJson());
+        qApp->quit();
+    }
+    // Run `steps` one after another, `delay` ms apart.
+    void sequence(QList<std::function<void()>> steps, int delay = 120) {
+        if (steps.isEmpty()) { finish(); return; }
+        auto step = steps.takeFirst();
+        step();
+        QTimer::singleShot(delay, this, [this, steps] { sequence(steps); });
+    }
+    void seekTo(qint64 ms) { player->setTime(VLCTime(VLC_TICK_FROM_MS(ms))); }
+    // Look the button up again on every click: the toolbar can be rebuilt (e.g. after a profile migration).
+    void click(const QString &description) {
+        if (auto *fresh = findByDescription(window->contentItem(), description)) QMetaObject::invokeMethod(fresh, "clicked");
+        else check("button present: " + description, false);
+    }
+    void press(const char *seq) {
+        const auto all = window->findChildren<QObject *>();
+        bool found = false;
+        for (QObject *o : all)
+            if (o->metaObject()->indexOfProperty("sequence") >= 0 && o->property("sequence").toString() == QLatin1String(seq)
+                && o->property("enabled").toBool()) { QMetaObject::invokeMethod(o, "activated"); found = true; break; }
+        check(QStringLiteral("shortcut %1 present+enabled").arg(seq), found);
+    }
+    // `b` descriptions are cached before any toolbar rebuild, so keep them as plain strings
+    void ready(int tries = 0) {
+        window = qobject_cast<QQuickWindow *>(intf->p_mi ? intf->p_mi->intfMainWindow() : nullptr);
+        QQuickItem *b3 = window ? findByDescription(window->contentItem(), QStringLiteral("Back 3 seconds")) : nullptr;
+        if (!b3 || lengthMs() <= 0 || !player->isSeekable()) {
+            if (tries < 80) QTimer::singleShot(250, this, [this, tries] { ready(tries + 1); }); else { result["error"] = "button not found / not seekable"; finish(); }
+            return;
+        }
+        QQuickItem *f3 = findByDescription(window->contentItem(), QStringLiteral("Forward 3 seconds"));
+        QQuickItem *b10 = findByDescription(window->contentItem(), QStringLiteral("Back 10 seconds"));
+        QQuickItem *f10 = findByDescription(window->contentItem(), QStringLiteral("Forward 10 seconds"));
+        check("all four buttons found", b3 && f3 && b10 && f10);
+        if (!(b3 && f3 && b10 && f10)) { finish(); return; }
+        result["length_ms"] = lengthMs();
+        result["button_size"] = QJsonArray{b3->width(), b3->height(), b10->width(), b10->height()};
+        check("3s and 10s buttons same size", b3->width() == b10->width() && b3->height() == b10->height() && f3->width() == f10->width());
+
+        // toolbar order (left to right, by scene x) among all described items on the same row
+        QList<QQuickItem *> all; collect(window->contentItem(), all);
+        QList<QPair<double, QString>> row;
+        for (auto *i : all) {
+            const QPointF p = i->mapToScene(QPointF(0, 0));
+            if (qAbs(p.y() - b3->mapToScene(QPointF(0, 0)).y()) < 4) row.append({p.x(), i->property("description").toString()});
+        }
+        std::sort(row.begin(), row.end());
+        QJsonArray order; for (auto &r : row) order.append(r.second);
+        result["toolbar_row"] = order;
+
+        pauseThen([this, b3, f3, b10, f10] { run(b3, f3, b10, f10); });
+    }
+    void pauseThen(std::function<void()> next, int tries = 0) {
+        if (player->getPlayingState() == PlayerController::PLAYING_STATE_PAUSED) { QTimer::singleShot(600, this, next); return; }
+        if (tries > 40) { result["error"] = "could not pause"; finish(); return; }
+        if (player->getPlayingState() == PlayerController::PLAYING_STATE_PLAYING)
+        { vlc_player_locker lock(player->getPlayer()); vlc_player_Pause(player->getPlayer()); }
+        QTimer::singleShot(250, this, [this, next, tries] { pauseThen(next, tries + 1); });
+    }
+    void run(QQuickItem *b3, QQuickItem *f3, QQuickItem *b10, QQuickItem *f10) {
+        const qint64 len = lengthMs();
+        auto near = [this](const char *n, qint64 expect, qint64 tol = 400) {
+            const qint64 t = timeMs();
+            check(QString::fromLatin1(n), qAbs(t - expect) <= tol, QStringLiteral("time=%1 expected=%2 state=%3").arg(t).arg(expect).arg(int(player->getPlayingState())));
+        };
+        QTimer::singleShot(500, this, [=, this] {
+            sequence({
+                [=, this] { seekTo(20000); },
+                [=, this] { window->grabWindow().save(report + ".png"); },
+                [=, this] { click(QStringLiteral("Forward 3 seconds"));  },  [=, this] { near("fwd3 from 20s -> 23s", 23000); },
+                [=, this] { click(QStringLiteral("Back 3 seconds"));  },  [=, this] { near("back3 -> 20s", 20000); },
+                [=, this] { click(QStringLiteral("Forward 10 seconds")); },  [=, this] { near("fwd10 -> 30s", 30000); },
+                [=, this] { click(QStringLiteral("Back 10 seconds")); },  [=, this] { near("back10 -> 20s", 20000); },
+                // shortcuts
+                [=, this] { seekTo(20000); },
+                [=, this] { press("Alt+Shift+Right"); }, [=, this] { near("Alt+Shift+Right -> 23s", 23000); },
+                [=, this] { press("Alt+Shift+Left"); },  [=, this] { near("Alt+Shift+Left -> 20s", 20000); },
+                // clamp at the start: jumps larger than the current position must land at the beginning
+                [=, this] { seekTo(2000); },
+                [=, this] { result["pre_back3_ms"] = timeMs(); click(QStringLiteral("Back 3 seconds")); },
+                [=, this] { result["after_back3_ms"] = timeMs(); },
+                [=, this] { seekTo(5000); },
+                [=, this] { result["pre_back10_ms"] = timeMs(); click(QStringLiteral("Back 10 seconds")); },
+                [=, this] { result["after_back10_ms"] = timeMs(); },
+                // clamp at the end: last, because reaching the end stops playback
+                [=, this] { seekTo(len - 1000); },
+                [=, this] { check("pre-end seek landed", qAbs(timeMs() - (len - 1000)) < 400, QString::number(timeMs())); },
+                [=, this] { click(QStringLiteral("Forward 3 seconds")); },   [=, this] { check("fwd3 near end never past duration", timeMs() <= len, QStringLiteral("ui=%1 len=%2").arg(timeMs()).arg(len)); },
+            });
+        });
+    }
+public:
+    Skip3Test(qt_intf_t *i, RebornController *r) : QObject(r), intf(i), player(i->p_mainPlayerController),
+        report(qEnvironmentVariable("VLC_REBORN_TEST_REPORT")) {
+        QTimer::singleShot(500, this, [this] { ready(); });
+        QTimer::singleShot(90000, this, [this] { result["timeout"] = true; finish(); });
+    }
+};
diff --git a/reborn/tests/skip_flash_test.hpp b/reborn/tests/skip_flash_test.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..6b319e93b168598330199baa0478ec6e209384f3
--- /dev/null
+++ b/reborn/tests/skip_flash_test.hpp
@@ -0,0 +1,69 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Opt-in screenshots (VLC_REBORN_TEST_MODE=skipflash, VLC_REBORN_TEST_REPORT=<prefix>): writes <prefix>-normal/hover/flash/shortcut.png
+// of the toolbar region around "Forward 3 seconds". Run with QT_QPA_PLATFORM=offscreen.
+class SkipFlashTest : public QObject {
+    qt_intf_t *intf;
+    PlayerController *player;
+    QQuickWindow *window = nullptr;
+    QString prefix;
+    static QQuickItem *find(QQuickItem *root, const QString &d) {
+        if (root->property("description").toString() == d && root->isVisible()) return root;
+        for (auto c : root->childItems()) if (auto f = find(c, d)) return f;
+        return nullptr;
+    }
+    void shot(QQuickItem *b, const char *name) {
+        const QPointF p = b->mapToScene(QPointF(0, 0));
+        const QRect r = QRectF(p.x() - 130, p.y() - 20, b->width() + 260, b->height() + 40).toRect();
+        window->grabWindow().copy(r).scaled(r.size() * 4, Qt::KeepAspectRatio, Qt::FastTransformation).save(prefix + "-" + name + ".png");
+    }
+    void hover(QQuickItem *b, bool on) {
+        const QPointF c = b->mapToScene(QPointF(b->width() / 2, b->height() / 2));
+        const QPointF away(5, 5);
+        const QPointF pos = on ? c : away;
+        QMouseEvent ev(QEvent::MouseMove, pos, pos, window->mapToGlobal(pos.toPoint()), Qt::NoButton, Qt::NoButton, Qt::NoModifier);
+        QCoreApplication::sendEvent(window, &ev);
+    }
+    void run(QQuickItem *f3) {
+        auto after = [this](int ms, std::function<void()> f) { QTimer::singleShot(ms, this, f); };
+        hover(f3, false);
+        after(500, [=, this] {
+            shot(f3, "normal");
+            hover(f3, true);
+            after(500, [=, this] {
+                shot(f3, "hover");
+                hover(f3, false);
+                after(500, [=, this] {
+                    QMetaObject::invokeMethod(f3, "clicked");
+                    after(40, [=, this] { shot(f3, "flash");
+                        after(600, [=, this] {
+                            const auto all = window->findChildren<QObject *>();
+                            for (QObject *o : all)
+                                if (o->metaObject()->indexOfProperty("sequence") >= 0 && o->property("sequence").toString() == QLatin1String("Alt+Shift+Right")) {
+                                    QMetaObject::invokeMethod(o, "activated"); break; }
+                            after(40, [=, this] { shot(f3, "shortcut"); after(600, [=, this] {
+                                // VLC core hotkey (default Shift+Right = short jump, 10 s): must flash the 10 s button
+                                intf->p_mi->sendHotkey(Qt::Key_Right, Qt::ShiftModifier);
+                                after(40, [=, this] { shot(f3, "hotkey10"); after(300, [] { qApp->quit(); }); });
+                            }); });
+                        });
+                    });
+                });
+            });
+        });
+    }
+    void ready(int tries = 0) {
+        window = qobject_cast<QQuickWindow *>(intf->p_mi ? intf->p_mi->intfMainWindow() : nullptr);
+        QQuickItem *f3 = window ? find(window->contentItem(), QStringLiteral("Forward 3 seconds")) : nullptr;
+        if (!f3 || !player->isSeekable() || player->getLength().toVLCTick() <= 0) {
+            if (tries < 80) QTimer::singleShot(250, this, [this, tries] { ready(tries + 1); }); else qApp->quit();
+            return;
+        }
+        QTimer::singleShot(1000, this, [this, f3] { run(f3); });
+    }
+public:
+    SkipFlashTest(qt_intf_t *i, RebornController *r) : QObject(r), intf(i), player(i->p_mainPlayerController),
+        prefix(qEnvironmentVariable("VLC_REBORN_TEST_REPORT")) {
+        QTimer::singleShot(500, this, [this] { ready(); });
+        QTimer::singleShot(90000, this, [] { qApp->quit(); });
+    }
+};
diff --git a/reborn/tests/video_info_test.hpp b/reborn/tests/video_info_test.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..933ca77d81c7261dd7500890fee816c6f0ed3ebb
--- /dev/null
+++ b/reborn/tests/video_info_test.hpp
@@ -0,0 +1,65 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Opt-in check (VLC_REBORN_TEST_MODE=video-info): clicks the Video Info toolbar button, grabs the panel and verifies copy.
+class VideoInfoTest : public QObject {
+    qt_intf_t *intf;
+    RebornController *reborn;
+    PlayerController *player;
+    QQuickWindow *window = nullptr;
+    QJsonObject result;
+    QString report;
+    static QQuickItem *findByDescription(QQuickItem *root, const QString &description, bool prefix = false) {
+        const QString d = root->property("description").toString();
+        if (!d.isEmpty() && (prefix ? d.startsWith(description) : d == description) && root->isVisible()) return root;
+        for (auto child : root->childItems()) if (auto found = findByDescription(child, description, prefix)) return found;
+        return nullptr;
+    }
+    static QQuickItem *findPanel(QQuickItem *root) {
+        for (auto child : root->childItems()) { if (auto f = findPanel(child)) return f; }
+        return root->property("rowHeight").isValid() && root->property("info").isValid() ? root : nullptr;
+    }
+    void finish() {
+        QFile f(report); if (f.open(QIODevice::WriteOnly)) f.write(QJsonDocument(result).toJson());
+        qApp->quit();
+    }
+    void ready(int tries = 0) {
+        window = qobject_cast<QQuickWindow *>(intf->p_mi ? intf->p_mi->intfMainWindow() : nullptr);
+        QQuickItem *button = window ? findByDescription(window->contentItem(), QStringLiteral("Video Info")) : nullptr;
+        if (!button || !player->hasVideoOutput() || player->getLength().toVLCTick() <= 0) {
+            if (tries < 60) QTimer::singleShot(250, this, [this, tries] { ready(tries + 1); }); else { result["error"] = "button not found"; finish(); }
+            return;
+        }
+        result["button_found"] = true;
+        result["button_enabled"] = button->isEnabled();
+        result["info"] = QJsonObject::fromVariantMap(reborn->videoInfo());
+        { vlc_player_locker lock(player->getPlayer()); vlc_player_Pause(player->getPlayer()); }
+        QTimer::singleShot(400, this, [this, button] {
+            QMetaObject::invokeMethod(button, "clicked");
+            QTimer::singleShot(700, this, [this] { afterOpen(); });
+        });
+    }
+    void afterOpen() {
+        QQuickItem *panel = findPanel(window->contentItem());
+        result["panel_found"] = panel != nullptr;
+        window->grabWindow().save(report + ".panel.png");
+        QQuickItem *copy = nullptr;
+        // copy buttons are IconToolButtons whose description starts with "Copy "
+        copy = findByDescription(window->contentItem(), QStringLiteral("Copy "), true);
+        result["copy_button_found"] = copy != nullptr;
+        if (copy) {
+            QApplication::clipboard()->setText(QStringLiteral("__sentinel__"));
+            QMetaObject::invokeMethod(copy, "clicked");
+            QTimer::singleShot(200, this, [this, copy] {
+                result["copied_text"] = QApplication::clipboard()->text();
+                result["copy_description_after"] = copy->property("description").toString();
+                window->grabWindow().save(report + ".copied.png");
+                finish();
+            });
+        } else finish();
+    }
+public:
+    VideoInfoTest(qt_intf_t *i, RebornController *r) : QObject(r), intf(i), reborn(r), player(i->p_mainPlayerController),
+        report(qEnvironmentVariable("VLC_REBORN_TEST_REPORT")) {
+        QTimer::singleShot(500, this, [this] { ready(); });
+        QTimer::singleShot(60000, this, [this] { result["timeout"] = true; finish(); });
+    }
+};
