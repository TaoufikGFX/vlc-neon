+void RebornController::setBoost(int percent)
+{
+    const auto maximum = var_InheritInteger(m_intf, "qt-max-volume");
+    const float volume = qBound(100, percent, std::max(100, int(maximum))) / 100.f;
+    auto aout = m_player->getAout();
+    if (aout && volume > 1) {
+        char *filters = var_GetString(aout.get(), "audio-filter");
+        const bool alreadyEnabled = filters && QByteArray(filters).split(':').contains(QByteArrayLiteral("limiter"));
+        free(filters);
+        if (!alreadyEnabled || m_limiterOwned) {
+            if (var_Type(aout.get(), "limiter-threshold") == 0)
+                var_Create(aout.get(), "limiter-threshold", VLC_VAR_FLOAT | VLC_VAR_DOINHERIT);
+            // VLC and Pulse/PipeWire use cubic perceptual volume.
+            // Reserve gain headroom in VLC's existing peak limiter.
+            var_SetFloat(aout.get(), "limiter-threshold", -60.f * std::log10(volume) - 1.f);
+            if (vlc_player_aout_EnableFilter(m_player->getPlayer(), "limiter", true) == VLC_SUCCESS)
+                m_limiterOwned = true;
+        }
+    }
+    m_player->setVolume(volume);
+}
