diff --git a/modules/gui/qt/player/qml/VideoInfoPanel.qml b/modules/gui/qt/player/qml/VideoInfoPanel.qml
new file mode 100644
index 0000000000000000000000000000000000000000..7d9e1543a60abb7748773b9f48fdbb8255bc8383
--- /dev/null
+++ b/modules/gui/qt/player/qml/VideoInfoPanel.qml
@@ -0,0 +1,195 @@
+/*****************************************************************************
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ * Neon Video Info panel: selected video/audio track details, each value copyable.
+ *****************************************************************************/
+
+import QtQuick
+import QtQuick.Controls
+import QtQuick.Templates as T
+import QtQuick.Layouts
+
+import VLC.MainInterface
+import VLC.Player
+import VLC.Style
+import VLC.Widgets as Widgets
+import VLC.Util
+
+ColumnLayout {
+    id: root
+
+    // Data comes from VLC's selected-track information and refreshes when tracks or media change.
+    readonly property var info: Reborn.videoInfo
+
+    readonly property real rowHeight: VLCStyle.dp(46, VLCStyle.scale)
+
+    spacing: 0
+
+    readonly property ColorContext colorContext: ColorContext {
+        id: theme
+        colorSet: ColorContext.Window
+    }
+
+    component SectionHeader: RowLayout {
+        property alias text: sectionText.text
+
+        Layout.fillWidth: true
+        Layout.leftMargin: VLCStyle.margin_small
+        Layout.rightMargin: VLCStyle.margin_xsmall
+        Layout.topMargin: VLCStyle.margin_xsmall
+        Layout.bottomMargin: VLCStyle.margin_xxsmall
+
+        spacing: VLCStyle.margin_xsmall
+
+        Widgets.CaptionLabel {
+            id: sectionText
+
+            color: theme.accent
+            font.pixelSize: VLCStyle.fontSize_small
+            font.weight: Font.DemiBold
+            font.letterSpacing: 1
+        }
+
+        Rectangle {
+            Layout.fillWidth: true
+            Layout.preferredHeight: 1
+            color: Qt.alpha(theme.fg.primary, 0.12)
+        }
+    }
+
+    component InfoRow: Item {
+        id: row
+
+        property string label
+        property string value
+        property bool copied: false
+
+        readonly property bool hasValue: value.length > 0
+
+        Layout.fillWidth: true
+        implicitHeight: root.rowHeight
+
+        Timer {
+            id: copiedTimer
+            interval: 1300
+            onTriggered: row.copied = false
+        }
+
+        function copy() {
+            if (!hasValue)
+                return
+            Reborn.copyText(value)
+            copied = true
+            copiedTimer.restart()
+        }
+
+        Rectangle {
+            anchors.fill: parent
+            radius: VLCStyle.dp(8, VLCStyle.scale)
+            color: hover.hovered && row.hasValue ? Qt.alpha(theme.fg.primary, 0.07) : "transparent"
+        }
+
+        HoverHandler { id: hover }
+
+        // Double click on the value copies it too.
+        TapHandler {
+            acceptedButtons: Qt.LeftButton
+            onDoubleTapped: row.copy()
+        }
+
+        RowLayout {
+            anchors.fill: parent
+            anchors.leftMargin: VLCStyle.margin_small
+            anchors.rightMargin: VLCStyle.margin_xxsmall
+            spacing: VLCStyle.margin_xsmall
+
+            ColumnLayout {
+                Layout.fillWidth: true
+                Layout.alignment: Qt.AlignVCenter
+                spacing: 0
+
+                Text {
+                    Layout.fillWidth: true
+                    text: row.label
+                    color: theme.fg.secondary
+                    font.pixelSize: VLCStyle.fontSize_small
+                    elide: Text.ElideRight
+                }
+
+                Text {
+                    Layout.fillWidth: true
+                    text: row.hasValue ? row.value : "—"
+                    color: row.hasValue ? theme.fg.primary : theme.fg.secondary
+                    font.pixelSize: VLCStyle.fontSize_normal
+                    font.weight: Font.Medium
+                    elide: Text.ElideRight
+
+                    T.ToolTip.visible: valueHover.hovered && truncated && row.hasValue
+                    T.ToolTip.delay: VLCStyle.delayToolTipAppear
+                    T.ToolTip.text: row.value
+
+                    HoverHandler { id: valueHover }
+                }
+            }
+
+            Widgets.IconToolButton {
+                id: copyButton
+
+                Layout.alignment: Qt.AlignVCenter
+                Layout.preferredWidth: VLCStyle.dp(30, VLCStyle.scale)
+                Layout.preferredHeight: VLCStyle.dp(30, VLCStyle.scale)
+
+                enabled: row.hasValue
+                opacity: row.hasValue ? (hover.hovered || visualFocus || row.copied ? 1.0 : 0.55) : 0.0
+
+                font.pixelSize: VLCStyle.dp(16, VLCStyle.scale)
+                text: row.copied ? VLCIcons.check : VLCIcons.ic_fluent_document_copy_24_regular
+                color: row.copied ? theme.accent : theme.fg.primary
+                description: row.copied ? qsTr("Copied") : qsTr("Copy %1").arg(row.label)
+
+                AccessibleCompat.id: "videoInfoCopy_" + row.label
+
+                onClicked: row.copy()
+            }
+        }
+    }
+
+    component EmptyNote: Text {
+        Layout.fillWidth: true
+        Layout.leftMargin: VLCStyle.margin_small
+        Layout.topMargin: VLCStyle.margin_xxsmall
+        Layout.bottomMargin: VLCStyle.margin_xxsmall
+        color: theme.fg.secondary
+        font.pixelSize: VLCStyle.fontSize_normal
+        wrapMode: Text.WordWrap
+    }
+
+    Widgets.CaptionLabel {
+        Layout.fillWidth: true
+        Layout.leftMargin: VLCStyle.margin_small
+        Layout.topMargin: VLCStyle.margin_xxsmall
+
+        text: qsTr("VIDEO INFO")
+        color: theme.fg.secondary
+        font.pixelSize: VLCStyle.fontSize_small
+        font.weight: Font.DemiBold
+        font.letterSpacing: 1
+    }
+
+    // ---- Video ----
+    SectionHeader { text: qsTr("VIDEO") }
+
+    InfoRow { label: qsTr("Title");            value: root.info.title || "" }
+    InfoRow { visible: root.info.hasVideo; label: qsTr("Video resolution"); value: root.info.videoResolution || "" }
+    InfoRow { visible: root.info.hasVideo; label: qsTr("Codec");            value: root.info.videoCodec || "" }
+    InfoRow { visible: root.info.hasVideo; label: qsTr("Language");         value: root.info.videoLanguage || "" }
+    InfoRow { visible: root.info.hasVideo; label: qsTr("Type");             value: root.info.videoType || "" }
+    EmptyNote { visible: !root.info.hasVideo; text: qsTr("No video track") }
+
+    // ---- Audio ----
+    SectionHeader { text: qsTr("AUDIO") }
+
+    InfoRow { visible: root.info.hasAudio; label: qsTr("Codec");       value: root.info.audioCodec || "" }
+    InfoRow { visible: root.info.hasAudio; label: qsTr("Language");    value: root.info.audioLanguage || "" }
+    InfoRow { visible: root.info.hasAudio; label: qsTr("Sample Rate"); value: root.info.audioSampleRate || "" }
+    EmptyNote { visible: !root.info.hasAudio; text: qsTr("No audio track") }
+}
