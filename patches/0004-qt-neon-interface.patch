diff --git a/modules/gui/qt/player/qml/PipButton.qml b/modules/gui/qt/player/qml/PipButton.qml
new file mode 100644
index 0000000000000000000000000000000000000000..670413c5c779ee1ec6891deda273d3ce0332371f
--- /dev/null
+++ b/modules/gui/qt/player/qml/PipButton.qml
@@ -0,0 +1,73 @@
+/*****************************************************************************
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ * Round button of the Picture-in-Picture overlay: dark translucent disc with an accent-colored icon, readable over any
+ * video. `primary` is the play/pause button, styled like the main toolbar's: white disc, accent ring. flash() gives the
+ * short accent feedback the toolbar's skip buttons have.
+ *****************************************************************************/
+import QtQuick
+import QtQuick.Templates as T
+
+import VLC.MainInterface
+import VLC.Widgets as Widgets
+import VLC.Style
+import VLC.Util
+
+T.AbstractButton {
+    id: root
+
+    required property string description
+    property bool primary: false
+    property real diameter: 32
+    // Icon size relative to the disc
+    property real iconRatio: primary ? 0.52 : 0.7
+
+    property real _flash: 0
+
+    function flash() {
+        flashAnimation.restart()
+    }
+
+    readonly property ColorContext colorContext: ColorContext {
+        id: theme
+        colorSet: ColorContext.ToolButton
+    }
+
+    implicitWidth: diameter
+    implicitHeight: diameter
+    focusPolicy: Qt.NoFocus
+
+    Accessible.name: description
+
+    // hover: small scale-up
+    scale: (hovered || down) ? (down ? 1.04 : 1.12) : 1.0
+    Behavior on scale { NumberAnimation { duration: 150; easing.type: Easing.OutQuad } }
+
+    SequentialAnimation {
+        id: flashAnimation
+
+        ScriptAction { script: root._flash = 1 }
+        NumberAnimation { target: root; property: "_flash"; to: 0; duration: 150; easing.type: Easing.OutQuad }
+    }
+
+    background: Rectangle {
+        radius: width / 2
+        color: root.primary ? (root.hovered ? Qt.rgba(1, 1, 1, 1) : Qt.rgba(0.94, 0.94, 0.94, 1))
+                            : Qt.tint(Qt.rgba(0, 0, 0, root.hovered ? 0.78 : 0.55),
+                                      Qt.rgba(theme.accent.r, theme.accent.g, theme.accent.b, root._flash * 0.9))
+        // accent ring for play/pause; a faint light rim on the others keeps them visible over very dark video
+        border.width: root.primary ? Math.max(2, root.diameter * 0.06) : 1
+        border.color: root.primary ? theme.accent : Qt.rgba(1, 1, 1, 0.22)
+        Behavior on color { enabled: root._flash === 0; ColorAnimation { duration: 150 } }
+    }
+
+    contentItem: Widgets.IconLabel {
+        text: root.text
+        color: root.primary ? Qt.rgba(0.04, 0.04, 0.04, 1) : Qt.tint(theme.accent, Qt.rgba(1, 1, 1, root._flash))
+        font.pixelSize: Math.round(root.diameter * root.iconRatio)
+        font.bold: true
+    }
+
+    T.ToolTip.visible: hovered
+    T.ToolTip.delay: VLCStyle.delayToolTipAppear
+    T.ToolTip.text: description
+}
diff --git a/modules/gui/qt/player/qml/PipPlaceholder.qml b/modules/gui/qt/player/qml/PipPlaceholder.qml
new file mode 100644
index 0000000000000000000000000000000000000000..88f2e08762383374bf206726335f6f7e26462267
--- /dev/null
+++ b/modules/gui/qt/player/qml/PipPlaceholder.qml
@@ -0,0 +1,79 @@
+/*****************************************************************************
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ * Static view of the main window while the video plays in the Picture-in-Picture window. Deliberately inert:
+ * no animation, no blur, no per-frame binding, so the window costs nothing even when it is visible.
+ *****************************************************************************/
+import QtQuick
+import QtQuick.Controls
+
+import VLC.MainInterface
+import VLC.Widgets as Widgets
+import VLC.Style
+import VLC.Util
+
+FocusScope {
+    id: root
+
+    // Fills whatever Loader/parent hosts it, and follows its size
+    anchors.fill: parent
+
+    readonly property ColorContext colorContext: ColorContext {
+        id: theme
+        palette: VLCStyle.palette
+        colorSet: ColorContext.Window
+    }
+
+    // Everything scales with the window
+    readonly property real unit: Math.max(1, Math.min(width, height))
+
+    // Opaque: the theme's window color may be translucent (blur behind), which would show the desktop through it
+    Rectangle {
+        anchors.fill: parent
+        color: Qt.rgba(theme.bg.primary.r, theme.bg.primary.g, theme.bg.primary.b, 1.0)
+    }
+
+    // Title bar: drag and window buttons (client-side decoration), like the other full-window views
+    Item {
+        anchors { top: parent.top; left: parent.left; right: parent.right }
+        height: VLCStyle.globalToolbar_height
+
+        Loader {
+            anchors.fill: parent
+            active: MainCtx.clientSideDecoration
+            source: "qrc:///qt/qml/VLC/Widgets/CSDTitlebarTapNDrapHandler.qml"
+        }
+
+        Loader {
+            anchors { top: parent.top; right: parent.right; bottom: parent.bottom }
+            active: MainCtx.clientSideDecoration
+            source: VLCStyle.palette.hasCSDImage ? "qrc:///qt/qml/VLC/Widgets/CSDThemeButtonSet.qml"
+                                                 : "qrc:///qt/qml/VLC/Widgets/CSDWindowButtonSet.qml"
+        }
+    }
+
+    Column {
+        anchors.centerIn: parent
+        spacing: Math.max(10, Math.min(24, root.unit * 0.035))
+
+        Widgets.IconLabel {
+            anchors.horizontalCenter: parent.horizontalCenter
+            text: VLCIcons.pip
+            color: theme.accent
+            font.pixelSize: Math.max(36, Math.min(64, root.unit * 0.12))   // at most 64 px
+        }
+
+        Text {
+            anchors.horizontalCenter: parent.horizontalCenter
+            text: qsTr("Playing in Picture-in-Picture")
+            color: theme.fg.primary
+            font.pixelSize: Math.max(16, Math.min(20, root.unit * 0.028))   // 16 to 20 px
+        }
+
+        Button {
+            anchors.horizontalCenter: parent.horizontalCenter
+            text: qsTr("Back to main window")
+            font.pixelSize: 14                                                // a normal-size button
+            onClicked: Reborn.exitPipWindow(true)
+        }
+    }
+}
diff --git a/modules/gui/qt/player/qml/PipSeekBar.qml b/modules/gui/qt/player/qml/PipSeekBar.qml
new file mode 100644
index 0000000000000000000000000000000000000000..537ed2db2b4a8691ca70e6663df5d2b66a303b0d
--- /dev/null
+++ b/modules/gui/qt/player/qml/PipSeekBar.qml
@@ -0,0 +1,96 @@
+/*****************************************************************************
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ * Seek bar of the Picture-in-Picture overlay: a 4 px track (6 px on hover) with an accent fill like the main progress bar,
+ * a round thumb on hover, a 16 px high hit area and a time tooltip at the pointer. Click or drag to seek.
+ *****************************************************************************/
+import QtQuick
+
+import VLC.MainInterface
+import VLC.Player
+import VLC.Style
+import VLC.Util
+
+Item {
+    id: root
+
+    readonly property ColorContext colorContext: ColorContext {
+        id: theme
+        colorSet: ColorContext.Window
+    }
+
+    // Invisible hit area: much taller than the visible track
+    implicitHeight: 16
+
+    readonly property bool active: mouse.containsMouse || mouse.pressed
+    property real _dragPosition: -1
+    readonly property real shownPosition: _dragPosition >= 0 ? _dragPosition : Math.max(0, Math.min(1, Player.position))
+    readonly property real _hoverRatio: Math.max(0, Math.min(1, mouse.mouseX / Math.max(1, width)))
+
+    Rectangle {
+        id: track
+        anchors { left: parent.left; right: parent.right; verticalCenter: parent.verticalCenter }
+        height: root.active ? 6 : 4
+        radius: height / 2
+        color: Qt.rgba(1, 1, 1, 0.3)
+        Behavior on height { NumberAnimation { duration: 150; easing.type: Easing.OutQuad } }
+
+        Rectangle {
+            width: parent.width * root.shownPosition
+            height: parent.height
+            radius: parent.radius
+            color: theme.accent
+        }
+
+        // thumb, only while hovered or dragged
+        Rectangle {
+            width: 12
+            height: 12
+            radius: 6
+            color: theme.accent
+            x: parent.width * root.shownPosition - width / 2
+            anchors.verticalCenter: parent.verticalCenter
+            opacity: root.active ? 1 : 0
+            visible: opacity > 0
+            Behavior on opacity { NumberAnimation { duration: 150 } }
+        }
+    }
+
+    // time at the pointer
+    Rectangle {
+        id: tip
+        visible: root.active
+        opacity: visible ? 1 : 0
+        color: Qt.rgba(0, 0, 0, 0.8)
+        radius: 4
+        width: tipText.implicitWidth + 12
+        height: tipText.implicitHeight + 6
+        x: Math.max(0, Math.min(root.width - width, mouse.mouseX - width / 2))
+        y: -height - 4
+
+        Text {
+            id: tipText
+            anchors.centerIn: parent
+            text: Player.length.scale(root.active ? root._hoverRatio : 0).formatHMS()
+            color: "white"
+            font.pixelSize: 12
+        }
+    }
+
+    MouseArea {
+        id: mouse
+        anchors.fill: parent
+        hoverEnabled: true
+        enabled: Player.seekable
+        cursorShape: Qt.PointingHandCursor
+
+        function seek(x) {
+            const p = Math.max(0, Math.min(1, x / Math.max(1, width)))
+            root._dragPosition = p
+            Player.position = p
+        }
+        onPressed: (event) => seek(event.x)
+        onPositionChanged: (event) => { if (pressed) seek(event.x) }
+        onReleased: root._dragPosition = -1
+        onCanceled: root._dragPosition = -1
+    }
+}
diff --git a/modules/gui/qt/player/qml/PipWindow.qml b/modules/gui/qt/player/qml/PipWindow.qml
new file mode 100644
index 0000000000000000000000000000000000000000..2a7057e9eb39166a3f18bc27452485801434263a
--- /dev/null
+++ b/modules/gui/qt/player/qml/PipWindow.qml
@@ -0,0 +1,358 @@
+/*****************************************************************************
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ * Content of the separate Picture-in-Picture window: the video, a hover overlay and a minimal context menu. Nothing else
+ * is loaded in this window (no toolbar scene, no shadow margin, no blur).
+ *****************************************************************************/
+import QtQuick
+import QtQuick.Controls
+import QtQuick.Window
+
+import VLC.MainInterface
+import VLC.Widgets as Widgets
+import VLC.Player
+import VLC.Playlist
+import VLC.Style
+import VLC.Util
+
+FocusScope {
+    id: root
+
+    focus: true
+
+    // This window is its own scene: give the overlay the same dark theme the main window's video views use (without a
+    // ColorContext up the tree the colors are undefined and render as solid magenta)
+    readonly property ColorContext colorContext: ColorContext {
+        palette: VLCStyle.darkPalette
+        colorSet: ColorContext.Window
+    }
+
+    // The video surface only talks to the vout once the video has been moved to this (visible) window, and stops
+    // before it moves back (see RebornController::enterPipWindow/exitPipWindow)
+    property bool attached: false
+
+    readonly property bool paused: Player.playingState === Player.PLAYING_STATE_PAUSED
+
+    // Overlay visibility: shown as soon as the pointer enters or moves, hidden 2 s after it stopped or left (never while it
+    // is over a button, the seek bar or the menu), always shown while paused. The handlers that drive it live on this
+    // always-visible root: handlers inside the overlay would stop receiving input as soon as it is hidden.
+    property bool shown: false
+    readonly property bool overlayVisible: shown || paused
+    readonly property bool overControls: backButton.hovered || closeButton.hovered || skipBack10.hovered || skipBack3.hovered
+                                         || playButton.hovered || skipForward3.hovered || skipForward10.hovered
+                                         || muteButton.hovered || seekBar.active
+    function poke() {
+        shown = true
+        hideTimer.restart()
+    }
+
+    Timer {
+        id: hideTimer
+        interval: 2000
+        onTriggered: {
+            if (root.overControls || contextMenu.visible)
+                restart()
+            else
+                root.shown = false
+        }
+    }
+    readonly property real buttonSize: Math.round(VLCStyle.dp(36, VLCStyle.scale))
+
+    Component.onCompleted: forceActiveFocus()
+
+    // Keyboard: Space = play/pause, Esc = back to the main window, everything else goes to the VLC hotkeys
+    // (arrows, skip, volume...), which the core handles exactly as in the main window.
+    Keys.onPressed: (event) => {
+        if (event.key === Qt.Key_Space) {
+            MainPlaylistController.togglePlayPause()
+        } else if (event.key === Qt.Key_Escape) {
+            Reborn.exitPipWindow(true)
+        } else {
+            MainCtx.sendHotkey(event.key, event.modifiers)
+        }
+        event.accepted = true
+    }
+
+    VideoSurface {
+        id: videoSurface
+        anchors.fill: parent
+        videoSurfaceProvider: root.attached ? MainCtx.videoSurfaceProvider : null
+        // A click on the video does nothing (the core would pause): play/pause is the button, Space or the menu
+        forwardsClicks: false
+    }
+
+    // Pointer enter / leave
+    HoverHandler {
+        id: hover
+        onHoveredChanged: {
+            if (hovered) root.poke()
+            else hideTimer.restart()
+        }
+    }
+
+    // Pointer motion over the video (a HoverHandler does not report plain motion once the pointer is inside). It takes no
+    // button, so clicks still reach everything below and above it.
+    MouseArea {
+        anchors.fill: parent
+        hoverEnabled: true
+        acceptedButtons: Qt.NoButton
+        onPositionChanged: root.poke()
+    }
+
+    // Drag the window anywhere that is not a button (the compositor does the moving)
+    DragHandler {
+        target: null
+        onActiveChanged: if (active) root.Window.window.startSystemMove()
+    }
+
+    // Double click: back to the main window
+    TapHandler {
+        acceptedButtons: Qt.LeftButton
+        onDoubleTapped: Reborn.exitPipWindow(true)
+    }
+
+    // Right click: a minimal menu, never the full VLC menu
+    TapHandler {
+        acceptedButtons: Qt.RightButton
+        onTapped: (eventPoint, button) => contextMenu.popup()
+    }
+
+    Menu {
+        id: contextMenu
+
+        MenuItem {
+            id: playItem
+            text: root.paused ? qsTr("Play") : qsTr("Pause")
+            onTriggered: MainPlaylistController.togglePlayPause()
+        }
+        MenuItem {
+            id: backItem
+            text: qsTr("Back to main window")
+            contentItem: Row {
+                spacing: 8
+                Text {
+                    anchors.verticalCenter: parent.verticalCenter
+                    text: VLCIcons.window_back
+                    font.family: VLCIcons.fontFamily
+                    font.pixelSize: 18
+                    color: playItem.contentItem.color
+                }
+                Text {
+                    anchors.verticalCenter: parent.verticalCenter
+                    text: backItem.text
+                    font: backItem.font
+                    color: playItem.contentItem.color
+                }
+            }
+            onTriggered: Reborn.exitPipWindow(true)
+        }
+        MenuItem {
+            text: qsTr("Close Picture-in-Picture")
+            onTriggered: Reborn.exitPipWindow(false)
+        }
+    }
+
+    // Jump feedback: the same accent flash the main toolbar's skip buttons give
+    Connections {
+        target: Player
+        function onJumped(seconds) {
+            if (seconds === -10) skipBack10.flash()
+            else if (seconds === -3) skipBack3.flash()
+            else if (seconds === 3) skipForward3.flash()
+            else if (seconds === 10) skipForward10.flash()
+        }
+    }
+
+    // Overlay: fades in over 150 ms when the pointer enters or moves (see `shown`); nothing at all is drawn over the video
+    // when it is hidden (invisible items are not rendered)
+    Item {
+        id: overlay
+
+        objectName: "pipOverlay"
+        anchors.fill: parent
+        opacity: root.overlayVisible ? 1 : 0
+        visible: opacity > 0
+        Behavior on opacity { NumberAnimation { duration: 150; easing.type: Easing.OutQuad } }
+
+        // Everything scales with the window, between a minimum and a maximum
+        readonly property real scaleFactor: Math.max(0.8, Math.min(1.4, Math.min(width / 480, height / 270)))
+        readonly property real small: Math.round(32 * scaleFactor)      // skip / mute discs
+        readonly property real big: Math.round(40 * scaleFactor)        // play / pause (about 1.25x)
+        readonly property real topSize: Math.round(30 * scaleFactor)        // Back / Close
+        readonly property real margin: Math.round(10 * scaleFactor)
+        readonly property real gap: Math.round(8 * scaleFactor)
+
+        // As the window shrinks, drop in this order: +-3, the time, +-10, mute. Play/pause, the seek bar, Back and Close
+        // always stay.
+        readonly property bool showSkip3: width >= 430
+        readonly property bool showTime: width >= 340
+        readonly property bool showSkip10: width >= 290
+        readonly property bool showMute: width >= 262
+
+        // top scrim + Back / Close
+        Rectangle {
+            anchors { top: parent.top; left: parent.left; right: parent.right }
+            height: overlay.topSize + 2 * overlay.margin
+            gradient: Gradient {
+                GradientStop { position: 0; color: Qt.rgba(0, 0, 0, 0.65) }
+                GradientStop { position: 1; color: "transparent" }
+            }
+        }
+
+        Row {
+            anchors { top: parent.top; right: parent.right; margins: overlay.margin }
+            spacing: overlay.gap
+
+            PipButton {
+                id: backButton
+                diameter: overlay.topSize
+                text: VLCIcons.window_back
+                description: qsTr("Back to main window")
+                onClicked: Reborn.exitPipWindow(true)
+            }
+            PipButton {
+                id: closeButton
+                diameter: overlay.topSize
+                text: VLCIcons.close
+                description: qsTr("Close Picture-in-Picture")
+                onClicked: Reborn.exitPipWindow(false)
+            }
+        }
+
+        // One bottom bar over the bottom scrim: the seek bar on top, the buttons under it
+        Rectangle {
+            anchors { bottom: parent.bottom; left: parent.left; right: parent.right }
+            height: bottomBar.height + 2 * overlay.margin + 16
+            gradient: Gradient {
+                GradientStop { position: 0; color: "transparent" }
+                GradientStop { position: 1; color: Qt.rgba(0, 0, 0, 0.82) }
+            }
+        }
+
+        Item {
+            id: bottomBar
+
+            anchors { left: parent.left; right: parent.right; bottom: parent.bottom
+                      leftMargin: overlay.margin; rightMargin: overlay.margin; bottomMargin: Math.round(overlay.margin * 0.6) }
+            height: seekBar.height + controls.height + 2
+
+            PipSeekBar {
+                id: seekBar
+                anchors { left: parent.left; right: parent.right; top: parent.top }
+            }
+
+            Item {
+                id: controls
+                anchors { left: parent.left; right: parent.right; top: seekBar.bottom; topMargin: 2 }
+                height: overlay.big
+
+                Text {
+                    visible: overlay.showTime
+                    anchors { left: parent.left; verticalCenter: parent.verticalCenter }
+                    text: Player.time.formatHMS() + " / " + Player.length.formatHMS()
+                    color: "white"
+                    style: Text.Outline
+                    styleColor: Qt.rgba(0, 0, 0, 0.85)
+                    font.pixelSize: 13
+                    font.weight: Font.DemiBold
+                }
+
+                // [-10] [-3] [play/pause] [+3] [+10], centered, same order as the main toolbar
+                Row {
+                    anchors.centerIn: parent
+                    spacing: overlay.gap
+
+                    PipButton {
+                        id: skipBack10
+                        visible: overlay.showSkip10
+                        anchors.verticalCenter: parent.verticalCenter
+                        diameter: overlay.small
+                        enabled: Player.seekable
+                        text: VLCIcons.skip_back
+                        description: qsTr("Back 10 seconds")
+                        onClicked: Player.jumpBy(-10)
+                    }
+                    PipButton {
+                        id: skipBack3
+                        visible: overlay.showSkip3
+                        anchors.verticalCenter: parent.verticalCenter
+                        diameter: overlay.small
+                        enabled: Player.seekable
+                        text: VLCIcons.skip_back_3
+                        description: qsTr("Back 3 seconds")
+                        onClicked: Player.jumpBy(-3)
+                    }
+                    PipButton {
+                        id: playButton
+                        primary: true
+                        diameter: overlay.big
+                        text: root.paused ? VLCIcons.play_filled : VLCIcons.pause_filled
+                        description: root.paused ? qsTr("Play") : qsTr("Pause")
+                        onClicked: MainPlaylistController.togglePlayPause()
+                    }
+                    PipButton {
+                        id: skipForward3
+                        visible: overlay.showSkip3
+                        anchors.verticalCenter: parent.verticalCenter
+                        diameter: overlay.small
+                        enabled: Player.seekable
+                        text: VLCIcons.skip_for_3
+                        description: qsTr("Forward 3 seconds")
+                        onClicked: Player.jumpBy(3)
+                    }
+                    PipButton {
+                        id: skipForward10
+                        visible: overlay.showSkip10
+                        anchors.verticalCenter: parent.verticalCenter
+                        diameter: overlay.small
+                        enabled: Player.seekable
+                        text: VLCIcons.skip_for
+                        description: qsTr("Forward 10 seconds")
+                        onClicked: Player.jumpBy(10)
+                    }
+                }
+
+                PipButton {
+                    id: muteButton
+                    visible: overlay.showMute
+                    anchors { right: parent.right; verticalCenter: parent.verticalCenter }
+                    diameter: overlay.small
+                    text: Player.muted ? VLCIcons.volume_muted : VLCIcons.volume_high
+                    description: Player.muted ? qsTr("Unmute") : qsTr("Mute")
+                    onClicked: Player.muted = !Player.muted
+                }
+            }
+        }
+    }
+
+    // Resize from the edges and corners (the compositor does the resizing, the app only snaps to the video
+    // aspect ratio once the size has settled)
+    Repeater {
+        model: [
+            { edges: Qt.LeftEdge,                  x: 0, y: 1, cursor: Qt.SizeHorCursor },
+            { edges: Qt.RightEdge,                 x: 2, y: 1, cursor: Qt.SizeHorCursor },
+            { edges: Qt.TopEdge,                   x: 1, y: 0, cursor: Qt.SizeVerCursor },
+            { edges: Qt.BottomEdge,                x: 1, y: 2, cursor: Qt.SizeVerCursor },
+            { edges: Qt.LeftEdge | Qt.TopEdge,     x: 0, y: 0, cursor: Qt.SizeFDiagCursor },
+            { edges: Qt.RightEdge | Qt.BottomEdge, x: 2, y: 2, cursor: Qt.SizeFDiagCursor },
+            { edges: Qt.RightEdge | Qt.TopEdge,    x: 2, y: 0, cursor: Qt.SizeBDiagCursor },
+            { edges: Qt.LeftEdge | Qt.BottomEdge,  x: 0, y: 2, cursor: Qt.SizeBDiagCursor }
+        ]
+
+        delegate: Item {
+            required property var modelData
+            readonly property real grip: VLCStyle.dp(8, VLCStyle.scale)
+
+            x: modelData.x === 0 ? 0 : modelData.x === 2 ? root.width - grip : grip
+            y: modelData.y === 0 ? 0 : modelData.y === 2 ? root.height - grip : grip
+            width: modelData.x === 1 ? root.width - 2 * grip : grip
+            height: modelData.y === 1 ? root.height - 2 * grip : grip
+
+            HoverHandler { cursorShape: modelData.cursor }
+            DragHandler {
+                target: null
+                grabPermissions: PointerHandler.CanTakeOverFromAnything
+                onActiveChanged: if (active) root.Window.window.startSystemResize(modelData.edges)
+            }
+        }
+    }
+}
