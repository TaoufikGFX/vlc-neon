+    Widgets.PointingToolTipAttached.visible: !hoverHandler.hovered && (control.visualFocus || dragHandler.active)
 
     Widgets.PointingToolTipAttached.text: {
         if (!Widgets.PointingToolTipAttached.instance?.visible)
@@ -97,6 +98,65 @@ T.ProgressBar {
     Widgets.PointingToolTipAttached.pos: Qt.point(hoverHandler.hovered ? Helpers.clamp(hoverHandler.point.position.x, 0, control.availableWidth)
                                                                        : (control.visualPosition * control.width), 0)
 
+    Rectangle {
+        id: preview
+        objectName: "rebornSeekPreview"
+        readonly property real fullHeight: Player.hasVideoOutput || Reborn.thumbnail.length > 0 ? VLCStyle.dp(145, VLCStyle.scale) : VLCStyle.dp(32, VLCStyle.scale)
+        readonly property real minHeight: VLCStyle.dp(32, VLCStyle.scale)
+        readonly property real gap: VLCStyle.dp(8, VLCStyle.scale)
+        readonly property real edgeMargin: 4
+
+        // Placed imperatively, from live scene coordinates, each time it is shown / the pointer moves / the window changes.
+        // (A binding on mapToItem() only re-evaluates when the bar's own x/y/width/height change, not when an ancestor moves, e.g. the
+        // bottom-anchored control bar after a window resize, which left the preview at a stale position.)
+        // The preview sits entirely above the bar: its bottom edge is `gap` above the top of the (hover-enlarged) track, inside the visible
+        // window (the shadow margin excluded). When there is not enough room it shrinks instead of overlapping the controls.
+        function place() {
+            const root = control.Window.window ? control.Window.window.contentItem : null
+            if (!root || !visible)
+                return
+            const margin = MainCtx.windowExtendedMargin + edgeMargin
+            const origin = control.mapToItem(root, 0, 0)
+            const trackTop = (control.height - control.barHeight) / 2 + control._scaledY
+            const bottom = origin.y + trackTop - gap
+            width = Math.min(VLCStyle.dp(208, VLCStyle.scale), Math.max(0, root.width - 2 * margin))
+            height = Math.max(minHeight, Math.min(fullHeight, bottom - margin))
+            const pointerX = origin.x + hoverHandler.point.position.x
+            const sceneX = Helpers.clamp(pointerX - width / 2, margin, Math.max(margin, root.width - margin - width))
+            x = sceneX - origin.x
+            y = bottom - height - origin.y
+        }
+        visible: hoverHandler.hovered && Player.seekable
+        z: 100
+        onVisibleChanged: place()
+        onFullHeightChanged: place()
+        Connections { target: hoverHandler; function onHoverXChanged() { preview.place() } }
+        Connections {
+            target: control.Window.window
+            function onWidthChanged() { preview.place() }
+            function onHeightChanged() { preview.place() }
+        }
+        radius: VLCStyle.dp(5, VLCStyle.scale)
+        color: "#ee202020"
+        border.color: "#707070"
+        Image {
+            asynchronous: true
+            objectName: "rebornThumbnailImage"
+            anchors { top: parent.top; left: parent.left; right: parent.right; margins: 4 }
+            height: parent.height - VLCStyle.dp(32, VLCStyle.scale)
+            source: Reborn.thumbnail
+            fillMode: Image.PreserveAspectFit
+            cache: false
+            visible: height > 0
+        }
+        Text {
+            anchors { bottom: parent.bottom; horizontalCenter: parent.horizontalCenter; bottomMargin: 7 }
+            color: "white"
+            text: Player.length.scale(Helpers.clamp(hoverHandler.point.position.x / Math.max(1, control.availableWidth), 0, 1)).formatHMS(Player.length.isSubSecond() ? VLCTick.SubSecondFormattedAsMS : 0)
+                  + (Reborn.thumbnail.length > 0 && Reborn.thumbnailApproximate ? "  ≈ " + Reborn.thumbnailFrameTime : "")
+        }
+    }
+
