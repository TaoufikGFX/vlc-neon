diff --git a/modules/gui/qt/player/qml/PresetListMenu.qml b/modules/gui/qt/player/qml/PresetListMenu.qml
new file mode 100644
index 0000000000000000000000000000000000000000..cdec657a6142ce048f29cd5e50754e30d8215fb7
--- /dev/null
+++ b/modules/gui/qt/player/qml/PresetListMenu.qml
@@ -0,0 +1,149 @@
+/*****************************************************************************
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ * Shared popup list (Neon): small caption header, one plain row per preset with the current one highlighted and checked,
+ * optional tip footer. Used by the Playback Speed and Volume Boost popups so they cannot drift apart.
+ *****************************************************************************/
+
+import QtQuick
+import QtQuick.Controls
+import QtQuick.Templates as T
+import QtQuick.Layouts
+
+import VLC.MainInterface
+import VLC.Player
+import VLC.Style
+import VLC.Widgets as Widgets
+import VLC.Util
+
+ColumnLayout {
+    id: root
+
+    signal itemClicked()
+    // Emitted with the preset the user picked (click, Enter, Space); the owner applies it.
+    signal valueSelected(real value)
+
+    property string title
+    property string tip
+    property var values: []
+    // The value currently in effect; a preset within `epsilon` of it is shown as selected.
+    property real currentValue
+    property real epsilon: 0.01
+    // Row index to focus when no preset matches currentValue
+    property int defaultIndex: 0
+    // function(value) -> row text
+    property var labelProvider: function(value) { return String(value) }
+
+    readonly property real rowHeight: VLCStyle.dp(34, VLCStyle.scale)
+
+    spacing: 0
+
+    readonly property ColorContext colorContext: ColorContext {
+        id: theme
+        colorSet: ColorContext.Window
+    }
+
+    Widgets.CaptionLabel {
+        Layout.fillWidth: true
+        Layout.leftMargin: VLCStyle.margin_normal
+        Layout.topMargin: VLCStyle.margin_xsmall
+        Layout.bottomMargin: VLCStyle.margin_xsmall
+
+        text: root.title
+        color: theme.fg.secondary
+        font.pixelSize: VLCStyle.fontSize_small
+        font.weight: Font.DemiBold
+        font.letterSpacing: 1
+    }
+
+    ListView {
+        id: list
+
+        Layout.fillWidth: true
+        Layout.preferredHeight: contentHeight
+
+        interactive: false
+        model: root.values
+        focus: true
+        keyNavigationEnabled: true
+        keyNavigationWraps: false
+
+        Navigation.parentItem: root
+        Navigation.rightItem: root.Navigation.parentItem
+
+        Component.onCompleted: {
+            for (let i = 0; i < root.values.length; ++i)
+                if (Math.abs(root.currentValue - root.values[i]) < root.epsilon) { currentIndex = i; return }
+            currentIndex = root.defaultIndex
+        }
+
+        Keys.onReturnPressed: list.currentItem && list.currentItem.activate()
+        Keys.onEnterPressed: list.currentItem && list.currentItem.activate()
+        Keys.onSpacePressed: list.currentItem && list.currentItem.activate()
+
+        delegate: T.ItemDelegate {
+            id: row
+
+            required property int index
+            required property real modelData
+
+            readonly property bool current: Math.abs(root.currentValue - modelData) < root.epsilon
+
+            function activate() {
+                root.valueSelected(modelData)
+                root.itemClicked()
+            }
+
+            width: ListView.view.width
+            height: root.rowHeight
+            hoverEnabled: true
+
+            onClicked: activate()
+
+            background: Rectangle {
+                anchors.fill: parent
+                anchors.leftMargin: VLCStyle.margin_xsmall
+                anchors.rightMargin: VLCStyle.margin_xsmall
+                radius: VLCStyle.dp(8, VLCStyle.scale)
+                color: row.current ? Qt.alpha(theme.accent, 0.28)
+                                   : (row.hovered || (list.activeFocus && list.currentIndex === row.index))
+                                     ? Qt.alpha(theme.fg.primary, 0.08) : "transparent"
+            }
+
+            contentItem: RowLayout {
+                spacing: VLCStyle.margin_small
+
+                Text {
+                    Layout.fillWidth: true
+                    Layout.leftMargin: VLCStyle.margin_normal
+
+                    text: root.labelProvider(row.modelData)
+                    color: theme.fg.primary
+                    font.pixelSize: VLCStyle.fontSize_normal
+                    font.weight: row.current ? Font.DemiBold : Font.Normal
+                    verticalAlignment: Text.AlignVCenter
+                }
+
+                Text {
+                    Layout.rightMargin: VLCStyle.margin_normal
+                    visible: row.current
+                    text: "✓"
+                    color: theme.accent
+                    font.pixelSize: VLCStyle.fontSize_normal
+                    font.weight: Font.Bold
+                }
+            }
+        }
+    }
+
+    Widgets.CaptionLabel {
+        Layout.fillWidth: true
+        Layout.leftMargin: VLCStyle.margin_normal
+        Layout.topMargin: VLCStyle.margin_xsmall
+        Layout.bottomMargin: VLCStyle.margin_xsmall
+
+        visible: root.tip !== ""
+        text: root.tip
+        color: theme.fg.secondary
+        font.pixelSize: VLCStyle.fontSize_small
+    }
+}
