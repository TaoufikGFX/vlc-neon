--- a/src/input/es_out.c
+++ b/src/input/es_out.c
@@ -179,6 +179,7 @@ typedef struct
 {
     input_thread_t *p_input;
     enum input_type input_type;
+    atomic_int_fast64_t thumbnail_origin;
 
     input_source_t *main_source;
 
@@ -456,6 +457,15 @@ decoder_on_thumbnail_ready(vlc_input_decoder_t *decoder, picture_t *pic, void *u
     if (!p_sys->p_input)
         return;
 
+    /* Only Neon's independent preview input opts in. Preserve playback timestamps.
+     * A decoded PTS is stream-relative: use VLC's demux-origin normalization,
+     * including non-zero MPEG-TS origins, instead of estimating frame/FPS. */
+    if (var_InheritBool(p_sys->p_input, "neon-preview-media-pts")) {
+        vlc_tick_t origin = atomic_load_explicit(&p_sys->thumbnail_origin, memory_order_relaxed);
+        if (pic->date != VLC_TICK_INVALID)
+            pic->date = pic->date - origin + VLC_TICK_0;
+    }
+
     struct vlc_input_event event = {
         .type = INPUT_EVENT_THUMBNAIL_READY,
         .thumbnail = pic,
@@ -4222,8 +4232,11 @@ static int EsOutVaPrivControlLocked(es_out_sys_t *p_sys, input_source_t *source,
         vlc_tick_t i_length = va_arg( args, vlc_tick_t );
         bool b_live = va_arg( args, int );
 
-        if (i_normal_time != VLC_TICK_INVALID)
+        if (i_normal_time != VLC_TICK_INVALID) {
             source->i_normal_time = i_normal_time;
+            if (p_sys->input_type == INPUT_TYPE_THUMBNAILING && source == p_sys->main_source)
+                atomic_store_explicit(&p_sys->thumbnail_origin, i_normal_time, memory_order_relaxed);
+        }
 
         if( source != p_sys->main_source )
             return VLC_SUCCESS;
@@ -4382,6 +4395,7 @@ input_EsOutNew(input_thread_t *p_input, input_source_t *main_source, float rate,
     p_sys->p_next_frame_es = NULL;
     p_sys->i_mode   = ES_OUT_MODE_NONE;
     p_sys->input_type = input_type;
+    atomic_init(&p_sys->thumbnail_origin, VLC_TICK_0);
 
     p_sys->p_pgrm = NULL;
     vlc_list_init(&p_sys->programs);
diff --git a/src/input/input.c b/src/input/input.c
index 082389218df2c6d8b98258586142ba89bad73ca8..4ec7700c552624b73aaa02c5c90e5321da17bc45 100644
--- a/src/input/input.c
+++ b/src/input/input.c
@@ -247,6 +247,12 @@ input_thread_t * input_Create( vlc_object_t *p_parent, input_item_t *p_item,
 
     /* Parse input options */
     input_item_ApplyOptions( VLC_OBJECT(p_input), p_item );
+    if (cfg->type == INPUT_TYPE_THUMBNAILING) {
+        // A still frame needs bounded decode buffering, not playback throughput.
+        // Keep thumbnail workers from competing with the active video decoder.
+        var_Create(p_input, "avcodec-threads", VLC_VAR_INTEGER);
+        var_SetInteger(p_input, "avcodec-threads", 2);
+    }
 
     /* Init Common fields */
 
@@ -305,7 +311,8 @@ input_thread_t * input_Create( vlc_object_t *p_parent, input_item_t *p_item,
 
     if( priv->type != INPUT_TYPE_PLAYBACK )
     {
-        p_input->obj.logger = NULL;
+        if (!(priv->type == INPUT_TYPE_THUMBNAILING && getenv("VLC_NEON_PREVIEW_TRACE") != NULL))
+            p_input->obj.logger = NULL;
         p_input->obj.no_interact = true;
     }
 
@@ -413,8 +420,22 @@ static void *Run( void *data )
 
     vlc_interrupt_set(&priv->interrupt);
 
+    const bool preview_trace = priv->type == INPUT_TYPE_THUMBNAILING && getenv("VLC_NEON_PREVIEW_TRACE") != NULL;
+    const vlc_tick_t open_started = preview_trace ? vlc_tick_now() : 0;
     if( !Init( p_input ) )
     {
+        const vlc_tick_t open_finished = preview_trace ? vlc_tick_now() : 0;
+        /* A one-shot preview must seek before its first demuxed picture can
+         * win the thumbnail race. Normal playback keeps its original loop. */
+        if (priv->type == INPUT_TYPE_THUMBNAILING && var_InheritBool(p_input, "neon-preview-media-pts")) {
+            int type;
+            input_control_param_t param;
+            while (ControlPop(p_input, &type, &param, vlc_tick_now(), false) == VLC_SUCCESS)
+                Control(p_input, type, param);
+        }
+        if (preview_trace)
+            msg_Dbg(p_input, "NEON_PREVIEW_INPUT open_ms=%.3f seek_control_ms=%.3f",
+                    (open_finished-open_started)/1000., (vlc_tick_now()-open_finished)/1000.);
         MainLoop( p_input, true ); /* FIXME it can be wrong (like with VLM) */
 
         /* Clean up */
