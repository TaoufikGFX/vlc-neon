@@ -1621,8 +1633,21 @@ static void ModuleThread_QueueThumbnail( decoder_t *p_dec, picture_t *p_pic )
     vlc_input_decoder_t *p_owner = dec_get_owner( p_dec );
 
     vlc_fifo_Lock(p_owner->p_fifo);
-    if( p_owner->b_first )
+    ++p_owner->thumbnail_frames;
+    /* The thumbnail path bypasses ModuleThread_PlayVideo's preroll filter.
+     * Honor decoder preroll for precise seeks; fast seeks keep the first frame. */
+    if (p_owner->b_first && p_owner->i_preroll_end != PREROLL_NONE
+        && p_pic->date != VLC_TICK_INVALID && p_pic->date < p_owner->i_preroll_end) {
+        vlc_fifo_Unlock(p_owner->p_fifo);
+        picture_Release(p_pic);
+        return;
+    }
+    if( p_owner->b_first ) {
+        if (getenv("VLC_NEON_PREVIEW_TRACE") != NULL)
+            msg_Dbg(p_dec, "NEON_PREVIEW_FRAME delivered_frames=%u pts_us=%"PRId64,
+                    p_owner->thumbnail_frames, p_pic->date);
         decoder_Notify(p_owner, on_thumbnail_ready, p_pic);
+    }
     p_owner->b_first = false;
     vlc_fifo_Unlock(p_owner->p_fifo);
 
