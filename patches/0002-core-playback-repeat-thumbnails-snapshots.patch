diff --git a/src/preparser/internal.c b/src/preparser/internal.c
index 6b1e160058ee9f96a080f823238669c2b93975bc..ddaee1d23c4ea05e9dc54d42e0a3ddaa5ea54875 100644
--- a/src/preparser/internal.c
+++ b/src/preparser/internal.c
@@ -23,6 +23,9 @@
 #endif
 
 #include <fcntl.h>
+#ifdef __linux__
+# include <sys/resource.h>
+#endif
 
 #include <vlc_common.h>
 #include <vlc_atomic.h>
@@ -510,6 +513,15 @@ ThumbnailerRun(void *userdata)
     struct vlc_preparser_req *req = userdata;
     struct vlc_preparser_req_owner *req_owner = preparser_req_get_owner(req);
     struct preparser_sys *preparser = req_owner->preparser;
+#ifdef __linux__
+    // Linux niceness is per-thread; child input/decoder threads inherit it.
+    // Only this independent Neon thumbnail executor is affected.
+    if (var_Type(preparser->owner, "neon-preview-media-pts") != 0
+        && var_GetBool(preparser->owner, "neon-preview-media-pts"))
+        (void) setpriority(PRIO_PROCESS, 0, 10);
+#endif
+    const bool trace = getenv("VLC_NEON_PREVIEW_TRACE") != NULL;
+    const vlc_tick_t run_started = trace ? vlc_tick_now() : 0;
 
     static const struct vlc_input_thread_callbacks cbs = {
         .on_event = on_thumbnailer_input_event,
@@ -570,9 +582,13 @@ ThumbnailerRun(void *userdata)
     else
         timeout = vlc_sem_timedwait(&req_owner->preparse_ended, deadline) != 0;
 
+    const vlc_tick_t picture_ready = trace ? vlc_tick_now() : 0;
     /* tear the input thread down before reading what it produced to avoid races */
     input_Stop(input);
     input_Close(input);
+    if (trace)
+        msg_Dbg(preparser->owner, "NEON_PREVIEW_BACKEND open_seek_decode_ms=%.3f stop_close_ms=%.3f",
+                (picture_ready-run_started)/1000., (vlc_tick_now()-picture_ready)/1000.);
 
     if (timeout)
         req_owner->preparse_status = VLC_ETIMEOUT;
diff --git a/src/video_output/video_output.c b/src/video_output/video_output.c
index bde65e65ecdc6319bbc7a4a726bda43d60b3e791..2674bc969784d8e6edafde1114b1e508c04879ae 100644
--- a/src/video_output/video_output.c
+++ b/src/video_output/video_output.c
@@ -1165,13 +1165,11 @@ static picture_t *ConvertRGBAAndBlend(vout_thread_sys_t *vout, picture_t *pic,
                                       vlc_render_subpicture *subpic)
 {
     vout_thread_sys_t *sys = vout;
-    /* This function will convert the pic to RGBA and blend the subpic to it.
+    /* This function converts the pic to RGBA and optionally blends a subpic.
      * The returned pic can't be used to display since the chroma will be
      * different than the "vout display" one, but it can be used for snapshots.
      * */
 
-    assert(sys->spu_blend);
-
     filter_owner_t owner = {
         .video = &vout_video_cbs,
         .sys = vout,
@@ -1180,13 +1178,13 @@ static picture_t *ConvertRGBAAndBlend(vout_thread_sys_t *vout, picture_t *pic,
     if (!filterc)
         return NULL;
 
-    es_format_t src = sys->spu_blend->fmt_out;
+    es_format_t src;
+    es_format_Init(&src, VIDEO_ES, pic->format.i_chroma);
+    src.video = pic->format;
     es_format_t dst = src;
-    dst.video.i_chroma = VLC_CODEC_RGBA;
+    dst.i_codec = dst.video.i_chroma = VLC_CODEC_RGBA;
 
-    filter_chain_Reset(filterc, &src,
-                       NULL /* TODO output video context of blender */,
-                       &dst);
+    filter_chain_Reset(filterc, &src, picture_GetVideoContext(pic), &dst);
 
     if (filter_chain_AppendConverter(filterc, &dst) != VLC_SUCCESS)
     {
@@ -1198,6 +1196,8 @@ static picture_t *ConvertRGBAAndBlend(vout_thread_sys_t *vout, picture_t *pic,
     pic = filter_chain_VideoFilter(filterc, pic);
     filter_chain_Delete(filterc);
 
+    if (pic && !subpic)
+        return pic;
     if (pic)
     {
         vlc_blender_t *swblend = filter_NewBlend(VLC_OBJECT(&vout->obj), &dst.video);
@@ -1286,7 +1286,15 @@ static int PrerenderPicture(vout_thread_sys_t *sys, picture_t *filtered,
     //the source format.
     // In early SPU blending the blending is done into the source chroma,
     // otherwise it's done in the display chroma
-    const bool blending_before_converter = vd->source->orientation == ORIENT_NORMAL;
+    const vlc_chroma_description_t *source_chroma =
+        vlc_fourcc_GetChromaDescription(vd->source->i_chroma);
+    const vlc_chroma_description_t *display_chroma =
+        vlc_fourcc_GetChromaDescription(vd->fmt->i_chroma);
+    // SHM software output must blend after the hardware-to-CPU converter.
+    const bool hardware_to_software = source_chroma && !source_chroma->plane_count
+        && display_chroma && display_chroma->plane_count;
+    const bool blending_before_converter = vd->source->orientation == ORIENT_NORMAL
+        && !hardware_to_software;
 
     const vout_display_place_t *video_place = NULL; // default to fit the video
     video_format_t fmt_spu;
@@ -1371,6 +1379,17 @@ static int PrerenderPicture(vout_thread_sys_t *sys, picture_t *filtered,
     if (do_snapshot)
     {
         assert(snap_pic);
+        const vlc_chroma_description_t *snap_chroma =
+            vlc_fourcc_GetChromaDescription(snap_pic->format.i_chroma);
+        if (snap_chroma && !snap_chroma->plane_count) {
+            // Export needs CPU pixels; retain the hardware context for copy-back.
+            // This conversion runs only for an explicitly requested screenshot.
+            picture_t *copy = ConvertRGBAAndBlend(sys, snap_pic, NULL);
+            if (copy) {
+                if (snap_pic != todisplay) picture_Release(snap_pic);
+                snap_pic = copy;
+            }
+        }
         vout_snapshot_Set(sys->snapshot, vd->source, snap_pic);
         if (snap_pic != todisplay)
             picture_Release(snap_pic);
