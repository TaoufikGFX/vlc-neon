# Build environment for the VLC Neon AppImage.
# Ubuntu 24.04 base (glibc 2.39) so the AppImage runs on most current distributions,
# with the official Qt 6.11 LTS-track binaries and a newer wayland-scanner, both needed by VLC 4.
FROM docker.io/library/ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential git ca-certificates curl file ninja-build pkg-config flex bison gettext \
      python3 python3-pip python3-venv patchelf desktop-file-utils squashfs-tools xz-utils \
      libwayland-dev wayland-protocols libxkbcommon-dev libxkbcommon-x11-0 libegl-dev libgl-dev \
      libva-dev libvdpau-dev libexpat1-dev libxml2-dev libffi-dev \
      libxcb-cursor0 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 libxcb-randr0 libxcb-render-util0 \
      libxcb-shape0 libxcb-xinerama0 libxcb-xkb1 libxcb-xfixes0 libfontconfig1 libdbus-1-3 \
      libavcodec-dev libavformat-dev libavutil-dev libswscale-dev libswresample-dev \
      libass-dev libebml-dev libmatroska-dev libmad0-dev libdvbpsi-dev libdvdread-dev libdvdnav-dev \
      libgcrypt20-dev libgpg-error-dev liblua5.4-dev lua5.4 libarchive-dev libpng-dev libjpeg-dev \
      libpipewire-0.3-dev libpulse-dev libasound2-dev libx11-dev libx11-xcb-dev libxcb1-dev libxcb-keysyms1-dev libxcb-composite0-dev libxcb-damage0-dev libxcb-xfixes0-dev libxcb-render0-dev libxcb-shm0-dev libxcb-randr0-dev libxcb-xkb-dev libxkbcommon-x11-dev \
      libdbus-1-dev libfreetype-dev libfribidi-dev libharfbuzz-dev libfontconfig-dev \
      libflac-dev libogg-dev libvorbis-dev libopus-dev libspeex-dev libtheora-dev libsamplerate0-dev \
      zlib1g-dev libvpx-dev libdav1d-dev libnotify-dev libsecret-1-dev libgnutls28-dev libtag1-dev \
    && rm -rf /var/lib/apt/lists/*
# Build tools: meson >= 1.10 and the Qt installer
RUN python3 -m venv /opt/tools && /opt/tools/bin/pip install --no-cache-dir meson==1.11.2 aqtinstall==3.3.0 \
    && ln -s /opt/tools/bin/meson /usr/local/bin/meson
# wayland-scanner >= 1.23 (scanner only; the system libwayland is kept)
RUN curl -fsSL https://gitlab.freedesktop.org/wayland/wayland/-/releases/1.24.0/downloads/wayland-1.24.0.tar.xz | tar -xJ -C /tmp \
    && meson setup /tmp/wl /tmp/wayland-1.24.0 --prefix=/usr/local -Dlibraries=false -Ddocumentation=false -Dtests=false \
    && meson install -C /tmp/wl && rm -rf /tmp/wl /tmp/wayland-1.24.0
# Qt 6.11.2 (same version as the Fedora 44 build)
RUN /opt/tools/bin/aqt install-qt linux desktop 6.11.2 linux_gcc_64 -m qtshadertools qtimageformats -O /opt/qt
ENV QTDIR=/opt/qt/6.11.2/gcc_64
ENV PATH=/opt/qt/6.11.2/gcc_64/bin:/opt/qt/6.11.2/gcc_64/libexec:$PATH \
    PKG_CONFIG_PATH=/usr/local/lib/x86_64-linux-gnu/pkgconfig:/usr/local/share/pkgconfig:/opt/qt/6.11.2/gcc_64/lib/pkgconfig \
    LD_LIBRARY_PATH=/opt/qt/6.11.2/gcc_64/lib \
    CMAKE_PREFIX_PATH=/opt/qt/6.11.2/gcc_64
